{
  "id": "reaction_test",
  "name": "Реакция",
  "icon": "⚡",
  "color": "from-red-500 to-yellow-500",
  "version": "1.0.0",
  "author": "ePhone Simulator",
  "description": "Проверь свою скорость реакции!",
  "code": "<div class=\"reaction-container\">\n  <h1>⚡ Тест Реакции</h1>\n  <div class=\"result\" id=\"result\">Нажми чтобы начать</div>\n  <div class=\"tap-area\" id=\"tapArea\">\n    <div class=\"tap-text\" id=\"tapText\">Жди зелёный...</div>\n  </div>\n  <div class=\"stats\">\n    <div class=\"stat\">Лучшее: <span id=\"best\">-</span> мс</div>\n    <div class=\"stat\">Попыток: <span id=\"attempts\">0</span></div>\n  </div>\n</div>\n\n<style>\n.reaction-container {\n  padding: 20px;\n  text-align: center;\n  color: white;\n}\n.reaction-container h1 {\n  font-size: 24px;\n  margin-bottom: 15px;\n}\n.result {\n  font-size: 20px;\n  margin-bottom: 15px;\n  color: #00ff88;\n  font-weight: bold;\n  min-height: 30px;\n}\n.tap-area {\n  width: 100%;\n  height: 250px;\n  background: #ff3b30;\n  border-radius: 16px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: background 0.2s;\n  margin-bottom: 20px;\n}\n.tap-area.waiting {\n  background: #ff3b30;\n}\n.tap-area.ready {\n  background: #34c759;\n}\n.tap-area.too-early {\n  background: #ff9500;\n}\n.tap-text {\n  font-size: 18px;\n  font-weight: bold;\n  color: white;\n  text-align: center;\n  padding: 20px;\n}\n.stats {\n  display: flex;\n  justify-content: space-around;\n}\n.stat {\n  font-size: 14px;\n  color: rgba(255,255,255,0.7);\n}\n.stat span {\n  color: #ffd700;\n  font-weight: bold;\n}\n</style>\n\n<script>\nlet state = 'idle'; // idle, waiting, ready\nlet startTime = 0;\nlet timeout = null;\nlet bestTime = null;\nlet attempts = 0;\n\nconst tapArea = document.getElementById('tapArea');\nconst tapText = document.getElementById('tapText');\nconst result = document.getElementById('result');\nconst bestEl = document.getElementById('best');\nconst attemptsEl = document.getElementById('attempts');\n\ntapArea.addEventListener('click', handleTap);\n\nfunction handleTap() {\n  if (state === 'idle') {\n    startWaiting();\n  } else if (state === 'waiting') {\n    tooEarly();\n  } else if (state === 'ready') {\n    measureReaction();\n  }\n}\n\nfunction startWaiting() {\n  state = 'waiting';\n  tapArea.className = 'tap-area waiting';\n  tapText.textContent = 'Жди зелёный...';\n  result.textContent = '';\n  \n  const delay = 1500 + Math.random() * 3000;\n  timeout = setTimeout(() => {\n    state = 'ready';\n    tapArea.className = 'tap-area ready';\n    tapText.textContent = 'ЖМЫШК!';\n    startTime = Date.now();\n  }, delay);\n}\n\nfunction tooEarly() {\n  clearTimeout(timeout);\n  state = 'idle';\n  tapArea.className = 'tap-area too-early';\n  tapText.textContent = 'Слишком рано! Нажми снова';\n  result.textContent = '❌ Фальстарт';\n}\n\nfunction measureReaction() {\n  const reactionTime = Date.now() - startTime;\n  attempts++;\n  attemptsEl.textContent = attempts;\n  \n  if (!bestTime || reactionTime < bestTime) {\n    bestTime = reactionTime;\n    bestEl.textContent = bestTime;\n  }\n  \n  let message = '';\n  if (reactionTime < 200) message = '🏆 Невероятно!';\n  else if (reactionTime < 300) message = '⚡ Отлично!';\n  else if (reactionTime < 400) message = '👍 Хорошо!';\n  else message = '🐢 Можно лучше';\n  \n  result.textContent = `${reactionTime} мс - ${message}`;\n  \n  state = 'idle';\n  tapArea.className = 'tap-area';\n  tapArea.style.background = '#007aff';\n  tapText.textContent = 'Нажми для новой попытки';\n}\n</script>",
  "supportedModels": [
    "iphone8",
    "iphonex",
    "iphone14",
    "epad101"
  ]
}