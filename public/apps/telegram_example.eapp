{
  "id": "telegram_example",
  "name": "Telegram",
  "icon": "material:send",
  "color": "from-blue-400 to-blue-600",
  "version": "1.0.0",
  "author": "Example",
  "description": "Пример приложения с внешними библиотеками",
  "supportedModels": [
    "iphone8",
    "iphonex",
    "iphone14",
    "epad101"
  ],
  "isSystem": false,
  "changelog": "v1.0 - Пример с внешними CDN",
  "code": "<!--\n⚠️ ПРИМЕР ПРИЛОЖЕНИЯ С ВНЕШНИМИ БИБЛИОТЕКАМИ:\n- Использует Font Awesome для иконок\n- Использует Animate.css для анимаций\n- Можно подключать любые CDN библиотеки\n-->\n<div class=\"telegram-app\">\n  <div class=\"header\">\n    <div class=\"menu-btn\"><span class=\"material-icons\">menu</span></div>\n    <div class=\"search-bar\">\n      <span class=\"material-icons\">search</span>\n      <input type=\"text\" placeholder=\"Поиск\">\n    </div>\n  </div>\n  <div class=\"chat-list\" id=\"chatList\"></div>\n</div>\n\n<!-- Подключаем внешние библиотеки -->\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css\">\n\n<style>\n.telegram-app {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  background: #17212b;\n  color: white;\n}\n\n.header {\n  display: flex;\n  align-items: center;\n  padding: 10px;\n  background: #242f3d;\n  gap: 10px;\n}\n\n.menu-btn {\n  width: 40px;\n  height: 40px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  border-radius: 50%;\n  transition: background 0.2s;\n}\n\n.menu-btn:hover {\n  background: rgba(255,255,255,0.1);\n}\n\n.search-bar {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  background: #242f3d;\n  border: 1px solid #3a4a5c;\n  border-radius: 20px;\n  padding: 8px 15px;\n  gap: 10px;\n}\n\n.search-bar input {\n  flex: 1;\n  background: none;\n  border: none;\n  color: white;\n  outline: none;\n  font-size: 14px;\n}\n\n.search-bar input::placeholder {\n  color: #6c7883;\n}\n\n.chat-list {\n  flex: 1;\n  overflow-y: auto;\n}\n\n.chat-item {\n  display: flex;\n  align-items: center;\n  padding: 12px 15px;\n  gap: 12px;\n  cursor: pointer;\n  transition: background 0.2s;\n  border-bottom: 1px solid #1e2c3a;\n}\n\n.chat-item:hover {\n  background: #202b36;\n}\n\n.chat-item:active {\n  background: #2a3a4a;\n}\n\n.avatar {\n  width: 54px;\n  height: 54px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 24px;\n  font-weight: bold;\n  flex-shrink: 0;\n}\n\n.chat-info {\n  flex: 1;\n  min-width: 0;\n}\n\n.chat-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 4px;\n}\n\n.chat-name {\n  font-size: 16px;\n  font-weight: 500;\n  display: flex;\n  align-items: center;\n  gap: 5px;\n}\n\n.verified {\n  color: #4fc3f7;\n  font-size: 14px;\n}\n\n.chat-time {\n  font-size: 12px;\n  color: #6c7883;\n}\n\n.chat-preview {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.message-preview {\n  font-size: 14px;\n  color: #6c7883;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  flex: 1;\n}\n\n.unread-badge {\n  background: #4fc3f7;\n  color: #17212b;\n  border-radius: 12px;\n  padding: 2px 8px;\n  font-size: 12px;\n  font-weight: bold;\n  margin-left: 10px;\n}\n\n/* Анимации из Animate.css */\n.animate__animated {\n  animation-duration: 0.3s;\n}\n\n/* Font Awesome иконки */\n.fa-pin {\n  color: #4fc3f7;\n  font-size: 12px;\n}\n</style>\n\n<script>\n// Пример данных чатов\nvar chats = [\n  {\n    name: 'Telegram',\n    avatar: '✈️',\n    color: '#4fc3f7',\n    verified: true,\n    lastMessage: 'Добро пожаловать в Telegram!',\n    time: '12:30',\n    unread: 1,\n    pinned: true\n  },\n  {\n    name: 'Saved Messages',\n    avatar: '🔖',\n    color: '#7b68ee',\n    lastMessage: 'Заметка: купить молоко',\n    time: '11:45',\n    unread: 0\n  },\n  {\n    name: 'Друзья',\n    avatar: '👥',\n    color: '#ff6b6b',\n    lastMessage: 'Андрей: Го в кино вечером?',\n    time: '10:20',\n    unread: 3\n  },\n  {\n    name: 'Новости Tech',\n    avatar: '📰',\n    color: '#ffa500',\n    verified: true,\n    lastMessage: 'Apple представила новый iPhone...',\n    time: 'Вчера',\n    unread: 15\n  },\n  {\n    name: 'Работа',\n    avatar: '💼',\n    color: '#4caf50',\n    lastMessage: 'Босс: Завтра встреча в 10:00',\n    time: 'Вчера',\n    unread: 0\n  },\n  {\n    name: 'Семья',\n    avatar: '👨‍👩‍👧‍👦',\n    color: '#e91e63',\n    lastMessage: 'Мама: Позвони когда сможешь',\n    time: 'Пн',\n    unread: 2\n  },\n  {\n    name: 'Крипто Новости',\n    avatar: '₿',\n    color: '#f7931a',\n    lastMessage: 'Bitcoin достиг нового максимума...',\n    time: 'Пн',\n    unread: 42\n  },\n  {\n    name: 'Music Channel',\n    avatar: '🎵',\n    color: '#9c27b0',\n    lastMessage: 'Новый альбом любимой группы!',\n    time: 'Вс',\n    unread: 0\n  }\n];\n\n// Рендер списка чатов\nfunction renderChats() {\n  var chatList = document.getElementById('chatList');\n  chatList.innerHTML = chats.map(function(chat, index) {\n    var verifiedBadge = chat.verified ? '<i class=\"fas fa-check-circle verified\"></i>' : '';\n    var unreadBadge = chat.unread > 0 ? '<div class=\"unread-badge\">' + chat.unread + '</div>' : '';\n    var pinIcon = chat.pinned ? '<i class=\"fas fa-pin\"></i>' : '';\n    \n    return '<div class=\"chat-item animate__animated animate__fadeIn\" style=\"animation-delay: ' + (index * 0.05) + 's\" onclick=\"openChat(&apos;' + chat.name + '&apos;)\">' +\n      '<div class=\"avatar\" style=\"background: ' + chat.color + '\">' + chat.avatar + '</div>' +\n      '<div class=\"chat-info\">' +\n        '<div class=\"chat-header\">' +\n          '<div class=\"chat-name\">' + chat.name + ' ' + verifiedBadge + '</div>' +\n          '<div class=\"chat-time\">' + chat.time + '</div>' +\n        '</div>' +\n        '<div class=\"chat-preview\">' +\n          '<div class=\"message-preview\">' + pinIcon + ' ' + chat.lastMessage + '</div>' +\n          unreadBadge +\n        '</div>' +\n      '</div>' +\n    '</div>';\n  }).join('');\n}\n\nfunction openChat(name) {\n  ePhone.vibrate(10);\n  // Здесь можно открыть чат\n  console.log('Открыт чат:', name);\n}\n\n// Инициализация\nrenderChats();\n</script>"
}