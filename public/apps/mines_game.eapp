{
  "id": "mines_game",
  "name": "Сапёр",
  "icon": "material:mine",
  "color": "from-slate-500 to-slate-700",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Классический сапёр: открой все клетки и не наступи на мину.",
  "supportedModels": [
    "iphone8",
    "iphonex",
    "iphone14",
    "epad101"
  ],
  "isSystem": true,
  "changelog": "Первая версия",
  "code": "<div class=\"wrap\"><div class=\"hud\"><span>💣 <b id=\"ml\">15</b></span><select id=\"df\" onchange=\"init()\" style=\"background:#2c2c3a;color:#fff;border:none;border-radius:10px;padding:4px 10px\"><option value=\"8\">8×8</option><option value=\"10\" selected>10×10</option><option value=\"12\">12×12</option></select><span>🚩 <b id=\"fl\">0</b></span></div><div class=\"grid\" id=\"gr\"></div><div class=\"msg\" id=\"msg\"></div><div class=\"tip\">Долгое нажатие / правый клик — флаг 🚩</div></div><style>.wrap{min-height:100vh;background:linear-gradient(#101018,#1c1c2e);color:#fff;font-family:sans-serif;display:flex;flex-direction:column;align-items:center;padding:12px}.hud{display:flex;gap:10px;align-items:center;margin-bottom:10px;font-size:13px}.hud span{background:rgba(255,255,255,.08);padding:5px 12px;border-radius:12px}.grid{display:grid;gap:2px}.cell{width:27px;height:27px;background:linear-gradient(145deg,#3a3a55,#26263c);border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;cursor:pointer;user-select:none;transition:transform .1s}.cell:active{transform:scale(.88)}.cell.open{background:#12121c}.cell.flag{background:linear-gradient(145deg,#5c4a12,#3c3020)}.msg{margin-top:10px;font-size:15px;font-weight:700;min-height:22px}.tip{font-size:10px;opacity:.45;margin-top:6px}.c1{color:#32ade6}.c2{color:#34c759}.c3{color:#ff453a}.c4{color:#bf5af2}.c5{color:#ff9f0a}.c6{color:#64d2ff}</style><script>var N=10,M=15,brd=[],cls=[],opn=0,flg=0,dead=false,won=false,lt=null;function init(){N=+document.getElementById('df').value;M=Math.round(N*N*.15);brd=[];cls=[];opn=0;flg=0;dead=false;won=false;document.getElementById('msg').textContent='';document.getElementById('ml').textContent=M;document.getElementById('fl').textContent=0;var g=document.getElementById('gr');g.style.gridTemplateColumns='repeat('+N+',27px)';g.innerHTML='';for(var i=0;i<N*N;i++)brd.push({m:0,n:0,o:0,f:0});var pl=0;while(pl<M){var r=Math.floor(Math.random()*N*N);if(!brd[r].m){brd[r].m=1;pl++;}}for(var y=0;y<N;y++)for(var x=0;x<N;x++){var n=0;for(var dy=-1;dy<=1;dy++)for(var dx=-1;dx<=1;dx++){var nx=x+dx,ny=y+dy;if(nx>=0&&nx<N&&ny>=0&&ny<N&&brd[ny*N+nx].m)n++;}brd[y*N+x].n=n;}for(var i2=0;i2<N*N;i2++){var d=document.createElement('div');d.className='cell';d.dataset.i=i2;d.onclick=function(){tap(+this.dataset.i);};d.oncontextmenu=function(e){e.preventDefault();flag(+this.dataset.i);};d.addEventListener('touchstart',function(){var s=this;lt=setTimeout(function(){flag(+s.dataset.i);lt='d';},400);});d.addEventListener('touchend',function(){if(lt&&lt!=='d')clearTimeout(lt);lt=null;});d.addEventListener('touchmove',function(){if(lt&&lt!=='d')clearTimeout(lt);lt=null;});g.appendChild(d);cls.push(d);}}function tap(i){var c=brd[i];if(dead||won||c.o||c.f)return;if(c.m){dead=true;c.o=1;cls[i].classList.add('open');cls[i].textContent='💣';document.getElementById('msg').textContent='💥 Бум!';ePhone.vibrate([60,60,100]);revAll();return;}flood(i);}function flood(i){var st=[i];while(st.length){var j=st.pop();var c=brd[j];if(c.o||c.f||c.m)continue;c.o=1;opn++;var el=cls[j];el.classList.add('open');if(c.n>0){el.textContent=c.n;el.className='cell open c'+c.n;}else{el.textContent='';var x=j%N,y=Math.floor(j/N);for(var dy=-1;dy<=1;dy++)for(var dx=-1;dx<=1;dx++){var nx=x+dx,ny=y+dy;if(nx>=0&&nx<N&&ny>=0&&ny<N&&!brd[ny*N+nx].o)st.push(ny*N+nx);}}if(opn===N*N-M&&!won){won=true;document.getElementById('msg').textContent='🎉 Победа!';try{ePhone.notify('Минёры','Поле '+N+'×'+N+' очищено!');}catch(e){}ePhone.vibrate([15,30,15]);}}}function flag(i){if(dead||won||brd[i].o)return;brd[i].f^=1;cls[i].classList.toggle('flag',!!brd[i].f);cls[i].textContent=brd[i].f?'🚩':'';flg+=brd[i].f?1:-1;document.getElementById('fl').textContent=flg;ePhone.vibrate(8);}function revAll(){for(var i=0;i<N*N;i++)if(brd[i].m&&!brd[i].o){cls[i].classList.add('open');cls[i].textContent='💣';}}init();</script>"
}