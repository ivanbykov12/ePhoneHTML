{
  "id": "catch_star",
  "name": "Поймай Звезду",
  "icon": "⭐",
  "color": "from-yellow-400 to-orange-500",
  "version": "1.0.0",
  "author": "ePhone Simulator",
  "description": "Лови падающие звёзды!",
  "code": "<div class=\"catch-container\">\n  <h1>⭐ Поймай Звезду</h1>\n  <div class=\"score-display\">Счёт: <span id=\"score\">0</span></div>\n  <div class=\"catch-area\" id=\"catchArea\">\n    <div class=\"catcher\" id=\"catcher\">🧺</div>\n  </div>\n  <button class=\"btn\" onclick=\"startGame()\">▶ Играть</button>\n</div>\n\n<style>\n.catch-container {\n  padding: 15px;\n  text-align: center;\n  color: white;\n}\n.catch-container h1 {\n  font-size: 22px;\n  margin-bottom: 10px;\n}\n.score-display {\n  font-size: 18px;\n  margin-bottom: 15px;\n  color: #ffd700;\n  font-weight: bold;\n}\n.catch-area {\n  width: 100%;\n  height: 320px;\n  background: linear-gradient(to bottom, #1a1a2e, #16213e);\n  border-radius: 12px;\n  position: relative;\n  margin-bottom: 15px;\n  overflow: hidden;\n  border: 2px solid rgba(255,255,255,0.1);\n}\n.catcher {\n  position: absolute;\n  font-size: 36px;\n  left: 50%;\n  bottom: 10px;\n  transform: translateX(-50%);\n  transition: left 0.15s ease-out;\n}\n.star {\n  position: absolute;\n  font-size: 28px;\n  animation: fall linear forwards;\n}\n@keyframes fall {\n  from { top: -30px; }\n  to { top: 320px; }\n}\n.btn {\n  padding: 12px 32px;\n  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);\n  color: white;\n  border: none;\n  border-radius: 25px;\n  font-size: 16px;\n  cursor: pointer;\n  font-weight: bold;\n}\n.btn:active { transform: scale(0.95); }\n.game-over {\n  position: absolute;\n  inset: 0;\n  background: rgba(0,0,0,0.8);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  color: white;\n  border-radius: 12px;\n}\n</style>\n\n<script>\nlet score = 0;\nlet lives = 3;\nlet gameActive = false;\nlet catcherX = 50;\nlet spawnInterval;\nlet stars = [];\n\nconst catchArea = document.getElementById('catchArea');\nconst catcher = document.getElementById('catcher');\n\n// Управление\nfunction moveCatcher(clientX) {\n  const rect = catchArea.getBoundingClientRect();\n  const x = ((clientX - rect.left) / rect.width) * 100;\n  catcherX = Math.max(5, Math.min(95, x));\n  catcher.style.left = catcherX + '%';\n}\n\ncatchArea.addEventListener('mousemove', e => moveCatcher(e.clientX));\ncatchArea.addEventListener('touchmove', e => {\n  e.preventDefault();\n  moveCatcher(e.touches[0].clientX);\n});\n\nfunction startGame() {\n  score = 0;\n  lives = 3;\n  gameActive = true;\n  updateScore();\n  \n  // Удаляем старые звёзды\n  document.querySelectorAll('.star, .game-over').forEach(el => el.remove());\n  \n  spawnInterval = setInterval(spawnStar, 800);\n}\n\nfunction spawnStar() {\n  if (!gameActive) return;\n  const star = document.createElement('div');\n  star.className = 'star';\n  const x = Math.random() * 85 + 5;\n  const duration = 2 + Math.random() * 1.5;\n  star.style.left = x + '%';\n  star.style.animationDuration = duration + 's';\n  star.textContent = Math.random() > 0.3 ? '⭐' : '💎';\n  star.dataset.value = star.textContent === '💎' ? '25' : '10';\n  catchArea.appendChild(star);\n  \n  // Проверка поймана ли звезда\n  const checkCaught = setInterval(() => {\n    if (!gameActive) { clearInterval(checkCaught); return; }\n    const starRect = star.getBoundingClientRect();\n    const catcherRect = catcher.getBoundingClientRect();\n    \n    if (starRect.bottom >= catcherRect.top && \n        starRect.left < catcherRect.right && \n        starRect.right > catcherRect.left) {\n      const value = parseInt(star.dataset.value);\n      score += value;\n      updateScore();\n      star.remove();\n      clearInterval(checkCaught);\n    }\n  }, 50);\n  \n  setTimeout(() => {\n    clearInterval(checkCaught);\n    if (star.parentNode) {\n      star.remove();\n      lives--;\n      if (lives <= 0) endGame();\n    }\n  }, duration * 1000);\n}\n\nfunction updateScore() {\n  document.getElementById('score').textContent = score + ' | ❤️'.repeat(lives);\n}\n\nfunction endGame() {\n  gameActive = false;\n  clearInterval(spawnInterval);\n  \n  const gameOver = document.createElement('div');\n  gameOver.className = 'game-over';\n  gameOver.innerHTML = `\n    <div style=\"font-size: 48px; margin-bottom: 10px;\">💀</div>\n    <div style=\"font-size: 20px; font-weight: bold;\">Игра окончена!</div>\n    <div style=\"font-size: 16px; margin-top: 5px;\">Счёт: ${score}</div>\n    <button class=\"btn\" style=\"margin-top: 15px;\" onclick=\"startGame()\">Ещё раз</button>\n  `;\n  catchArea.appendChild(gameOver);\n}\n</script>",
  "supportedModels": [
    "iphone8",
    "iphonex",
    "iphone14",
    "epad101"
  ]
}