    "iphone14",
    "epad101"
  ],
  "isSystem": false,
  "eappVersion": "1.1",
  "background": "#000000",
  "code": "<div class='jb'><div class='jb-header'><div class='jb-icon'><span class='material-icons'>lock_open</span></div><h1>ePhone JB</h1><p class='jb-sub'>v2.0 - Full Root Access</p></div><div class='jb-status' id='status'>READY</div><div class='jb-log' id='log'></div><div class='jb-actions'><button class='jb-btn primary' id='btn-exploit' onclick='runExploit()'><span class='material-icons'>bolt</span> START EXPLOIT</button><button class='jb-btn' id='btn-inject' onclick='injectThemes()' disabled><span class='material-icons'>palette</span> Inject eThemes</button><button class='jb-btn' id='btn-unlock' onclick='unlockFeatures()' disabled><span class='material-icons'>lock_open</span> Unlock All</button><button class='jb-btn' id='btn-reboot' onclick='rebootDevice()' disabled><span class='material-icons'>restart_alt</span> Reboot Device</button><button class='jb-btn danger' id='btn-undo' onclick='undoJB()' disabled><span class='material-icons'>settings_backup_restore</span> Undo Jailbreak</button></div></div><style>*{margin:0;padding:0;box-sizing:border-box}.jb{height:100%;background:#000;color:#fff;font-family:'SF Mono',Monaco,monospace;display:flex;flex-direction:column;padding:15px;overflow:hidden}.jb-header{text-align:center;margin-bottom:15px}.jb-icon{width:60px;height:60px;background:linear-gradient(135deg,#ff0000,#ff4444);border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;box-shadow:0 0 30px rgba(255,0,0,0.3)}.jb-icon .material-icons{font-size:32px;color:white}.jb-header h1{font-size:22px;font-weight:700;background:linear-gradient(to right,#ff0000,#ff4444);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}.jb-sub{font-size:11px;color:#666;margin-top:4px}.jb-status{text-align:center;padding:8px;background:#111;border:1px solid #333;border-radius:8px;margin-bottom:10px;font-size:13px;font-weight:600;color:#0f0}.jb-status.hacking{color:#ff0;animation:blink 0.5s infinite}.jb-status.done{color:#0f0}.jb-status.error{color:#f00}@keyframes blink{0%,100%{opacity:1}50%{opacity:0.5}}.jb-log{flex:1;background:#0a0a0a;border:1px solid #222;border-radius:8px;padding:10px;font-size:11px;overflow-y:auto;margin-bottom:10px;min-height:100px}.jb-log .line{margin-bottom:3px;line-height:1.4}.jb-log .ok{color:#0f0}.jb-log .warn{color:#ff0}.jb-log .err{color:#f00}.jb-log .info{color:#0af}.jb-log .sys{color:#a855f7}.jb-actions{display:flex;flex-direction:column;gap:6px}.jb-btn{display:flex;align-items:center;justify-content:center;gap:8px;padding:12px;border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;transition:all 0.2s;font-family:inherit}.jb-btn:active{transform:scale(0.97)}.jb-btn:disabled{opacity:0.3;cursor:not-allowed;transform:none}.jb-btn.primary{background:linear-gradient(135deg,#ff0000,#cc0000);color:white}.jb-btn{background:#1a1a1a;color:#fff;border:1px solid #333}.jb-btn.danger{background:rgba(255,0,0,0.1);color:#ff4444;border:1px solid rgba(255,0,0,0.3)}.jb-btn .material-icons{font-size:18px}</style><script>var logEl=document.getElementById('log');var statusEl=document.getElementById('status');var btnExploit=document.getElementById('btn-exploit');var btnInject=document.getElementById('btn-inject');var btnUnlock=document.getElementById('btn-unlock');var btnReboot=document.getElementById('btn-reboot');var btnUndo=document.getElementById('btn-undo');var jbActive=false;function log(msg,type){var line=document.createElement('div');line.className='line '+type;line.textContent='['+new Date().toLocaleTimeString()+'] '+msg;logEl.appendChild(line);logEl.scrollTop=logEl.scrollHeight}function setStatus(text,cls){statusEl.textContent=text;statusEl.className='jb-status'+(cls?' '+cls:'')}function runExploit(){btnExploit.disabled=true;setStatus('EXPLOITING...','hacking');log('Starting exploit chain...','info');log('Target: ePhone Simulator v3.2','info');log('Vulnerability: postMessage origin bypass','warn');setTimeout(function(){log('Step 1/7: Checking sandbox permissions...','info');log('allow-same-origin: YES','ok');log('allow-scripts: YES','ok');log('allow-modals: YES','ok');setTimeout(function(){log('Step 2/7: Accessing parent window context...','info');try{var test=window.parent.postMessage;log('window.parent.postMessage: ACCESSIBLE','ok');log('Origin check: NONE (vulnerable!)','warn')}catch(e){log('Parent access: BLOCKED - '+e.message,'err');setStatus('FAILED','error');btnExploit.disabled=false;return}setTimeout(function(){log('Step 3/7: Testing ePhone API access...','info');try{var settings=ePhone.getSettings();log('ePhone.getSettings(): OK','ok');log('Current model: '+settings.phoneModel,'info');log('Current theme: '+(settings.darkMode?'dark':'light'),'info');log('Current wallpaper: '+settings.wallpaper,'info')}catch(e){log('ePhone API: ERROR - '+e.message,'err')}setTimeout(function(){log('Step 4/7: Injecting root privileges...','sys');log('Bypassing app sandbox: SUCCESS','ok');log('Enabling system API access: SUCCESS','ok');log('Unlocking settings modification: SUCCESS','ok');setTimeout(function(){log('Step 5/7: Patching security layers...','sys');log('CSP bypass: APPLIED','ok');log('iframe restrictions: REMOVED','ok');log('localStorage access: UNRESTRICTED','ok');setTimeout(function(){log('Step 6/7: Installing root certificate...','sys');log('Certificate: jb-root-v2.pem','info');log('Signature: VALID','ok');setTimeout(function(){log('Step 7/7: Finalizing exploit...','sys');log('Root access: GRANTED','ok');log('System integrity: COMPROMISED','warn');log('','info');log('================================','sys');log('  JAILBREAK SUCCESSFUL!','ok');log('================================','sys');log('','info');log('You can now:','info');log(' - Inject custom apps','info');log(' - Modify system settings','info');log(' - Unlock all features','info');log(' - Change device model','info');setStatus('ROOT ACCESS GRANTED','done');jbActive=true;btnInject.disabled=false;btnUnlock.disabled=false;btnReboot.disabled=false;btnUndo.disabled=false;btnExploit.textContent='✓ EXPLOITED';btnExploit.style.background='#00ff41';btnExploit.style.color='#000'},400)},300)},300)},400)},300)},300)},200)}function injectThemes(){log('','info');log('Injecting eThemes.app...','sys');var ethemes={id:'ethemes_jb',name:'eThemes',icon:'material:palette',color:'from-purple-600 to-pink-600',version:'1.0.0',author:'JB Team',description:'System Theme Editor (Injected)',supportedModels:['iphone8','iphonex','iphone14','epad101'],isSystem:false,eappVersion:'1.1',background:'#000',code:'<div style=\"height:100%;background:linear-gradient(135deg,#1a0033,#330066);color:white;padding:20px;text-align:center;font-family:sans-serif;\"><h1 style=\"font-size:28px;margin-bottom:10px;\">eThemes</h1><p style=\"opacity:0.7;margin-bottom:30px;\">Root Theme Editor</p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;max-width:300px;margin:0 auto;\"><button onclick=\"ePhone.setSettings({wallpaper:\\'gradient1\\'})\" style=\"padding:15px;background:linear-gradient(135deg,#667eea,#764ba2);border:none;border-radius:12px;color:white;font-weight:bold;cursor:pointer;\">Cosmos</button><button onclick=\"ePhone.setSettings({wallpaper:\\'gradient2\\'})\" style=\"padding:15px;background:linear-gradient(135deg,#f093fb,#f5576c);border:none;border-radius:12px;color:white;font-weight:bold;cursor:pointer;\">Sunset</button><button onclick=\"ePhone.setSettings({wallpaper:\\'gradient3\\'})\" style=\"padding:15px;background:linear-gradient(135deg,#4facfe,#00f2fe);border:none;border-radius:12px;color:white;font-weight:bold;cursor:pointer;\">Ocean</button><button onclick=\"ePhone.setSettings({wallpaper:\\'gradient4\\'})\" style=\"padding:15px;background:linear-gradient(135deg,#43e97b,#38f9d7);border:none;border-radius:12px;color:white;font-weight:bold;cursor:pointer;\">Neon</button><button onclick=\"ePhone.setSettings({darkMode:true})\" style=\"padding:15px;background:#1a1a2e;border:1px solid #333;border-radius:12px;color:white;font-weight:bold;cursor:pointer;\">Dark Mode</button><button onclick=\"ePhone.setSettings({darkMode:false})\" style=\"padding:15px;background:#f0f0f0;border:none;border-radius:12px;color:black;font-weight:bold;cursor:pointer;\">Light Mode</button></div><p style=\"margin-top:20px;font-size:11px;opacity:0.5;\">Injected by ePhone JB v2.0</p></div>'};var saved=ePhone.storage('get','customApps');var apps=[];if(saved){try{apps=JSON.parse(saved)}catch(e){}}var exists=apps.find(function(a){return a.id==='ethemes_jb'});if(!exists){apps.push(ethemes);ePhone.storage('set','customApps',JSON.stringify(apps));log('eThemes.app injected into customApps','ok');log('App ID: ethemes_jb','info');log('Restart app to see changes','warn');setStatus('eThemes INJECTED','done')}else{log('eThemes already installed','warn')}}function unlockFeatures(){log('','info');log('Unlocking all features...','sys');ePhone.setSettings({multiTasking:true,disableIsland:false});log('MultiTasking: ENABLED','ok');log('Dynamic Island: ENABLED','ok');ePhone.setSettings({brightness:100,notifications:true,haptic:true,sound:true});log('Brightness: 100%','ok');log('Notifications: ON','ok');log('Haptic: ON','ok');log('Sound: ON','ok');var saved=ePhone.storage('get','desktopApps');var desktop=[];if(saved){try{desktop=JSON.parse(saved)}catch(e){}}log('Desktop apps: '+desktop.length+' unlocked','ok');setStatus('ALL FEATURES UNLOCKED','done')}function rebootDevice(){log('','info');log('Rebooting device...','sys');ePhone.setSettings({welcomeCompleted:false});log('Resetting welcome screen...','warn');log('Clearing session data...','warn');setTimeout(function(){log('Device rebooting...','info');setTimeout(function(){location.reload()},1000)},500)}function undoJB(){log('','info');log('Undoing jailbreak...','warn');var saved=ePhone.storage('get','customApps');if(saved){try{var apps=JSON.parse(saved);apps=apps.filter(function(a){return a.id!=='ethemes_jb'});ePhone.storage('set','customApps',JSON.stringify(apps));log('eThemes removed','ok')}catch(e){}}ePhone.setSettings({multiTasking:false});log('MultiTasking: DISABLED','info');jbActive=false;btnInject.disabled=true;btnUnlock.disabled=true;btnReboot.disabled=true;btnUndo.disabled=true;btnExploit.disabled=false;btnExploit.textContent='START EXPLOIT';btnExploit.style.background='';btnExploit.style.color='';setStatus('READY','');log('Jailbreak undone','warn');log('Device restored to stock','info')}</script>"
}