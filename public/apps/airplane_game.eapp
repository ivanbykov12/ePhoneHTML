{
  "id": "airplane_game",
  "name": "Авиалинии",
  "icon": "material:flight_takeoff",
  "color": "from-sky-400 to-blue-600",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Управляй самолётом и уворачивайся от препятствий.",
  "supportedModels": [
    "iphone8",
    "iphonex",
    "iphone14",
    "epad101"
  ],
  "isSystem": true,
  "changelog": "Первая версия",
  "code": "<div class=\"wrap\"><div class=\"hud\"><span>❤️ <b id=\"hp\">3</b></span><span>⭐ <b id=\"sc\">0</b></span><span>🏆 <b id=\"hs\">0</b></span></div><canvas id=\"cv\"></canvas><div class=\"over hidden\" id=\"over\"><div class=\"ot\">Уничтожен!</div><div class=\"os\" id=\"fs\"></div><button onclick=\"rst()\">Заново ✈️</button></div></div><style>.wrap{height:100vh;background:linear-gradient(#020210,#0a0a2e);display:flex;flex-direction:column;color:#fff;font-family:sans-serif;overflow:hidden;position:relative}.hud{display:flex;justify-content:space-between;padding:10px 16px;font-size:14px}.hud span{background:rgba(255,255,255,.08);padding:4px 12px;border-radius:14px}canvas{flex:1;width:100%;touch-action:none}.over{position:absolute;inset:0;background:rgba(0,0,0,.75);backdrop-filter:blur(6px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px}.hidden{display:none!important}.ot{font-size:28px;font-weight:800;color:#ff453a}.over button{padding:12px 28px;border:none;border-radius:22px;background:linear-gradient(135deg,#32ade6,#5e5ce6);color:#fff;font-size:15px;font-weight:700;cursor:pointer}</style><script>var cv=document.getElementById('cv'),ctx=cv.getContext('2d');var px=.5,py=.85,bul=[],ene=[],par=[],sc=0,hp=3,hs=+(ePhone.load('ah')||0),alive=true,t=0;document.getElementById('hs').textContent=hs;function fit(){cv.width=cv.clientWidth*devicePixelRatio;cv.height=cv.clientHeight*devicePixelRatio;}setTimeout(fit,60);addEventListener('resize',fit);function setp(e){var r=cv.getBoundingClientRect();var c=e.touches?e.touches[0]:e;px=Math.min(.95,Math.max(.05,(c.clientX-r.left)/r.width));py=Math.min(.95,Math.max(.05,(c.clientY-r.top)/r.height));}cv.addEventListener('touchstart',function(e){setp(e);},{passive:true});cv.addEventListener('touchmove',function(e){setp(e);e.preventDefault();},{passive:false});cv.addEventListener('mousemove',function(e){setp(e);});function boom(x,y,c,n){for(var i=0;i<n;i++)par.push({x:x,y:y,vx:(Math.random()-.5)*.012,vy:(Math.random()-.5)*.012,a:1,c:c});}function rst(){sc=0;hp=3;bul=[];ene=[];par=[];document.getElementById('sc').textContent=0;document.getElementById('hp').textContent=3;document.getElementById('over').classList.add('hidden');alive=true;}function die(){alive=false;document.getElementById('over').classList.remove('hidden');if(sc>hs){hs=sc;ePhone.save('ah',hs);document.getElementById('hs').textContent=hs;}try{ePhone.notify('Айрексы','Ваш самолёт сбит! Счёт: '+sc);}catch(e){}ePhone.vibrate([60,50,90]);}(function L(){requestAnimationFrame(L);if(!cv.width)return;t++;ctx.fillStyle='rgba(2,2,16,.4)';ctx.fillRect(0,0,cv.width,cv.height);if(t%3===0){ctx.fillStyle='#fff';ctx.fillRect(Math.random()*cv.width,Math.random()*cv.height,1.5,1.5);}if(alive){if(t%Math.max(16,46-Math.floor(sc/4))===0)ene.push({x:Math.random(),y:-.05,v:.004+Math.random()*.004+sc*.00002,e:['👾','🛸','☄️','👽'][Math.floor(Math.random()*4)]});if(t%8===0)bul.push({x:px,y:py-.03});}ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillStyle='#32ade6';for(var i=bul.length-1;i>=0;i--){var b=bul[i];b.y-=.022;if(b.y<-.05){bul.splice(i,1);continue;}ctx.fillRect(b.x*cv.width-2*devicePixelRatio,b.y*cv.height,4*devicePixelRatio,14*devicePixelRatio);}for(var j=ene.length-1;j>=0;j--){var en=ene[j];en.y+=en.v;if(en.y>1.06){ene.splice(j,1);continue;}ctx.font=(.07*cv.width)+'px serif';ctx.fillText(en.e,en.x*cv.width,en.y*cv.height);for(var k=bul.length-1;k>=0;k--){if(Math.hypot((en.x-bul[k].x)*cv.width,(en.y-bul[k].y)*cv.height)<.05*cv.width){ene.splice(j,1);bul.splice(k,1);sc++;boom(en.x,en.y,'#ff9f0a',10);document.getElementById('sc').textContent=sc;ePhone.vibrate(6);break;}}}if(alive){ctx.font=(.075*cv.width)+'px serif';ctx.fillText('✈️',px*cv.width,py*cv.height);for(var m=ene.length-1;m>=0;m--){var e2=ene[m];if(Math.hypot((e2.x-px)*cv.width,(e2.y-py)*cv.height)<.055*cv.width){ene.splice(m,1);hp--;boom(px,py,'#ff453a',16);document.getElementById('hp').textContent=hp;ePhone.vibrate([30,30,60]);if(hp<=0)die();}}}for(var p=par.length-1;p>=0;p--){var pp=par[p];pp.x+=pp.vx;pp.y+=pp.vy;pp.a-=.03;if(pp.a<=0){par.splice(p,1);continue;}ctx.globalAlpha=pp.a;ctx.fillStyle=pp.c;ctx.fillRect(pp.x*cv.width,pp.y*cv.height,3,3);ctx.globalAlpha=1;}})();</script>"
}