{
  "id": "safari_system",
  "name": "Safari",
  "icon": "material:language",
  "color": "from-blue-400 to-blue-600",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Веб-браузер",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "Системное приложение",
  "code": "<!--\n⚠️ СИСТЕМНОЕ ПРИЛОЖЕНИЕ - НЕ УДАЛЯТЬ:\n- Поисковая строка с id=\"urlBar\"\n- Закладки bookmarks\n- Функции: navigate(), loadBookmarks()\n-->\n<div class=\"safari-app\">\n  <div class=\"url-bar\">\n    <span class=\"material-icons\">lock</span>\n    <input type=\"text\" id=\"urlBar\" placeholder=\"Поиск или адрес\" onkeypress=\"if(event.key==='Enter')navigate()\">\n    <button onclick=\"navigate()\" class=\"go-btn\"><span class=\"material-icons\">arrow_forward</span></button>\n  </div>\n  <div class=\"bookmarks\" id=\"bookmarks\"></div>\n  <div class=\"content\" id=\"content\">\n    <div class=\"welcome\">\n      <span class=\"material-icons\" style=\"font-size: 64px; opacity: 0.3;\">language</span>\n      <h2>Safari</h2>\n      <p>Введите адрес или выберите закладку</p>\n    </div>\n  </div>\n</div>\n\n<style>\n.safari-app { padding: 20px; display: flex; flex-direction: column; height: 100%; }\n.url-bar { display: flex; align-items: center; gap: 8px; padding: 10px; background: rgba(128,128,128,0.2); border-radius: 12px; margin-bottom: 20px; }\n.url-bar input { flex: 1; background: none; border: none; outline: none; font-size: 14px; color: inherit; }\n.go-btn { background: none; border: none; cursor: pointer; color: inherit; }\n.bookmarks { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 20px; }\n.bookmark { display: flex; flex-direction: column; align-items: center; gap: 5px; cursor: pointer; }\n.bookmark-icon { width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; }\n.bookmark-name { font-size: 11px; text-align: center; }\n.content { flex: 1; background: rgba(128,128,128,0.1); border-radius: 12px; padding: 40px; text-align: center; }\n.welcome h2 { font-size: 24px; margin: 20px 0 10px; }\n.welcome p { opacity: 0.7; }\n</style>\n\n<script>\n// ⚠️ НЕ УДАЛЯТЬ: Инициализация\nconst settings = ePhone.getSettings();\ndocument.querySelector('.safari-app').style.color = settings.darkMode ? 'white' : 'black';\n\n// ⚠️ НЕ УДАЛЯТЬ: Закладки\nconst bookmarks = [\n  { name: 'Epple', icon: '🍎', url: 'epple.com', color: 'from-gray-700 to-gray-900' },\n  { name: 'Google', icon: '🔍', url: 'google.com', color: 'from-blue-400 to-blue-600' },\n  { name: 'YouTube', icon: '▶️', url: 'youtube.com', color: 'from-red-500 to-red-700' },\n  { name: 'GitHub', icon: '🐙', url: 'github.com', color: 'from-gray-800 to-black' },\n  { name: 'Twitter', icon: '🐦', url: 'x.com', color: 'from-black to-gray-900' },\n  { name: 'Reddit', icon: '🤖', url: 'reddit.com', color: 'from-orange-500 to-red-600' },\n  { name: 'Wikipedia', icon: '📚', url: 'wikipedia.org', color: 'from-gray-400 to-gray-600' },\n  { name: 'Stack', icon: '📋', url: 'stackoverflow.com', color: 'from-orange-400 to-orange-600' }\n];\n\n// ⚠️ НЕ УДАЛЯТЬ: Функции навигации\nfunction loadBookmarks() {\n  const container = document.getElementById('bookmarks');\n  container.innerHTML = bookmarks.map(bm => `\n    <div class=\"bookmark\" onclick=\"navigateTo('${bm.url}')\">\n      <div class=\"bookmark-icon bg-gradient-to-br ${bm.color}\">${bm.icon}</div>\n      <div class=\"bookmark-name\">${bm.name}</div>\n    </div>\n  `).join('');\n}\n\nfunction navigate() {\n  const url = document.getElementById('urlBar').value;\n  if (url) navigateTo(url);\n}\n\nfunction navigateTo(url) {\n  document.getElementById('urlBar').value = url;\n  document.getElementById('content').innerHTML = `\n    <div class=\"welcome\">\n      <span class=\"material-icons\" style=\"font-size: 64px; opacity: 0.3;\">public</span>\n      <h2>${url}</h2>\n      <p>Демо-страница браузера</p>\n    </div>\n  `;\n}\n\nloadBookmarks();\n</script>"
}
