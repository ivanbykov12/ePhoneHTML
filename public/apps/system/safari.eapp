{
  "id": "safari_system",
  "name": "Safari",
  "icon": "material:language",
  "color": "from-blue-400 to-blue-600",
  "version": "3.0.0",
  "author": "ePhone System",
  "description": "Веб-браузер с новым дизайном",
  "supportedModels": ["iphone8", "iphonex", "iphone14", "epad101"],
  "isSystem": true,
  "eappVersion": "1.1",
  "code": "<div class=\"app\"><div class=\"url-bar\"><span class=\"material-icons\">lock</span><input type=\"text\" id=\"urlBar\" placeholder=\"Поиск или адрес\" onkeypress=\"if(event.key==='Enter')navigate()\"><button onclick=\"navigate()\" class=\"go-btn\"><span class=\"material-icons\">arrow_forward</span></button></div><div class=\"bookmarks\" id=\"bookmarks\"></div><div class=\"content\" id=\"content\"><div class=\"welcome\"><span class=\"material-icons\" style=\"font-size:64px;opacity:0.2;\">language</span><h2>Safari</h2><p>Введите адрес или выберите закладку</p></div></div></div><style>.app{padding:20px;display:flex;flex-direction:column;height:100%;background:linear-gradient(135deg,#0a0a0a 0%,#1a1a2e 100%);color:white}.url-bar{display:flex;align-items:center;gap:8px;padding:10px;background:rgba(255,255,255,0.06);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:14px;margin-bottom:20px}.url-bar input{flex:1;background:none;border:none;outline:none;font-size:14px;color:white}.url-bar input::placeholder{color:rgba(255,255,255,0.4)}.go-btn{background:none;border:none;cursor:pointer;color:white;padding:5px}.bookmarks{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px}.bookmark{display:flex;flex-direction:column;align-items:center;gap:5px;cursor:pointer;transition:all 0.2s}.bookmark:active{transform:scale(0.9)}.bookmark-icon{width:50px;height:50px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:24px;box-shadow:0 4px 15px rgba(0,0,0,0.2)}.bookmark-name{font-size:11px;text-align:center;opacity:0.8}.content{flex:1;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:40px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center}.welcome h2{font-size:24px;margin:20px 0 10px}.welcome p{opacity:0.5}</style><script>var s=ePhone.getSettings();var bookmarks=[{name:'Epple',icon:'🍎',url:'epple.com',color:'linear-gradient(135deg,#2d3436,#636e72)'},{name:'Google',icon:'🔍',url:'google.com',color:'linear-gradient(135deg,#0984e3,#74b9ff)'},{name:'YouTube',icon:'▶️',url:'youtube.com',color:'linear-gradient(135deg,#d63031,#ff7675)'},{name:'GitHub',icon:'🐙',url:'github.com',color:'linear-gradient(135deg,#2d3436,#636e72)'},{name:'Twitter',icon:'🐦',url:'x.com',color:'linear-gradient(135deg,#2d3436,#636e72)'},{name:'Reddit',icon:'🤖',url:'reddit.com',color:'linear-gradient(135deg,#e17055,#fab1a0)'},{name:'Wikipedia',icon:'📚',url:'wikipedia.org',color:'linear-gradient(135deg,#636e72,#b2bec3)'},{name:'Stack',icon:'📋',url:'stackoverflow.com',color:'linear-gradient(135deg,#e17055,#fab1a0)'}];function loadBookmarks(){var container=document.getElementById('bookmarks');container.innerHTML=bookmarks.map(function(bm){return '<div class=\"bookmark\" onclick=\"navigateTo(\\''+bm.url+'\\')\"><div class=\"bookmark-icon\" style=\"background:'+bm.color+'\">'+bm.icon+'</div><div class=\"bookmark-name\">'+bm.name+'</div></div>'}).join('')}function navigate(){var url=document.getElementById('urlBar').value;if(url)navigateTo(url)}function navigateTo(url){document.getElementById('urlBar').value=url;document.getElementById('content').innerHTML='<div class=\"welcome\"><span class=\"material-icons\" style=\"font-size:64px;opacity:0.2;\">public</span><h2>'+url+'</h2><p>Демо-страница браузера</p></div>'}loadBookmarks();</script>"
}
