{
  "id": "welcome_setup",
  "name": "Настройка",
  "icon": "material:build",
  "color": "from-indigo-500 to-purple-600",
  "version": "1.1.0",
  "author": "ePhone System",
  "description": "Первоначальная настройка устройства (Full Screen Mode)",
  "supportedModels": ["iphone8", "iphonex", "iphone14", "epad101"],
  "isSystem": true,
  "eappVersion": "1.1",
  "fullscreen": true,
  "background": "#000000",
  "code": "<div id=\"setup-root\" class=\"setup-overlay\">\n  <div class=\"slides-container\">\n    <div class=\"slide active\" data-index=\"0\">\n      <h1 class=\"title\" id=\"welcome-title\">Добро пожаловать</h1>\n      <p class=\"subtitle\">Выберите свой язык</p>\n      <div class=\"lang-grid\" id=\"lang-grid\"></div>\n    </div>\n    <div class=\"slide\" data-index=\"1\">\n      <h1 class=\"title\">Регион</h1>\n      <p class=\"subtitle\">Где вы находитесь?</p>\n      <div class=\"list-scroll\" id=\"region-list\"></div>\n    </div>\n    <div class=\"slide\" data-index=\"2\">\n      <h1 class=\"title\">Wi-Fi</h1>\n      <p class=\"subtitle\">Выберите сеть для подключения</p>\n      <div class=\"list-scroll\" id=\"wifi-list\"></div>\n      <button class=\"text-btn\" onclick=\"nextSlide()\">Пропустить настройку Wi-Fi</button>\n    </div>\n    <div class=\"slide\" data-index=\"3\">\n      <h1 class=\"title\">Внешний вид</h1>\n      <p class=\"subtitle\">Выберите тему оформления</p>\n      <div class=\"theme-cards\">\n        <div class=\"theme-card light\" onclick=\"selectTheme('light')\">\n          <div class=\"preview light-prev\"></div>\n          <span>Светлая</span>\n        </div>\n        <div class=\"theme-card dark selected\" onclick=\"selectTheme('dark')\">\n          <div class=\"preview dark-prev\"></div>\n          <span>Тёмная</span>\n        </div>\n      </div>\n    </div>\n    <div class=\"slide\" data-index=\"4\">\n      <h1 class=\"title\">Epple ID</h1>\n      <p class=\"subtitle\">Войдите или создайте аккаунт</p>\n      <div class=\"input-group\">\n        <input type=\"email\" placeholder=\"Email или телефон\" class=\"ios-input\">\n        <input type=\"password\" placeholder=\"Пароль\" class=\"ios-input\">\n      </div>\n      <button class=\"primary-btn\" onclick=\"nextSlide()\">Продолжить</button>\n      <button class=\"text-btn\" onclick=\"nextSlide()\">Забыли пароль или нет Epple ID?</button>\n      <button class=\"text-btn\" onclick=\"nextSlide()\">Пропустить этот шаг</button>\n    </div>\n    <div class=\"slide\" data-index=\"5\">\n      <h1 class=\"big-welcome\">ePhone</h1>\n      <p class=\"sub-welcome\">Ваш новый опыт начинается здесь.</p>\n      <button class=\"start-btn\" onclick=\"finishSetup()\">Начать</button>\n    </div>\n  </div>\n  <div class=\"nav-bar\">\n    <button class=\"nav-back\" id=\"btn-back\" onclick=\"prevSlide()\" style=\"opacity:0;pointer-events:none;\">Назад</button>\n    <div class=\"pagination\" id=\"pagination\"></div>\n    <button class=\"nav-next\" id=\"btn-next\" onclick=\"nextSlide()\">Далее</button>\n  </div>\n</div>\n\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  html, body { width: 100%; height: 100%; overflow: hidden; margin: 0; padding: 0; }\n  \n  #setup-root {\n    position: fixed;\n    top: 0; left: 0; right: 0; bottom: 0;\n    width: 100%; height: 100%;\n    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);\n    color: white;\n    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif;\n    display: flex;\n    flex-direction: column;\n    overflow: hidden;\n  }\n\n  .slides-container { flex: 1; position: relative; overflow: hidden; width: 100%; height: 100%; }\n  .slide {\n    position: absolute; top: 0; left: 0; right: 0; bottom: 0;\n    display: flex; flex-direction: column; align-items: center; justify-content: center;\n    padding: 40px 30px 120px;\n    opacity: 0; transform: translateX(50px); pointer-events: none;\n    transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);\n  }\n  .slide.active { opacity: 1; transform: translateX(0); pointer-events: auto; }\n  .slide.prev { transform: translateX(-50px); }\n\n  .title { font-size: 34px; font-weight: 700; margin: 0 0 10px; text-align: center; }\n  .subtitle { font-size: 18px; color: rgba(255,255,255,0.7); margin: 0 0 40px; text-align: center; }\n  .big-welcome { font-size: 64px; font-weight: 800; background: linear-gradient(to right, #fff, #a5b4fc); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 20px; }\n  .sub-welcome { font-size: 20px; color: rgba(255,255,255,0.8); margin-bottom: 60px; text-align: center; }\n\n  .lang-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; width: 100%; max-width: 320px; }\n  .list-scroll { width: 100%; max-width: 320px; max-height: 400px; overflow-y: auto; scrollbar-width: none; }\n  .list-scroll::-webkit-scrollbar { display: none; }\n  \n  .item-btn {\n    width: 100%; padding: 16px; margin-bottom: 8px;\n    background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.1);\n    border-radius: 14px; color: white; font-size: 17px; text-align: left;\n    cursor: pointer; transition: 0.2s; backdrop-filter: blur(10px);\n  }\n  .item-btn:hover, .item-btn.selected { background: rgba(255,255,255,0.2); border-color: rgba(255,255,255,0.4); }\n\n  .theme-cards { display: flex; gap: 20px; }\n  .theme-card { cursor: pointer; text-align: center; opacity: 0.6; transition: 0.3s; }\n  .theme-card.selected { opacity: 1; transform: scale(1.05); }\n  .preview { width: 100px; height: 160px; border-radius: 20px; margin-bottom: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); border: 2px solid transparent; }\n  .theme-card.selected .preview { border-color: #60a5fa; }\n  .light-prev { background: #f3f4f6; }\n  .dark-prev { background: #1f2937; }\n\n  .input-group { width: 100%; max-width: 300px; display: flex; flex-direction: column; gap: 12px; margin-bottom: 30px; }\n  .ios-input { padding: 16px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); border-radius: 12px; color: white; font-size: 17px; outline: none; }\n  .ios-input:focus { background: rgba(255,255,255,0.15); border-color: #60a5fa; }\n  \n  .primary-btn { width: 100%; max-width: 300px; padding: 16px; background: #3b82f6; color: white; border: none; border-radius: 14px; font-size: 17px; font-weight: 600; cursor: pointer; margin-bottom: 15px; }\n  .start-btn { padding: 18px 50px; background: white; color: #1e1b4b; border: none; border-radius: 30px; font-size: 20px; font-weight: 700; cursor: pointer; box-shadow: 0 10px 40px rgba(255,255,255,0.2); transition: transform 0.2s; }\n  .start-btn:active { transform: scale(0.95); }\n  .text-btn { background: none; border: none; color: #60a5fa; font-size: 15px; margin-top: 10px; cursor: pointer; }\n\n  .nav-bar {\n    position: absolute; bottom: 0; left: 0; right: 0;\n    padding: 20px 30px 50px;\n    display: flex; justify-content: space-between; align-items: center;\n    background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);\n    backdrop-filter: blur(10px);\n  }\n  .nav-back, .nav-next { background: none; border: none; color: #60a5fa; font-size: 17px; font-weight: 500; cursor: pointer; min-width: 60px; }\n  .nav-next { text-align: right; }\n  .pagination { display: flex; gap: 6px; }\n  .dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.3); transition: 0.3s; }\n  .dot.active { background: white; width: 20px; border-radius: 4px; }\n</style>\n\n<script>\nvar current = 0;\nvar total = 6;\nvar settings = { lang: 'Русский', region: 'Россия', theme: 'dark' };\n\nvar langs = ['Русский', 'English', 'Español', 'Deutsch', 'Français', '中文'];\nvar regions = ['Россия', 'США', 'Германия', 'Франция', 'Япония', 'Китай'];\nvar wifis = ['Home_WiFi', 'Office_5G', 'Guest_Network', 'iPhone Hotspot'];\n\nfunction init() {\n  renderList('lang-grid', langs, 'lang');\n  renderList('region-list', regions, 'region');\n  renderList('wifi-list', wifis, 'wifi');\n  updateDots();\n}\n\nfunction renderList(id, items, type) {\n  var el = document.getElementById(id);\n  if(!el) return;\n  el.innerHTML = items.map(function(item, i) {\n    var sel = (type==='lang' && item===settings.lang) || (type==='region' && item===settings.region) ? ' selected' : '';\n    var icon = type==='wifi' ? '📶 ' : '';\n    return '<div class=\"item-btn'+sel+'\" onclick=\"selectItem(\\''+type+'\\', \\''+item+'\\', this)\">'+icon+item+'</div>';\n  }).join('');\n}\n\nfunction selectItem(type, val, el) {\n  settings[type] = val;\n  el.parentElement.querySelectorAll('.item-btn').forEach(function(b) { b.classList.remove('selected'); });\n  el.classList.add('selected');\n  if(ePhone.vibrate) ePhone.vibrate(10);\n}\n\nfunction selectTheme(t) {\n  settings.theme = t;\n  document.querySelectorAll('.theme-card').forEach(function(c) { c.classList.remove('selected'); });\n  document.querySelector('.theme-card.'+t).classList.add('selected');\n  if(ePhone.setSettings) ePhone.setSettings({ darkMode: t === 'dark' });\n}\n\nfunction nextSlide() {\n  if(current < total - 1) {\n    var slides = document.querySelectorAll('.slide');\n    slides[current].classList.remove('active');\n    slides[current].classList.add('prev');\n    current++;\n    slides[current].classList.add('active');\n    updateNav();\n    if(ePhone.vibrate) ePhone.vibrate(10);\n  }\n}\n\nfunction prevSlide() {\n  if(current > 0) {\n    var slides = document.querySelectorAll('.slide');\n    slides[current].classList.remove('active');\n    current--;\n    slides[current].classList.remove('prev');\n    slides[current].classList.add('active');\n    updateNav();\n  }\n}\n\nfunction updateNav() {\n  var back = document.getElementById('btn-back');\n  var next = document.getElementById('btn-next');\n  back.style.opacity = current > 0 ? '1' : '0';\n  back.style.pointerEvents = current > 0 ? 'auto' : 'none';\n  next.style.display = current === total - 1 ? 'none' : 'block';\n  updateDots();\n}\n\nfunction updateDots() {\n  var p = document.getElementById('pagination');\n  p.innerHTML = '';\n  for(var i=0; i<total; i++) {\n    var d = document.createElement('div');\n    d.className = 'dot' + (i === current ? ' active' : '');\n    p.appendChild(d);\n  }\n}\n\nfunction finishSetup() {\n  if(ePhone.setSettings) {\n    ePhone.setSettings({ \n      language: settings.lang, \n      region: settings.region, \n      darkMode: settings.theme === 'dark',\n      welcomeCompleted: true\n    });\n  }\n  if(ePhone.vibrate) ePhone.vibrate([50, 50, 50]);\n  setTimeout(function() { \n    if(ePhone.closeApp) ePhone.closeApp(); \n  }, 300);\n}\n\ninit();\n</script>"
}
