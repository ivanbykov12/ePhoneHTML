{
  "id": "welcome_setup",
  "name": "Настройка",
  "icon": "material:setup",
  "color": "from-blue-500 to-purple-600",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Первоначальная настройка устройства",
  "supportedModels": ["iphone8", "iphonex", "iphone14", "epad"],
  "isSystem": true,
  "eappVersion": "1.1",
  "fullscreen": true,
  "code": "<div class=\"welcome-app\"><div class=\"slides\"><div class=\"slide active\" id=\"slide-0\"><div class=\"welcome-text\" id=\"welcomeText\">Добро пожаловать</div><div class=\"welcome-subtitle\">Выберите язык</div><div class=\"language-grid\" id=\"languageGrid\"></div></div><div class=\"slide\" id=\"slide-1\"><div class=\"slide-title\">Выберите регион</div><div class=\"region-list\" id=\"regionList\"></div></div><div class=\"slide\" id=\"slide-2\"><div class=\"slide-title\">Подключение к Wi-Fi</div><div class=\"wifi-list\" id=\"wifiList\"></div><button class=\"skip-btn\" onclick=\"nextSlide()\">Пропустить</button></div><div class=\"slide\" id=\"slide-3\"><div class=\"slide-title\">Выберите тему</div><div class=\"theme-selector\"><div class=\"theme-option\" onclick=\"selectTheme('light')\"><div class=\"theme-preview light\"></div><div class=\"theme-label\">Светлая</div></div><div class=\"theme-option\" onclick=\"selectTheme('dark')\"><div class=\"theme-preview dark\"></div><div class=\"theme-label\">Тёмная</div></div></div></div><div class=\"slide\" id=\"slide-4\"><div class=\"slide-title\">Вход в Epple ID</div><div class=\"login-form\"><input type=\"email\" placeholder=\"Email\" class=\"login-input\"><input type=\"password\" placeholder=\"Пароль\" class=\"login-input\"><button class=\"login-btn\" onclick=\"nextSlide()\">Войти</button><button class=\"skip-btn\" onclick=\"nextSlide()\">Пропустить</button></div></div><div class=\"slide\" id=\"slide-5\"><div class=\"final-welcome\">Добро пожаловать в<br><span class=\"brand\">ePhone</span></div><button class=\"start-btn\" onclick=\"finishSetup()\">Начать</button></div></div><div class=\"navigation\"><button class=\"nav-btn\" id=\"backBtn\" onclick=\"prevSlide()\" style=\"visibility:hidden;\">Назад</button><div class=\"dots\" id=\"dots\"></div><button class=\"nav-btn\" id=\"nextBtn\" onclick=\"nextSlide()\">Далее</button></div></div><style>.welcome-app{width:100%;height:100%;background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);display:flex;flex-direction:column;overflow:hidden}.slides{flex:1;position:relative;overflow:hidden}.slide{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px;opacity:0;transform:translateX(100%);transition:all 0.5s cubic-bezier(0.4,0,0.2,1)}.slide.active{opacity:1;transform:translateX(0)}.slide.prev{transform:translateX(-100%)}.welcome-text{font-size:48px;font-weight:700;color:white;margin-bottom:20px;text-align:center;text-shadow:0 2px 20px rgba(0,0,0,0.3)}.welcome-subtitle{font-size:18px;color:rgba(255,255,255,0.8);margin-bottom:40px}.slide-title{font-size:32px;font-weight:600;color:white;margin-bottom:40px;text-align:center}.language-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:15px;width:100%;max-width:400px}.language-btn{padding:15px;background:rgba(255,255,255,0.15);backdrop-filter:blur(10px);border:2px solid rgba(255,255,255,0.2);border-radius:12px;color:white;font-size:16px;cursor:pointer;transition:all 0.2s}.language-btn:hover{background:rgba(255,255,255,0.25);transform:scale(1.05)}.language-btn.selected{background:rgba(255,255,255,0.3);border-color:white}.region-list{width:100%;max-width:400px;max-height:400px;overflow-y:auto}.region-item{padding:15px;background:rgba(255,255,255,0.1);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.2);border-radius:10px;color:white;margin-bottom:10px;cursor:pointer;transition:all 0.2s}.region-item:hover{background:rgba(255,255,255,0.2)}.region-item.selected{background:rgba(255,255,255,0.3);border-color:white}.wifi-list{width:100%;max-width:400px;max-height:350px;overflow-y:auto;margin-bottom:20px}.wifi-item{padding:15px;background:rgba(255,255,255,0.1);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.2);border-radius:10px;color:white;margin-bottom:10px;cursor:pointer;display:flex;align-items:center;gap:10px;transition:all 0.2s}.wifi-item:hover{background:rgba(255,255,255,0.2)}.wifi-item.connected{background:rgba(52,199,89,0.3);border-color:#34c759}.wifi-icon{font-size:20px}.theme-selector{display:flex;gap:30px}.theme-option{cursor:pointer;text-align:center;transition:all 0.2s}.theme-option:hover{transform:scale(1.05)}.theme-preview{width:120px;height:200px;border-radius:20px;margin-bottom:15px;box-shadow:0 8px 32px rgba(0,0,0,0.3)}.theme-preview.light{background:linear-gradient(135deg,#f5f5f7,#e8e8ed)}.theme-preview.dark{background:linear-gradient(135deg,#1c1c1e,#2c2c2e)}.theme-label{color:white;font-size:16px;font-weight:500}.login-form{width:100%;max-width:350px;display:flex;flex-direction:column;gap:15px}.login-input{padding:15px;background:rgba(255,255,255,0.15);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.3);border-radius:12px;color:white;font-size:16px;outline:none;transition:all 0.2s}.login-input::placeholder{color:rgba(255,255,255,0.5)}.login-input:focus{background:rgba(255,255,255,0.2);border-color:white}.login-btn{padding:15px;background:white;color:#667eea;border:none;border-radius:12px;font-size:16px;font-weight:600;cursor:pointer;transition:all 0.2s}.login-btn:hover{transform:scale(1.02)}.skip-btn{padding:12px;background:transparent;color:rgba(255,255,255,0.7);border:1px solid rgba(255,255,255,0.3);border-radius:12px;font-size:14px;cursor:pointer;transition:all 0.2s}.skip-btn:hover{background:rgba(255,255,255,0.1)}.final-welcome{font-size:36px;font-weight:300;color:white;text-align:center;margin-bottom:50px;line-height:1.4}.brand{font-size:56px;font-weight:700;background:linear-gradient(135deg,#fff,#e0e0e0);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}.start-btn{padding:18px 60px;background:white;color:#667eea;border:none;border-radius:25px;font-size:18px;font-weight:600;cursor:pointer;box-shadow:0 8px 32px rgba(0,0,0,0.3);transition:all 0.2s}.start-btn:hover{transform:scale(1.05);box-shadow:0 12px 40px rgba(0,0,0,0.4)}.navigation{padding:20px 40px;display:flex;align-items:center;justify-content:space-between;background:rgba(0,0,0,0.2);backdrop-filter:blur(20px)}.nav-btn{padding:12px 30px;background:rgba(255,255,255,0.2);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.3);border-radius:20px;color:white;font-size:15px;font-weight:500;cursor:pointer;transition:all 0.2s}.nav-btn:hover{background:rgba(255,255,255,0.3)}.dots{display:flex;gap:8px}.dot{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,0.3);transition:all 0.3s}.dot.active{background:white;width:24px;border-radius:4px}</style><script>var currentSlide=0;var totalSlides=6;var selectedLanguage='Русский';var selectedRegion='Россия';var selectedTheme='dark';var languages=[{code:'ru',name:'Русский'},{code:'en',name:'English'},{code:'es',name:'Español'},{code:'fr',name:'Français'},{code:'de',name:'Deutsch'},{code:'zh',name:'中文'}];var regions=['Россия','США','Великобритания','Германия','Франция','Испания','Китай','Япония'];var wifiNetworks=[{name:'Home_WiFi',strength:3,secured:true},{name:'Office_Network',strength:2,secured:true},{name:'Guest_WiFi',strength:2,secured:false},{name:'Coffee_Shop',strength:1,secured:false}];var welcomeMessages={ru:'Добро пожаловать',en:'Welcome',es:'Bienvenido',fr:'Bienvenue',de:'Willkommen',zh:'欢迎'};function init(){renderLanguages();renderRegions();renderWiFi();renderDots();updateWelcomeText()}function renderLanguages(){var grid=document.getElementById('languageGrid');grid.innerHTML=languages.map(function(lang){return '<button class=\"language-btn'+(lang.name===selectedLanguage?' selected':'')+'\" onclick=\"selectLanguage(\\''+lang.code+'\\',\\''+lang.name+'\\')\">'+lang.name+'</button>'}).join('')}function renderRegions(){var list=document.getElementById('regionList');list.innerHTML=regions.map(function(region){return '<div class=\"region-item'+(region===selectedRegion?' selected':'')+'\" onclick=\"selectRegion(\\''+region+'\\')\">'+region+'</div>'}).join('')}function renderWiFi(){var list=document.getElementById('wifiList');list.innerHTML=wifiNetworks.map(function(wifi){var signalBars='';for(var i=0;i<3;i++){signalBars+=i<wifi.strength?'█':'░'}return '<div class=\"wifi-item\" onclick=\"connectWiFi(this)\"><span class=\"wifi-icon\">📶</span><span style=\"flex:1\">'+wifi.name+'</span><span style=\"opacity:0.6;font-size:12px\">'+signalBars+(wifi.secured?' 🔒':'')+'</span></div>'}).join('')}function renderDots(){var dots=document.getElementById('dots');dots.innerHTML='';for(var i=0;i<totalSlides;i++){var dot=document.createElement('div');dot.className='dot'+(i===currentSlide?' active':'');dots.appendChild(dot)}}function selectLanguage(code,name){selectedLanguage=name;ePhone.setSettings({language:name});renderLanguages();updateWelcomeText()}function updateWelcomeText(){document.getElementById('welcomeText').textContent=welcomeMessages[languages.find(function(l){return l.name===selectedLanguage}).code]||'Добро пожаловать'}function selectRegion(region){selectedRegion=region;ePhone.setSettings({region:region});renderRegions()}function selectTheme(theme){selectedTheme=theme;ePhone.setSettings({darkMode:theme==='dark'})}function connectWiFi(el){document.querySelectorAll('.wifi-item').forEach(function(item){item.classList.remove('connected')});el.classList.add('connected')}function nextSlide(){if(currentSlide<totalSlides-1){currentSlide++;updateSlide()}}function prevSlide(){if(currentSlide>0){currentSlide--;updateSlide()}}function updateSlide(){document.querySelectorAll('.slide').forEach(function(slide,index){slide.classList.remove('active','prev');if(index<currentSlide)slide.classList.add('prev');else if(index===currentSlide)slide.classList.add('active')});document.getElementById('backBtn').style.visibility=currentSlide>0?'visible':'hidden';document.getElementById('nextBtn').style.display=currentSlide===totalSlides-1?'none':'block';renderDots()}function finishSetup(){ePhone.setSettings({welcomeCompleted:true});ePhone.closeApp()}init();</script>"
}
