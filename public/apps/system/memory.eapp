{"id": "system/memory.eapp", "name": "Парочки", "icon": "material:style", "color": "from-teal-500 to-emerald-700", "version": "1.0.0", "author": "ePhone Studio", "description": "Найди все пары эмодзи", "supportedModels": ["iphone8", "iphonex", "iphone14", "epad101"], "isSystem": true, "eappVersion": "1.0", "changelog": "Первая версия", "code": "\n<div style=\"width:100%;min-height:100vh;background:#111827;display:flex;flex-direction:column;align-items:center;font-family:sans-serif;color:#fff;padding-top:60px\">\n<div style=\"font-size:14px;margin-bottom:12px\">Ходы: <b id=\"m\">0</b> <span id=\"w\" style=\"display:none;color:#22c55e;margin-left:10px\">Победа! 🎉</span></div>\n<div id=\"b\" style=\"display:grid;grid-template-columns:repeat(4,64px);gap:10px\"></div>\n<button onclick=\"location.reload()\" style=\"margin-top:16px;background:#374151;color:#fff;border:0;border-radius:10px;padding:8px 18px\">Заново</button>\n</div>\n<script>\nvar E=['🍎','🚀','🎸','⚽','🌙','🍩','🐱','🌋'],d=[].concat(E,E).sort(function(){return Math.random()-.5}),op=[],lock=false,mv=0,b=document.getElementById('b');\nd.forEach(function(e,i){var c=document.createElement('div');\nc.style.cssText='width:64px;height:64px;border-radius:12px;background:#1f2937;display:flex;align-items:center;justify-content:center;font-size:28px;cursor:pointer;transition:transform .2s;user-select:none';\nc.dataset.i=i;c.onclick=function(){if(lock||c.dataset.o)return;c.textContent=e;c.dataset.o=1;op.push(c);\nif(op.length==2){mv++;document.getElementById('m').textContent=mv;lock=true;var a=op[0],bb=op[1];\nsetTimeout(function(){if(a.textContent==bb.textContent){a.style.background='#065f46';bb.style.background='#065f46';\nif(document.querySelectorAll('[data-o]').length==16)document.getElementById('w').style.display='inline';}\nelse{a.textContent='';bb.textContent='';delete a.dataset.o;delete bb.dataset.o;}op=[];lock=false;},600);}};\nb.appendChild(c);});\n</script>\n"}