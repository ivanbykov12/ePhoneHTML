{
  "id": "notes_system",
  "name": "Заметки",
  "icon": "material:note",
  "color": "from-yellow-300 to-yellow-500",
  "version": "2.0.0",
  "author": "ePhone System",
  "description": "Заметки",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "v2.0 - Исправлены let и prompt()",
  "code": "<div class=\"notes-app\"><h1><span class=\"material-icons\">note</span> Заметки</h1><button onclick=\"showCreateModal()\" class=\"new-btn\"><span class=\"material-icons\">add</span> Новая заметка</button><div id=\"notesList\" class=\"notes-list\"></div><div id=\"modal\" class=\"modal hidden\"><div class=\"modal-content\"><h3 id=\"modalTitle\">Новая заметка</h3><input type=\"text\" id=\"noteTitleInput\" placeholder=\"Заголовок\" class=\"modal-input\"><textarea id=\"noteContentInput\" placeholder=\"Содержание\" class=\"modal-textarea\"></textarea><div class=\"modal-buttons\"><button onclick=\"closeModal()\" class=\"modal-btn cancel\">Отмена</button><button onclick=\"saveNote()\" class=\"modal-btn save\">Сохранить</button></div></div></div></div><style>.notes-app{padding:20px}.notes-app h1{font-size:24px;margin-bottom:20px;display:flex;align-items:center;gap:8px}.new-btn{width:100%;padding:12px;background:linear-gradient(135deg,#ffd700,#ffb700);color:black;border:none;border-radius:12px;font-size:16px;font-weight:bold;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:20px}.notes-list{display:flex;flex-direction:column;gap:10px}.note-item{background:rgba(128,128,128,0.2);padding:15px;border-radius:12px;cursor:pointer}.note-item:hover{background:rgba(128,128,128,0.3)}.note-title{font-size:16px;font-weight:600;margin-bottom:5px}.note-preview{font-size:14px;opacity:0.7}.note-date{font-size:12px;opacity:0.5;margin-top:5px}.modal{position:fixed;inset:0;background:rgba(0,0,0,0.7);display:flex;align-items:center;justify-content:center;z-index:1000}.modal.hidden{display:none}.modal-content{background:#1c1c1e;border-radius:16px;padding:20px;width:300px;color:white}.modal-content h3{margin-bottom:15px}.modal-input,.modal-textarea{width:100%;padding:10px;background:rgba(128,128,128,0.3);border:none;border-radius:8px;color:white;margin-bottom:10px;font-size:14px}.modal-textarea{height:100px;resize:none}.modal-buttons{display:flex;gap:10px;justify-content:flex-end}.modal-btn{padding:8px 20px;border:none;border-radius:8px;font-weight:bold;cursor:pointer}.modal-btn.cancel{background:rgba(128,128,128,0.3);color:white}.modal-btn.save{background:#007aff;color:white}</style><script>var settings=ePhone.getSettings();document.querySelector('.notes-app').style.color=settings.darkMode?'white':'black';var notes=ePhone.load('notes')||[{id:1,title:'Добро пожаловать!',content:'Это ваша первая заметка',date:new Date().toLocaleDateString('ru-RU')}];var editingId=null;function showModal(){document.getElementById('modal').classList.remove('hidden')}function closeModal(){document.getElementById('modal').classList.add('hidden');editingId=null;document.getElementById('noteTitleInput').value='';document.getElementById('noteContentInput').value=''}function showCreateModal(){editingId=null;document.getElementById('modalTitle').textContent='Новая заметка';document.getElementById('noteTitleInput').value='';document.getElementById('noteContentInput').value='';showModal()}function showEditModal(id){var note=notes.find(function(n){return n.id===id});if(!note)return;editingId=id;document.getElementById('modalTitle').textContent='Редактировать';document.getElementById('noteTitleInput').value=note.title;document.getElementById('noteContentInput').value=note.content;showModal()}function saveNote(){var title=document.getElementById('noteTitleInput').value.trim();var content=document.getElementById('noteContentInput').value.trim();if(!title)return;if(editingId){var note=notes.find(function(n){return n.id===editingId});if(note){note.title=title;note.content=content}}else{notes.unshift({id:Date.now(),title:title,content:content,date:new Date().toLocaleDateString('ru-RU')})}saveNotes();loadNotes();closeModal()}function saveNotes(){ePhone.save('notes',notes)}function loadNotes(){var list=document.getElementById('notesList');list.innerHTML=notes.map(function(note){return '<div class=\"note-item\" onclick=\"showEditModal('+note.id+')\"><div class=\"note-title\">'+note.title+'</div><div class=\"note-preview\">'+note.content.substring(0,50)+'...</div><div class=\"note-date\">'+note.date+'</div></div>'}).join('')}loadNotes();</script>"
}
