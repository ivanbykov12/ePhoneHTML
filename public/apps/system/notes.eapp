{
  "id": "notes_system",
  "name": "Заметки",
  "icon": "material:note",
  "color": "from-yellow-300 to-yellow-500",
  "version": "3.0.0",
  "author": "ePhone System",
  "description": "Заметки с новым дизайном",
  "supportedModels": ["iphone8", "iphonex", "iphone14", "epad101"],
  "isSystem": true,
  "eappVersion": "1.1",
  "code": "<div class=\"app\"><div class=\"header\"><span class=\"material-icons\">note</span><h1>Заметки</h1><button onclick=\"showCreateModal()\" class=\"add-btn\"><span class=\"material-icons\">add</span></button></div><div id=\"notesList\" class=\"notes-list\"></div><div id=\"modal\" class=\"modal hidden\"><div class=\"modal-content\"><h3 id=\"modalTitle\">Новая заметка</h3><input type=\"text\" id=\"noteTitleInput\" placeholder=\"Заголовок\" class=\"modal-input\"><textarea id=\"noteContentInput\" placeholder=\"Содержание\" class=\"modal-textarea\"></textarea><div class=\"modal-buttons\"><button onclick=\"closeModal()\" class=\"modal-btn cancel\">Отмена</button><button onclick=\"saveNote()\" class=\"modal-btn save\">Сохранить</button></div></div></div></div><style>.app{padding:20px;height:100%;display:flex;flex-direction:column;background:linear-gradient(135deg,#0a0a0a 0%,#1a1a2e 100%);color:white}.header{display:flex;align-items:center;gap:8px;margin-bottom:20px}.header h1{font-size:24px;font-weight:600;flex:1}.add-btn{width:40px;height:40px;background:linear-gradient(135deg,#ffd700,#ffb700);border:none;border-radius:50%;color:black;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 15px rgba(255,183,0,0.3);transition:all 0.2s}.add-btn:active{transform:scale(0.9)}.notes-list{display:flex;flex-direction:column;gap:10px;flex:1;overflow-y:auto}.note-item{background:rgba(255,255,255,0.06);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);padding:15px;border-radius:14px;cursor:pointer;transition:all 0.2s}.note-item:active{transform:scale(0.98);background:rgba(255,255,255,0.1)}.note-title{font-size:16px;font-weight:600;margin-bottom:5px}.note-preview{font-size:14px;opacity:0.6;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.note-date{font-size:12px;opacity:0.4;margin-top:5px}.modal{position:fixed;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:center;z-index:1000}.modal.hidden{display:none}.modal-content{background:rgba(30,30,40,0.95);backdrop-filter:blur(40px);border:1px solid rgba(255,255,255,0.1);border-radius:20px;padding:25px;width:320px;animation:fadeIn 0.3s ease}@keyframes fadeIn{from{opacity:0;transform:scale(0.9)}to{opacity:1;transform:scale(1)}}.modal-content h3{margin-bottom:15px;font-size:18px;font-weight:600}.modal-input,.modal-textarea{width:100%;padding:12px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:10px;color:white;margin-bottom:10px;font-size:14px;outline:none;transition:all 0.2s}.modal-input:focus,.modal-textarea:focus{border-color:rgba(255,215,0,0.5);background:rgba(255,255,255,0.08)}.modal-textarea{height:120px;resize:none;font-family:inherit}.modal-buttons{display:flex;gap:10px;justify-content:flex-end;margin-top:10px}.modal-btn{padding:10px 24px;border:none;border-radius:12px;font-weight:600;cursor:pointer;transition:all 0.2s}.modal-btn.cancel{background:rgba(255,255,255,0.08);color:white}.modal-btn.save{background:linear-gradient(135deg,#ffd700,#ffb700);color:black;box-shadow:0 4px 15px rgba(255,183,0,0.3)}.modal-btn:active{transform:scale(0.95)}</style><script>var s=ePhone.getSettings();var notes=ePhone.load('notes')||[{id:1,title:'Добро пожаловать!',content:'Это ваша первая заметка',date:new Date().toLocaleDateString('ru-RU')}];var editingId=null;function showModal(){document.getElementById('modal').classList.remove('hidden')}function closeModal(){document.getElementById('modal').classList.add('hidden');editingId=null;document.getElementById('noteTitleInput').value='';document.getElementById('noteContentInput').value=''}function showCreateModal(){editingId=null;document.getElementById('modalTitle').textContent='Новая заметка';document.getElementById('noteTitleInput').value='';document.getElementById('noteContentInput').value='';showModal()}function showEditModal(id){var note=notes.find(function(n){return n.id===id});if(!note)return;editingId=id;document.getElementById('modalTitle').textContent='Редактировать';document.getElementById('noteTitleInput').value=note.title;document.getElementById('noteContentInput').value=note.content;showModal()}function saveNote(){var title=document.getElementById('noteTitleInput').value.trim();var content=document.getElementById('noteContentInput').value.trim();if(!title)return;if(editingId){var note=notes.find(function(n){return n.id===editingId});if(note){note.title=title;note.content=content}}else{notes.unshift({id:Date.now(),title:title,content:content,date:new Date().toLocaleDateString('ru-RU')})}saveNotes();loadNotes();closeModal()}function saveNotes(){ePhone.save('notes',notes)}function loadNotes(){var list=document.getElementById('notesList');list.innerHTML=notes.map(function(note){return '<div class=\"note-item\" onclick=\"showEditModal('+note.id+')\"><div class=\"note-title\">'+note.title+'</div><div class=\"note-preview\">'+note.content.substring(0,50)+'...</div><div class=\"note-date\">'+note.date+'</div></div>'}).join('')}loadNotes();</script>"
}
