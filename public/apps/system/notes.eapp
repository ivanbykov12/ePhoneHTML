{
  "id": "notes_system",
  "name": "Заметки",
  "icon": "material:note",
  "color": "from-yellow-300 to-yellow-500",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Заметки",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "Системное приложение",
  "code": "<!--\n⚠️ СИСТЕМНОЕ ПРИЛОЖЕНИЕ - НЕ УДАЛЯТЬ:\n- localStorage для хранения заметок\n- Функции: loadNotes(), saveNotes(), createNote(), deleteNote()\n- ePhone.save('notes') / ePhone.load('notes') - сохранение\n-->\n<div class=\"notes-app\">\n  <h1><span class=\"material-icons\">note</span> Заметки</h1>\n  <button onclick=\"createNote()\" class=\"new-btn\"><span class=\"material-icons\">add</span> Новая заметка</button>\n  <div id=\"notesList\" class=\"notes-list\"></div>\n</div>\n\n<style>\n.notes-app { padding: 20px; }\n.notes-app h1 { font-size: 24px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }\n.new-btn { width: 100%; padding: 12px; background: linear-gradient(135deg, #ffd700, #ffb700); color: black; border: none; border-radius: 12px; font-size: 16px; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 20px; }\n.notes-list { display: flex; flex-direction: column; gap: 10px; }\n.note-item { background: rgba(128,128,128,0.2); padding: 15px; border-radius: 12px; cursor: pointer; }\n.note-item:hover { background: rgba(128,128,128,0.3); }\n.note-title { font-size: 16px; font-weight: 600; margin-bottom: 5px; }\n.note-preview { font-size: 14px; opacity: 0.7; }\n.note-date { font-size: 12px; opacity: 0.5; margin-top: 5px; }\n</style>\n\n<script>\n// ⚠️ НЕ УДАЛЯТЬ: Инициализация\nconst settings = ePhone.getSettings();\ndocument.querySelector('.notes-app').style.color = settings.darkMode ? 'white' : 'black';\n\n// ⚠️ НЕ УДАЛЯТЬ: Загрузка заметок\nlet notes = ePhone.load('notes') || [\n  { id: 1, title: 'Добро пожаловать!', content: 'Это ваша первая заметка', date: new Date().toLocaleDateString('ru-RU') }\n];\n\n// ⚠️ НЕ УДАЛЯТЬ: Функции управления заметками\nfunction loadNotes() {\n  const list = document.getElementById('notesList');\n  list.innerHTML = notes.map(note => `\n    <div class=\"note-item\" onclick=\"editNote(${note.id})\">\n      <div class=\"note-title\">${note.title}</div>\n      <div class=\"note-preview\">${note.content.substring(0, 50)}...</div>\n      <div class=\"note-date\">${note.date}</div>\n    </div>\n  `).join('');\n}\n\nfunction saveNotes() {\n  ePhone.save('notes', notes);\n}\n\nfunction createNote() {\n  const title = prompt('Заголовок:');\n  if (!title) return;\n  const content = prompt('Содержание:') || '';\n  notes.unshift({\n    id: Date.now(),\n    title: title,\n    content: content,\n    date: new Date().toLocaleDateString('ru-RU')\n  });\n  saveNotes();\n  loadNotes();\n}\n\nfunction editNote(id) {\n  const note = notes.find(n => n.id === id);\n  if (!note) return;\n  const newContent = prompt('Редактировать:', note.content);\n  if (newContent !== null) {\n    note.content = newContent;\n    saveNotes();\n    loadNotes();\n  }\n}\n\nloadNotes();\n</script>"
}
