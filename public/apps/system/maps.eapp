{
  "id": "maps_system",
  "name": "Карты",
  "icon": "material:map",
  "color": "from-green-500 to-green-700",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Карты",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "Системное приложение",
  "code": "<!--\n⚠️ СИСТЕМНОЕ ПРИЛОЖЕНИЕ - НЕ УДАЛЯТЬ:\n- Карта с местоположениями\n- Функции: loadPlaces(), selectPlace()\n- Массив places с демо-данными\n-->\n<div class=\"maps-app\">\n  <div class=\"search-bar\">\n    <span class=\"material-icons\">search</span>\n    <input type=\"text\" placeholder=\"Поиск мест\">\n  </div>\n  <div class=\"map-container\">\n    <div class=\"map-placeholder\">\n      <span class=\"material-icons\" style=\"font-size: 64px; opacity: 0.3;\">map</span>\n      <p>Карта</p>\n    </div>\n    <div class=\"user-location\"></div>\n  </div>\n  <div class=\"places-list\" id=\"placesList\"></div>\n</div>\n\n<style>\n.maps-app { padding: 20px; display: flex; flex-direction: column; height: 100%; }\n.search-bar { display: flex; align-items: center; gap: 8px; padding: 10px; background: rgba(128,128,128,0.2); border-radius: 12px; margin-bottom: 15px; }\n.search-bar input { flex: 1; background: none; border: none; outline: none; font-size: 14px; color: inherit; }\n.map-container { position: relative; height: 200px; background: linear-gradient(135deg, #1a472a, #2d5016); border-radius: 12px; margin-bottom: 15px; overflow: hidden; }\n.map-placeholder { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: white; }\n.user-location { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 20px; height: 20px; background: #007aff; border-radius: 50%; border: 3px solid white; box-shadow: 0 0 10px rgba(0,122,255,0.5); }\n.places-list { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; }\n.place-item { display: flex; align-items: center; gap: 12px; padding: 10px; background: rgba(128,128,128,0.2); border-radius: 8px; cursor: pointer; }\n.place-item:hover { background: rgba(128,128,128,0.3); }\n.place-icon { font-size: 24px; }\n.place-info { flex: 1; }\n.place-name { font-size: 14px; font-weight: 500; }\n.place-details { font-size: 12px; opacity: 0.7; }\n</style>\n\n<script>\n// ⚠️ НЕ УДАЛЯТЬ: Инициализация\nconst settings = ePhone.getSettings();\ndocument.querySelector('.maps-app').style.color = settings.darkMode ? 'white' : 'white';\n\n// ⚠️ НЕ УДАЛЯТЬ: Список мест\nconst places = [\n  { name: 'Красная площадь', type: 'Достопримечательность', distance: '2.3 км', emoji: '🏛', rating: 4.9 },\n  { name: 'Парк Горького', type: 'Парк', distance: '4.1 км', emoji: '🌳', rating: 4.7 },\n  { name: 'ТЦ Авиапарк', type: 'Торговый центр', distance: '5.8 км', emoji: '🛍', rating: 4.3 },\n  { name: 'Кафе Пушкин', type: 'Ресторан', distance: '1.2 км', emoji: '🍽', rating: 4.8 },\n  { name: 'Москва-Сити', type: 'Бизнес-центр', distance: '7.5 км', emoji: '🏢', rating: 4.6 }\n];\n\n// ⚠️ НЕ УДАЛЯТЬ: Функции отображения\nfunction loadPlaces() {\n  const list = document.getElementById('placesList');\n  list.innerHTML = places.map(place => `\n    <div class=\"place-item\" onclick=\"selectPlace('${place.name}')\">\n      <div class=\"place-icon\">${place.emoji}</div>\n      <div class=\"place-info\">\n        <div class=\"place-name\">${place.name}</div>\n        <div class=\"place-details\">${place.type} • ${place.distance} • ★ ${place.rating}</div>\n      </div>\n    </div>\n  `).join('');\n}\n\nfunction selectPlace(name) {\n  alert(`${name}\\n\\n(В полной версии здесь будет маршрут)`);\n}\n\nloadPlaces();\n</script>"
}
