{
  "id": "maps_system",
  "name": "Карты",
  "icon": "material:map",
  "color": "from-green-500 to-green-700",
  "version": "2.0.0",
  "author": "ePhone System",
  "description": "Карты",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "v2.0 - Исправлены alert() и let",
  "code": "<div class=\"maps-app\"><div class=\"search-bar\"><span class=\"material-icons\">search</span><input type=\"text\" placeholder=\"Поиск мест\"></div><div class=\"map-container\"><div class=\"map-placeholder\"><span class=\"material-icons\" style=\"font-size:64px;opacity:0.3;\">map</span><p>Карта</p></div><div class=\"user-location\"></div></div><div class=\"places-list\" id=\"placesList\"></div><div id=\"modal\" class=\"modal hidden\"><div class=\"modal-content\"><h3 id=\"modalTitle\"></h3><p id=\"modalText\"></p><button onclick=\"closeModal()\" class=\"modal-btn\">OK</button></div></div></div><style>.maps-app{padding:20px;display:flex;flex-direction:column;height:100%}.search-bar{display:flex;align-items:center;gap:8px;padding:10px;background:rgba(128,128,128,0.2);border-radius:12px;margin-bottom:15px}.search-bar input{flex:1;background:none;border:none;outline:none;font-size:14px;color:inherit}.map-container{position:relative;height:200px;background:linear-gradient(135deg,#1a472a,#2d5016);border-radius:12px;margin-bottom:15px;overflow:hidden}.map-placeholder{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:white}.user-location{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;background:#007aff;border-radius:50%;border:3px solid white;box-shadow:0 0 10px rgba(0,122,255,0.5)}.places-list{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:8px}.place-item{display:flex;align-items:center;gap:12px;padding:10px;background:rgba(128,128,128,0.2);border-radius:8px;cursor:pointer}.place-item:hover{background:rgba(128,128,128,0.3)}.place-icon{font-size:24px}.place-info{flex:1}.place-name{font-size:14px;font-weight:500}.place-details{font-size:12px;opacity:0.7}.modal{position:fixed;inset:0;background:rgba(0,0,0,0.7);display:flex;align-items:center;justify-content:center;z-index:1000}.modal.hidden{display:none}.modal-content{background:#1c1c1e;border-radius:16px;padding:20px;max-width:300px;text-align:center;color:white}.modal-content h3{margin-bottom:10px}.modal-content p{opacity:0.7;margin-bottom:15px}.modal-btn{padding:10px 30px;background:#007aff;color:white;border:none;border-radius:10px;font-weight:bold;cursor:pointer}</style><script>var settings=ePhone.getSettings();document.querySelector('.maps-app').style.color=settings.darkMode?'white':'white';var places=[{name:'Красная площадь',type:'Достопримечательность',distance:'2.3 км',emoji:'🏛',rating:4.9},{name:'Парк Горького',type:'Парк',distance:'4.1 км',emoji:'🌳',rating:4.7},{name:'ТЦ Авиапарк',type:'Торговый центр',distance:'5.8 км',emoji:'🛍',rating:4.3},{name:'Кафе Пушкин',type:'Ресторан',distance:'1.2 км',emoji:'🍽',rating:4.8},{name:'Москва-Сити',type:'Бизнес-центр',distance:'7.5 км',emoji:'🏢',rating:4.6}];function showModal(title,text){document.getElementById('modalTitle').textContent=title;document.getElementById('modalText').textContent=text;document.getElementById('modal').classList.remove('hidden')}function closeModal(){document.getElementById('modal').classList.add('hidden')}function loadPlaces(){var list=document.getElementById('placesList');list.innerHTML=places.map(function(place){return '<div class=\"place-item\" onclick=\"selectPlace(\\''+place.name+'\\')\"><div class=\"place-icon\">'+place.emoji+'</div><div class=\"place-info\"><div class=\"place-name\">'+place.name+'</div><div class=\"place-details\">'+place.type+' • '+place.distance+' • ★ '+place.rating+'</div></div></div>'}).join('')}function selectPlace(name){showModal(name,'В полной версии здесь будет маршрут')}loadPlaces();</script>"
}
