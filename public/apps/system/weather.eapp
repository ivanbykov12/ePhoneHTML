{
  "id": "weather_system",
  "name": "Погода",
  "icon": "material:cloud",
  "color": "from-blue-400 to-cyan-400",
  "version": "2.0.0",
  "author": "ePhone System",
  "description": "Погода с реальными данными Open-Meteo",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "eappVersion": "1.1",
  "changelog": "v2.0 - Реальные данные погоды через Open-Meteo API",
  "code": "<div class=\"weather-app\" id=\"weatherApp\"><div class=\"loading\" id=\"loading\"><div class=\"spinner\"></div><p>Загрузка погоды...</p></div><div class=\"content hidden\" id=\"content\"><div class=\"city-selector\" id=\"citySelector\"></div><div class=\"current-weather\"><div class=\"city-name\" id=\"cityName\"></div><div class=\"temp\" id=\"temp\"></div><div class=\"condition\" id=\"condition\"></div><div class=\"feels-like\" id=\"feelsLike\"></div></div><div class=\"details-grid\"><div class=\"detail-card\"><span class=\"material-icons\">air</span><div><div class=\"detail-label\">Ветер</div><div class=\"detail-value\" id=\"wind\"></div></div></div><div class=\"detail-card\"><span class=\"material-icons\">water_drop</span><div><div class=\"detail-label\">Влажность</div><div class=\"detail-value\" id=\"humidity\"></div></div></div><div class=\"detail-card\"><span class=\"material-icons\">thermostat</span><div><div class=\"detail-label\">Давление</div><div class=\"detail-value\" id=\"pressure\"></div></div></div><div class=\"detail-card\"><span class=\"material-icons\">visibility</span><div><div class=\"detail-label\">Облачность</div><div class=\"detail-value\" id=\"cloudCover\"></div></div></div></div><div class=\"hourly-section\"><div class=\"section-title\">Почасовой прогноз</div><div class=\"hourly-scroll\" id=\"hourlyForecast\"></div></div><div class=\"daily-section\"><div class=\"section-title\">Прогноз на 7 дней</div><div class=\"daily-list\" id=\"dailyForecast\"></div></div></div></div><style>.weather-app{padding:15px;overflow-y:auto;height:100%;background:linear-gradient(to bottom,#1e3a5f,#0f2027)}.loading{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:white}.spinner{width:40px;height:40px;border:3px solid rgba(255,255,255,0.3);border-top-color:white;border-radius:50%;animation:spin 1s linear infinite;margin-bottom:15px}@keyframes spin{to{transform:rotate(360deg)}}.hidden{display:none!important}.city-selector{display:flex;gap:8px;overflow-x:auto;margin-bottom:20px;padding-bottom:5px}.city-btn{padding:6px 14px;background:rgba(255,255,255,0.15);border:none;border-radius:20px;color:white;cursor:pointer;white-space:nowrap;font-size:12px;transition:all 0.2s}.city-btn.active{background:rgba(255,255,255,0.35);font-weight:600}.current-weather{text-align:center;margin-bottom:25px}.city-name{font-size:24px;font-weight:300;margin-bottom:5px}.temp{font-size:80px;font-weight:100;line-height:1;margin:10px 0}.condition{font-size:18px;opacity:0.8;margin-bottom:5px}.feels-like{font-size:14px;opacity:0.6}.details-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px}.detail-card{background:rgba(255,255,255,0.1);backdrop-filter:blur(10px);border-radius:16px;padding:12px;display:flex;align-items:center;gap:10px;border:1px solid rgba(255,255,255,0.1)}.detail-card .material-icons{font-size:24px;opacity:0.7}.detail-label{font-size:11px;opacity:0.6}.detail-value{font-size:16px;font-weight:300}.section-title{font-size:12px;opacity:0.7;margin-bottom:10px;text-transform:uppercase;letter-spacing:1px}.hourly-section{background:rgba(255,255,255,0.1);backdrop-filter:blur(10px);border-radius:16px;padding:15px;margin-bottom:15px;border:1px solid rgba(255,255,255,0.1)}.hourly-scroll{display:flex;gap:15px;overflow-x:auto;padding-bottom:5px}.hour-item{display:flex;flex-direction:column;align-items:center;min-width:45px}.hour-item .time{font-size:11px;opacity:0.7}.hour-item .icon{font-size:20px;margin:5px 0}.hour-item .temp{font-size:14px;font-weight:500}.daily-section{background:rgba(255,255,255,0.1);backdrop-filter:blur(10px);border-radius:16px;padding:15px;border:1px solid rgba(255,255,255,0.1)}.day-item{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.1)}.day-item:last-child{border-bottom:none}.day-item .day{width:35px;font-size:14px;font-weight:500}.day-item .icon{font-size:20px}.day-item .temps{display:flex;gap:8px;font-size:14px}.day-item .temp-min{opacity:0.5}.day-item .temp-max{font-weight:500}</style><script>var cities=[{name:'Москва',lat:55.75,lon:37.62},{name:'Санкт-Петербург',lat:59.93,lon:30.32},{name:'Нью-Йорк',lat:40.71,lon:-74.01},{name:'Лондон',lat:51.51,lon:-0.13},{name:'Токио',lat:35.68,lon:139.69},{name:'Дубай',lat:25.20,lon:55.27}];var currentCity=cities[0];var weatherData=null;var weatherCodes={0:{desc:'Ясно',icon:'☀️'},1:{desc:'Преим. ясно',icon:'🌤'},2:{desc:'Переменная обл.',icon:'⛅'},3:{desc:'Облачно',icon:'☁️'},45:{desc:'Туман',icon:'🌫'},48:{desc:'Изморозь',icon:'🌫'},51:{desc:'Лёгкая морось',icon:'🌦'},53:{desc:'Морось',icon:'🌦'},55:{desc:'Сильная морось',icon:'🌧'},61:{desc:'Лёгкий дождь',icon:'🌦'},63:{desc:'Дождь',icon:'🌧'},65:{desc:'Сильный дождь',icon:'🌧'},71:{desc:'Лёгкий снег',icon:'🌨'},73:{desc:'Снег',icon:'🌨'},75:{desc:'Сильный снег',icon:'❄️'},80:{desc:'Ливень',icon:'🌧'},81:{desc:'Сильный ливень',icon:'🌧'},82:{desc:'Очень сильный ливень',icon:'⛈'},95:{desc:'Гроза',icon:'⛈'},96:{desc:'Гроза с градом',icon:'⛈'},99:{desc:'Сильная гроза',icon:'⛈'}};function getWeatherInfo(code){return weatherCodes[code]||{desc:'Неизвестно',icon:'🌡'}}async function fetchWeather(city){document.getElementById('loading').classList.remove('hidden');document.getElementById('content').classList.add('hidden');try{var url='https://api.open-meteo.com/v1/forecast?latitude='+city.lat+'&longitude='+city.lon+'&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m,surface_pressure,cloud_cover&hourly=temperature_2m,weather_code&daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=auto&forecast_days=7';var response=await fetch(url);var data=await response.json();weatherData=data;renderWeather(city);document.getElementById('loading').classList.add('hidden');document.getElementById('content').classList.remove('hidden')}catch(e){document.getElementById('loading').innerHTML='<p style=\"color:#ff6b6b;\">Ошибка загрузки</p><button onclick=\"fetchWeather(currentCity)\" style=\"margin-top:10px;padding:8px 16px;background:rgba(255,255,255,0.2);border:none;border-radius:20px;color:white;cursor:pointer;\">Повторить</button>'}}function renderWeather(city){var current=weatherData.current;var info=getWeatherInfo(current.weather_code);document.getElementById('cityName').textContent=city.name;document.getElementById('temp').textContent=Math.round(current.temperature_2m)+'°';document.getElementById('condition').textContent=info.icon+' '+info.desc;document.getElementById('feelsLike').textContent='Ощущается как '+Math.round(current.apparent_temperature)+'°';document.getElementById('wind').textContent=Math.round(current.wind_speed_10m)+' км/ч';document.getElementById('humidity').textContent=current.relative_humidity_2m+'%';document.getElementById('pressure').textContent=Math.round(current.surface_pressure)+' гПа';document.getElementById('cloudCover').textContent=current.cloud_cover+'%';var hourlyHtml='';var now=new Date().getHours();for(var i=now;i<now+12&&i<weatherData.hourly.time.length;i++){var time=new Date(weatherData.hourly.time[i]);var hInfo=getWeatherInfo(weatherData.hourly.weather_code[i]);hourlyHtml+='<div class=\"hour-item\"><div class=\"time\">'+time.getHours()+':00</div><div class=\"icon\">'+hInfo.icon+'</div><div class=\"temp\">'+Math.round(weatherData.hourly.temperature_2m[i])+'°</div></div>'}document.getElementById('hourlyForecast').innerHTML=hourlyHtml;var days=['Вс','Пн','Вт','Ср','Чт','Пт','Сб'];var dailyHtml='';for(var d=0;d<weatherData.daily.time.length;d++){var date=new Date(weatherData.daily.time[d]);var dInfo=getWeatherInfo(weatherData.daily.weather_code[d]);dailyHtml+='<div class=\"day-item\"><div class=\"day\">'+days[date.getDay()]+'</div><div class=\"icon\">'+dInfo.icon+'</div><div class=\"temps\"><span class=\"temp-min\">'+Math.round(weatherData.daily.temperature_2m_min[d])+'°</span><span class=\"temp-max\">'+Math.round(weatherData.daily.temperature_2m_max[d])+'°</span></div></div>'}document.getElementById('dailyForecast').innerHTML=dailyHtml;var selectorHtml='';cities.forEach(function(c){selectorHtml+='<button class=\"city-btn'+(c.name===city.name?' active':'')+'\" onclick=\"selectCity(\\''+c.name+'\\')\">'+c.name+'</button>'});document.getElementById('citySelector').innerHTML=selectorHtml}function selectCity(name){var city=cities.find(function(c){return c.name===name});if(city){currentCity=city;fetchWeather(city)}}var settings=ePhone.getSettings();document.getElementById('weatherApp').style.color='white';fetchWeather(currentCity);</script>"
}
