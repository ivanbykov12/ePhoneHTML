{
  "id": "weather_system",
  "name": "Погода",
  "icon": "material:cloud",
  "color": "from-blue-400 to-cyan-400",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Прогноз погоды",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "code": "<div class=\"weather-app\">\n  <div class=\"city-selector\">\n    <button onclick=\"setCity('Москва')\" class=\"city-btn active\" id=\"city-Москва\">Москва</button>\n    <button onclick=\"setCity('Нью-Йорк')\" class=\"city-btn\" id=\"city-Нью-Йорк\">Нью-Йорк</button>\n    <button onclick=\"setCity('Лондон')\" class=\"city-btn\" id=\"city-Лондон\">Лондон</button>\n    <button onclick=\"setCity('Токио')\" class=\"city-btn\" id=\"city-Токио\">Токио</button>\n    <button onclick=\"setCity('Дубай')\" class=\"city-btn\" id=\"city-Дубай\">Дубай</button>\n  </div>\n  <div class=\"current-weather\">\n    <div class=\"city-name\" id=\"cityName\">Москва</div>\n    <div class=\"temp\" id=\"temp\">18°</div>\n    <div class=\"condition\" id=\"condition\">Облачно</div>\n    <div class=\"high-low\" id=\"highLow\">Макс: 21° Мин: 14°</div>\n  </div>\n  <div class=\"hourly\">\n    <div class=\"section-title\">Почасовой прогноз</div>\n    <div class=\"hourly-scroll\" id=\"hourlyForecast\"></div>\n  </div>\n  <div class=\"weekly\">\n    <div class=\"section-title\">Прогноз на 7 дней</div>\n    <div id=\"weeklyForecast\"></div>\n  </div>\n  <div class=\"details\">\n    <div class=\"detail-item\">\n      <span class=\"material-icons\">air</span>\n      <div><div class=\"detail-label\">Ветер</div><div class=\"detail-value\" id=\"wind\">12 км/ч</div></div>\n    </div>\n    <div class=\"detail-item\">\n      <span class=\"material-icons\">water_drop</span>\n      <div><div class=\"detail-label\">Влажность</div><div class=\"detail-value\" id=\"humidity\">65%</div></div>\n    </div>\n  </div>\n</div>\n\n<style>\n.weather-app {\n  padding: 15px;\n  overflow-y: auto;\n  height: 100%;\n}\n.city-selector {\n  display: flex;\n  gap: 8px;\n  overflow-x: auto;\n  margin-bottom: 20px;\n  padding-bottom: 5px;\n}\n.city-btn {\n  padding: 6px 14px;\n  border-radius: 20px;\n  border: none;\n  background: rgba(255,255,255,0.2);\n  color: white;\n  cursor: pointer;\n  white-space: nowrap;\n  font-size: 12px;\n}\n.city-btn.active {\n  background: rgba(255,255,255,0.4);\n}\n.current-weather {\n  text-align: center;\n  margin-bottom: 25px;\n}\n.city-name {\n  font-size: 22px;\n  margin-bottom: 5px;\n}\n.temp {\n  font-size: 72px;\n  font-weight: 200;\n  line-height: 1;\n}\n.condition {\n  font-size: 18px;\n  opacity: 0.8;\n  margin: 5px 0;\n}\n.high-low {\n  font-size: 14px;\n  opacity: 0.6;\n}\n.section-title {\n  font-size: 12px;\n  opacity: 0.7;\n  margin-bottom: 10px;\n}\n.hourly {\n  background: rgba(255,255,255,0.1);\n  border-radius: 16px;\n  padding: 15px;\n  margin-bottom: 15px;\n}\n.hourly-scroll {\n  display: flex;\n  gap: 15px;\n  overflow-x: auto;\n}\n.hour-item {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  min-width: 40px;\n}\n.hour-item .time { font-size: 12px; opacity: 0.7; }\n.hour-item .icon { font-size: 18px; margin: 5px 0; }\n.hour-item .temp { font-size: 14px; font-weight: 500; }\n.weekly {\n  background: rgba(255,255,255,0.1);\n  border-radius: 16px;\n  padding: 15px;\n  margin-bottom: 15px;\n}\n.day-item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 8px 0;\n  border-bottom: 1px solid rgba(255,255,255,0.1);\n}\n.day-item:last-child { border-bottom: none; }\n.day-item .day { width: 30px; font-size: 14px; }\n.day-item .icon { font-size: 18px; }\n.day-item .bar { flex: 1; margin: 0 10px; height: 4px; background: linear-gradient(to right, #4fc3f7, #ff9800); border-radius: 2px; }\n.day-item .temp { font-size: 14px; }\n.details {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 10px;\n}\n.detail-item {\n  background: rgba(255,255,255,0.1);\n  border-radius: 16px;\n  padding: 12px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n.detail-item .material-icons { font-size: 24px; opacity: 0.7; }\n.detail-label { font-size: 11px; opacity: 0.6; }\n.detail-value { font-size: 18px; font-weight: 300; }\n</style>\n\n<script>\nconst weatherData = {\n  'Москва': { temp: 18, condition: 'Облачно', icon: '⛅', humidity: 65, wind: 12, forecast: [15, 17, 19, 21, 18, 16, 14] },\n  'Нью-Йорк': { temp: 24, condition: 'Солнечно', icon: '☀️', humidity: 45, wind: 8, forecast: [22, 25, 27, 26, 24, 23, 21] },\n  'Лондон': { temp: 14, condition: 'Дождь', icon: '🌧', humidity: 80, wind: 18, forecast: [12, 13, 15, 14, 13, 11, 10] },\n  'Токио': { temp: 28, condition: 'Ясно', icon: '🌤', humidity: 55, wind: 6, forecast: [26, 29, 30, 28, 27, 25, 24] },\n  'Дубай': { temp: 38, condition: 'Жарко', icon: '☀️', humidity: 25, wind: 15, forecast: [36, 39, 40, 38, 37, 35, 34] }\n};\n\nlet currentCity = 'Москва';\nconst days = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];\n\nfunction setCity(city) {\n  currentCity = city;\n  document.querySelectorAll('.city-btn').forEach(b => b.classList.remove('active'));\n  document.getElementById('city-' + city).classList.add('active');\n  updateWeather();\n}\n\nfunction updateWeather() {\n  const data = weatherData[currentCity];\n  document.getElementById('cityName').textContent = currentCity;\n  document.getElementById('temp').textContent = data.temp + '°';\n  document.getElementById('condition').textContent = data.condition;\n  document.getElementById('highLow').textContent = `Макс: ${data.temp + 3}° Мин: ${data.temp - 4}°`;\n  document.getElementById('wind').textContent = data.wind + ' км/ч';\n  document.getElementById('humidity').textContent = data.humidity + '%';\n  \n  const hours = ['Сейчас', '13:00', '14:00', '15:00', '16:00', '17:00'];\n  const hourlyHtml = hours.map((h, i) => `\n    <div class=\"hour-item\">\n      <div class=\"time\">${h}</div>\n      <div class=\"icon\">${i % 2 === 0 ? '⛅' : '☀️'}</div>\n      <div class=\"temp\">${data.forecast[i] || data.temp}°</div>\n    </div>\n  `).join('');\n  document.getElementById('hourlyForecast').innerHTML = hourlyHtml;\n  \n  const weeklyHtml = days.map((day, i) => `\n    <div class=\"day-item\">\n      <div class=\"day\">${day}</div>\n      <div class=\"icon\">${['⛅', '☀️', '🌧', '⛅', '☀️', '🌤', '⛅'][i]}</div>\n      <div class=\"bar\" style=\"width: ${50 + i * 5}%\"></div>\n      <div class=\"temp\">${data.forecast[i]}°</div>\n    </div>\n  `).join('');\n  document.getElementById('weeklyForecast').innerHTML = weeklyHtml;\n}\n\nupdateWeather();\n</script>"
}
