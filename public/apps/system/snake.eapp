{
  "id": "snake_system",
  "name": "Змейка",
  "icon": "material:catching_pokemon",
  "color": "from-green-400 to-green-600",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Классическая игра Змейка",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "Системное приложение - не рекомендуется менять логику",
  "code": "<div class=\"snake-game\">\n  <h1><span class=\"material-icons\">catching_pokemon</span> Змейка</h1>\n  <div class=\"stats\">\n    <span>Счёт: <span id=\"score\">0</span></span>\n    <span>Рекорд: <span id=\"highscore\">0</span></span>\n  </div>\n  <canvas id=\"gameCanvas\" width=\"320\" height=\"320\"></canvas>\n  <div class=\"controls\">\n    <button onclick=\"move('UP')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_upward</span></button>\n    <div class=\"ctrl-row\">\n      <button onclick=\"move('LEFT')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_back</span></button>\n      <button onclick=\"move('DOWN')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_downward</span></button>\n      <button onclick=\"move('RIGHT')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_forward</span></button>\n    </div>\n  </div>\n  <button onclick=\"startGame()\" class=\"start-btn\" id=\"startBtn\">Начать игру</button>\n</div>\n\n<style>\n.snake-game {\n  padding: 20px;\n  text-align: center;\n}\n.snake-game h1 {\n  font-size: 20px;\n  margin-bottom: 10px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n}\n.stats {\n  display: flex;\n  justify-content: space-around;\n  margin-bottom: 15px;\n  font-size: 14px;\n}\n#gameCanvas {\n  border: 2px solid currentColor;\n  border-radius: 8px;\n  margin-bottom: 15px;\n  max-width: 100%;\n}\n.controls {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 5px;\n  margin-bottom: 15px;\n}\n.ctrl-row {\n  display: flex;\n  gap: 5px;\n}\n.ctrl-btn {\n  width: 50px;\n  height: 50px;\n  border: none;\n  border-radius: 12px;\n  background: rgba(128,128,128,0.3);\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.ctrl-btn:active {\n  transform: scale(0.9);\n}\n.start-btn {\n  padding: 12px 32px;\n  background: linear-gradient(135deg, #34c759, #30d158);\n  color: white;\n  border: none;\n  border-radius: 25px;\n  font-size: 16px;\n  font-weight: bold;\n  cursor: pointer;\n}\n.start-btn:active {\n  transform: scale(0.95);\n}\n</style>\n\n<script>\nconst settings = ePhone.getSettings();\nconst container = document.querySelector('.snake-game');\ncontainer.style.color = settings.darkMode ? 'white' : 'black';\n\nconst canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\nconst gridSize = 20;\nconst tileCount = canvas.width / gridSize;\n\nlet snake = [{x: 10, y: 10}];\nlet food = {x: 15, y: 15};\nlet dx = 0, dy = 0;\nlet score = 0;\nlet highscore = ePhone.load('snake_highscore') || 0;\nlet gameRunning = false;\n\ndocument.getElementById('highscore').textContent = highscore;\n\nfunction startGame() {\n  snake = [{x: 10, y: 10}];\n  dx = 1; dy = 0;\n  score = 0;\n  document.getElementById('score').textContent = score;\n  gameRunning = true;\n  document.getElementById('startBtn').style.display = 'none';\n  gameLoop();\n}\n\nfunction move(dir) {\n  if (!gameRunning) return;\n  if (dir === 'UP' && dy !== 1) { dx = 0; dy = -1; }\n  if (dir === 'DOWN' && dy !== -1) { dx = 0; dy = 1; }\n  if (dir === 'LEFT' && dx !== 1) { dx = -1; dy = 0; }\n  if (dir === 'RIGHT' && dx !== -1) { dx = 1; dy = 0; }\n}\n\nfunction gameLoop() {\n  if (!gameRunning) return;\n  \n  setTimeout(() => {\n    const head = {x: snake[0].x + dx, y: snake[0].y + dy};\n    \n    if (head.x < 0 || head.x >= tileCount || head.y < 0 || head.y >= tileCount) {\n      gameOver();\n      return;\n    }\n    \n    if (snake.some(s => s.x === head.x && s.y === head.y)) {\n      gameOver();\n      return;\n    }\n    \n    snake.unshift(head);\n    \n    if (head.x === food.x && head.y === food.y) {\n      score += 10;\n      document.getElementById('score').textContent = score;\n      if (score > highscore) {\n        highscore = score;\n        document.getElementById('highscore').textContent = highscore;\n        ePhone.save('snake_highscore', highscore);\n      }\n      food = {\n        x: Math.floor(Math.random() * tileCount),\n        y: Math.floor(Math.random() * tileCount)\n      };\n    } else {\n      snake.pop();\n    }\n    \n    draw();\n    gameLoop();\n  }, 100);\n}\n\nfunction draw() {\n  ctx.fillStyle = settings.darkMode ? '#1a1a1a' : '#f0f0f0';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n  \n  ctx.fillStyle = '#34c759';\n  snake.forEach((s, i) => {\n    ctx.fillRect(s.x * gridSize, s.y * gridSize, gridSize - 2, gridSize - 2);\n  });\n  \n  ctx.fillStyle = '#ff3b30';\n  ctx.fillRect(food.x * gridSize, food.y * gridSize, gridSize - 2, gridSize - 2);\n}\n\nfunction gameOver() {\n  gameRunning = false;\n  document.getElementById('startBtn').style.display = 'block';\n  document.getElementById('startBtn').textContent = 'Играть снова';\n  ePhone.vibrate(200);\n}\n\ndraw();\n</script>"
}
