{
  "id": "snake_system",
  "name": "Змейка",
  "icon": "material:catching_pokemon",
  "color": "from-green-400 to-green-600",
  "version": "2.0.0",
  "author": "ePhone System",
  "description": "Классическая игра Змейка",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "v2.0 - Полный функционал с рекордами и ускорением",
  "code": "<div class=\"snake-game\"><h1><span class=\"material-icons\">catching_pokemon</span> Змейка</h1><div class=\"stats\"><span>Счёт: <span id=\"score\">0</span></span><span>Рекорд: <span id=\"highscore\">0</span></span></div><canvas id=\"gameCanvas\" width=\"320\" height=\"320\"></canvas><div class=\"controls\"><button onclick=\"move('UP')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_upward</span></button><div class=\"ctrl-row\"><button onclick=\"move('LEFT')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_back</span></button><button onclick=\"move('DOWN')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_downward</span></button><button onclick=\"move('RIGHT')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_forward</span></button></div></div><button onclick=\"startGame()\" class=\"start-btn\" id=\"startBtn\">Начать игру</button></div><style>.snake-game{padding:20px;text-align:center}.snake-game h1{font-size:20px;margin-bottom:10px;display:flex;align-items:center;justify-content:center;gap:8px}.stats{display:flex;justify-content:space-around;margin-bottom:15px;font-size:14px}#gameCanvas{border:2px solid currentColor;border-radius:8px;margin-bottom:15px;max-width:100%}.controls{display:flex;flex-direction:column;align-items:center;gap:5px;margin-bottom:15px}.ctrl-row{display:flex;gap:5px}.ctrl-btn{width:50px;height:50px;border:none;border-radius:12px;background:rgba(128,128,128,0.3);cursor:pointer;display:flex;align-items:center;justify-content:center}.ctrl-btn:active{transform:scale(0.9)}.start-btn{padding:12px 32px;background:linear-gradient(135deg,#34c759,#30d158);color:white;border:none;border-radius:25px;font-size:16px;font-weight:bold;cursor:pointer}.start-btn:active{transform:scale(0.95)}</style><script>var settings=ePhone.getSettings();var container=document.querySelector('.snake-game');container.style.color=settings.darkMode?'white':'black';var canvas=document.getElementById('gameCanvas');var ctx=canvas.getContext('2d');var gridSize=20;var tileCount=canvas.width/gridSize;var snake=[{x:10,y:10}];var food={x:15,y:15};var dx=0,dy=0;var score=0;var highscore=ePhone.load('snake_highscore')||0;var gameRunning=false;var gameSpeed=100;document.getElementById('highscore').textContent=highscore;function startGame(){snake=[{x:10,y:10}];dx=1;dy=0;score=0;gameSpeed=100;document.getElementById('score').textContent=score;gameRunning=true;document.getElementById('startBtn').style.display='none';generateFood();gameLoop()}function generateFood(){do{food={x:Math.floor(Math.random()*tileCount),y:Math.floor(Math.random()*tileCount)}}while(snake.some(function(s){return s.x===food.x&&s.y===food.y}))}function move(dir){if(!gameRunning)return;if(dir==='UP'&&dy!==1){dx=0;dy=-1}if(dir==='DOWN'&&dy!==-1){dx=0;dy=1}if(dir==='LEFT'&&dx!==1){dx=-1;dy=0}if(dir==='RIGHT'&&dx!==-1){dx=1;dy=0}}document.addEventListener('keydown',function(e){if(e.key==='ArrowUp')move('UP');if(e.key==='ArrowDown')move('DOWN');if(e.key==='ArrowLeft')move('LEFT');if(e.key==='ArrowRight')move('RIGHT')});function gameLoop(){if(!gameRunning)return;setTimeout(function(){var head={x:snake[0].x+dx,y:snake[0].y+dy};if(head.x<0||head.x>=tileCount||head.y<0||head.y>=tileCount){gameOver();return}if(snake.some(function(s){return s.x===head.x&&s.y===head.y})){gameOver();return}snake.unshift(head);if(head.x===food.x&&head.y===food.y){score+=10;document.getElementById('score').textContent=score;if(score>highscore){highscore=score;document.getElementById('highscore').textContent=highscore;ePhone.save('snake_highscore',highscore)}generateFood();if(gameSpeed>50)gameSpeed-=2}else{snake.pop()}draw();gameLoop()},gameSpeed)}function draw(){ctx.fillStyle=settings.darkMode?'#1a1a1a':'#f0f0f0';ctx.fillRect(0,0,canvas.width,canvas.height);snake.forEach(function(s,i){ctx.fillStyle=i===0?'#30d158':'#34c759';ctx.fillRect(s.x*gridSize+1,s.y*gridSize+1,gridSize-2,gridSize-2)});ctx.fillStyle='#ff3b30';ctx.beginPath();ctx.arc(food.x*gridSize+gridSize/2,food.y*gridSize+gridSize/2,gridSize/2-2,0,Math.PI*2);ctx.fill()}function gameOver(){gameRunning=false;document.getElementById('startBtn').style.display='block';document.getElementById('startBtn').textContent='Играть снова';ePhone.vibrate(200)}draw();</script>"
}
