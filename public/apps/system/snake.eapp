{
  "id": "snake_system",
  "name": "Змейка",
  "icon": "material:catching_pokemon",
  "color": "from-green-400 to-green-600",
  "version": "2.0.0",
  "author": "ePhone System",
  "description": "Классическая игра Змейка",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "v2.0 - Полный функционал с рекордами и ускорением",
  "code": "<!--\n⚠️ СИСТЕМНОЕ ПРИЛОЖЕНИЕ - НЕ УДАЛЯТЬ:\n- Canvas элемент с id=\"gameCanvas\" (320x320)\n- Функции: startGame(), move(), gameLoop(), draw(), gameOver()\n- Переменные: snake, food, dx, dy, score, highscore, gameRunning\n- ePhone.save('snake_highscore') - сохранение рекорда\n- Обработчики кнопок управления\n-->\n<div class=\"snake-game\">\n  <h1><span class=\"material-icons\">catching_pokemon</span> Змейка</h1>\n  <div class=\"stats\">\n    <span>Счёт: <span id=\"score\">0</span></span>\n    <span>Рекорд: <span id=\"highscore\">0</span></span>\n  </div>\n  <canvas id=\"gameCanvas\" width=\"320\" height=\"320\"></canvas>\n  <div class=\"controls\">\n    <button onclick=\"move('UP')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_upward</span></button>\n    <div class=\"ctrl-row\">\n      <button onclick=\"move('LEFT')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_back</span></button>\n      <button onclick=\"move('DOWN')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_downward</span></button>\n      <button onclick=\"move('RIGHT')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_forward</span></button>\n    </div>\n  </div>\n  <button onclick=\"startGame()\" class=\"start-btn\" id=\"startBtn\">Начать игру</button>\n</div>\n\n<style>\n.snake-game { padding: 20px; text-align: center; }\n.snake-game h1 { font-size: 20px; margin-bottom: 10px; display: flex; align-items: center; justify-content: center; gap: 8px; }\n.stats { display: flex; justify-content: space-around; margin-bottom: 15px; font-size: 14px; }\n#gameCanvas { border: 2px solid currentColor; border-radius: 8px; margin-bottom: 15px; max-width: 100%; }\n.controls { display: flex; flex-direction: column; align-items: center; gap: 5px; margin-bottom: 15px; }\n.ctrl-row { display: flex; gap: 5px; }\n.ctrl-btn { width: 50px; height: 50px; border: none; border-radius: 12px; background: rgba(128,128,128,0.3); cursor: pointer; display: flex; align-items: center; justify-content: center; }\n.ctrl-btn:active { transform: scale(0.9); }\n.start-btn { padding: 12px 32px; background: linear-gradient(135deg, #34c759, #30d158); color: white; border: none; border-radius: 25px; font-size: 16px; font-weight: bold; cursor: pointer; }\n.start-btn:active { transform: scale(0.95); }\n</style>\n\n<script>\n// ⚠️ НЕ УДАЛЯТЬ: Инициализация игры\nconst settings = ePhone.getSettings();\nconst container = document.querySelector('.snake-game');\ncontainer.style.color = settings.darkMode ? 'white' : 'black';\n\nconst canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\nconst gridSize = 20;\nconst tileCount = canvas.width / gridSize;\n\n// ⚠️ НЕ УДАЛЯТЬ: Игровые переменные\nlet snake = [{x: 10, y: 10}];\nlet food = {x: 15, y: 15};\nlet dx = 0, dy = 0;\nlet score = 0;\nlet highscore = ePhone.load('snake_highscore') || 0;\nlet gameRunning = false;\nlet gameSpeed = 100;\n\ndocument.getElementById('highscore').textContent = highscore;\n\n// ⚠️ НЕ УДАЛЯТЬ: Запуск игры\nfunction startGame() {\n  snake = [{x: 10, y: 10}];\n  dx = 1; dy = 0;\n  score = 0;\n  gameSpeed = 100;\n  document.getElementById('score').textContent = score;\n  gameRunning = true;\n  document.getElementById('startBtn').style.display = 'none';\n  generateFood();\n  gameLoop();\n}\n\n// ⚠️ НЕ УДАЛЯТЬ: Генерация еды\nfunction generateFood() {\n  do {\n    food = {\n      x: Math.floor(Math.random() * tileCount),\n      y: Math.floor(Math.random() * tileCount)\n    };\n  } while (snake.some(s => s.x === food.x && s.y === food.y));\n}\n\n// ⚠️ НЕ УДАЛЯТЬ: Управление\nfunction move(dir) {\n  if (!gameRunning) return;\n  if (dir === 'UP' && dy !== 1) { dx = 0; dy = -1; }\n  if (dir === 'DOWN' && dy !== -1) { dx = 0; dy = 1; }\n  if (dir === 'LEFT' && dx !== 1) { dx = -1; dy = 0; }\n  if (dir === 'RIGHT' && dx !== -1) { dx = 1; dy = 0; }\n}\n\n// ⚠️ НЕ УДАЛЯТЬ: Клавиатура\ndocument.addEventListener('keydown', function(e) {\n  if (e.key === 'ArrowUp') move('UP');\n  if (e.key === 'ArrowDown') move('DOWN');\n  if (e.key === 'ArrowLeft') move('LEFT');\n  if (e.key === 'ArrowRight') move('RIGHT');\n});\n\n// ⚠️ НЕ УДАЛЯТЬ: Игровой цикл\nfunction gameLoop() {\n  if (!gameRunning) return;\n  \n  setTimeout(() => {\n    const head = {x: snake[0].x + dx, y: snake[0].y + dy};\n    \n    // Проверка стен\n    if (head.x < 0 || head.x >= tileCount || head.y < 0 || head.y >= tileCount) {\n      gameOver();\n      return;\n    }\n    \n    // Проверка столкновения с собой\n    if (snake.some(s => s.x === head.x && s.y === head.y)) {\n      gameOver();\n      return;\n    }\n    \n    snake.unshift(head);\n    \n    // Проверка еды\n    if (head.x === food.x && head.y === food.y) {\n      score += 10;\n      document.getElementById('score').textContent = score;\n      if (score > highscore) {\n        highscore = score;\n        document.getElementById('highscore').textContent = highscore;\n        ePhone.save('snake_highscore', highscore);\n      }\n      generateFood();\n      // Ускорение\n      if (gameSpeed > 50) gameSpeed -= 2;\n    } else {\n      snake.pop();\n    }\n    \n    draw();\n    gameLoop();\n  }, gameSpeed);\n}\n\n// ⚠️ НЕ УДАЛЯТЬ: Отрисовка\nfunction draw() {\n  ctx.fillStyle = settings.darkMode ? '#1a1a1a' : '#f0f0f0';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n  \n  // Змейка\n  snake.forEach((s, i) => {\n    ctx.fillStyle = i === 0 ? '#30d158' : '#34c759';\n    ctx.fillRect(s.x * gridSize + 1, s.y * gridSize + 1, gridSize - 2, gridSize - 2);\n  });\n  \n  // Еда\n  ctx.fillStyle = '#ff3b30';\n  ctx.beginPath();\n  ctx.arc(food.x * gridSize + gridSize/2, food.y * gridSize + gridSize/2, gridSize/2 - 2, 0, Math.PI * 2);\n  ctx.fill();\n}\n\n// ⚠️ НЕ УДАЛЯТЬ: Конец игры\nfunction gameOver() {\n  gameRunning = false;\n  document.getElementById('startBtn').style.display = 'block';\n  document.getElementById('startBtn').textContent = 'Играть снова';\n  ePhone.vibrate(200);\n}\n\n// Начальная отрисовка\ndraw();\n</script>"
}
