{
  "id": "snake_system",
  "name": "Змейка",
  "icon": "material:catching_pokemon",
  "color": "from-green-400 to-emerald-600",
  "version": "3.0.0",
  "author": "ePhone System",
  "description": "Классическая Змейка с новым дизайном",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "eappVersion": "1.1",
  "code": "<div class=\"app\"><div class=\"header\"><span class=\"material-icons\">catching_pokemon</span><h1>Змейка</h1></div><div class=\"stats\"><div class=\"stat-box\"><div class=\"stat-label\">СЧЁТ</div><div class=\"stat-value\" id=\"score\">0</div></div><div class=\"stat-box\"><div class=\"stat-label\">РЕКОРД</div><div class=\"stat-value gold\" id=\"highscore\">0</div></div></div><canvas id=\"c\" width=\"300\" height=\"300\"></canvas><div class=\"controls\"><button onclick=\"m('U')\" class=\"ctrl\"><span class=\"material-icons\">keyboard_arrow_up</span></button><div class=\"ctrl-row\"><button onclick=\"m('L')\" class=\"ctrl\"><span class=\"material-icons\">keyboard_arrow_left</span></button><button onclick=\"m('D')\" class=\"ctrl\"><span class=\"material-icons\">keyboard_arrow_down</span></button><button onclick=\"m('R')\" class=\"ctrl\"><span class=\"material-icons\">keyboard_arrow_right</span></button></div></div><button onclick=\"start()\" class=\"btn-play\" id=\"playBtn\"><span class=\"material-icons\">play_arrow</span> Играть</button></div><style>.app{padding:15px;height:100%;display:flex;flex-direction:column;align-items:center;background:linear-gradient(135deg,#0a0a0a 0%,#1a1a2e 50%,#16213e 100%)}.header{display:flex;align-items:center;gap:8px;margin-bottom:12px;color:white}.header h1{font-size:20px;font-weight:600}.stats{display:flex;gap:12px;margin-bottom:12px}.stat-box{background:rgba(255,255,255,0.06);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:14px;padding:8px 20px;text-align:center}.stat-label{font-size:9px;color:rgba(255,255,255,0.5);letter-spacing:1px}.stat-value{font-size:22px;font-weight:700;color:white}.stat-value.gold{color:#ffd700}#c{border-radius:16px;border:1px solid rgba(255,255,255,0.1);box-shadow:0 8px 32px rgba(0,0,0,0.3);margin-bottom:12px}.controls{display:flex;flex-direction:column;align-items:center;gap:4px;margin-bottom:12px}.ctrl-row{display:flex;gap:4px}.ctrl{width:48px;height:48px;border:none;border-radius:14px;background:rgba(255,255,255,0.08);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.1);color:white;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.15s}.ctrl:active{transform:scale(0.9);background:rgba(255,255,255,0.15)}.btn-play{padding:12px 36px;background:linear-gradient(135deg,#00b894,#00cec9);color:white;border:none;border-radius:25px;font-size:15px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:6px;box-shadow:0 4px 15px rgba(0,206,201,0.3);transition:all 0.2s}.btn-play:active{transform:scale(0.95)}</style><script>var s=ePhone.getSettings();var c=document.getElementById('c'),x=c.getContext('2d'),G=15,T=c.width/G;var sn,fd,dx=0,dy=0,sc=0,hs=ePhone.load('snake_hs')||0,run=false,spd=120;document.getElementById('highscore').textContent=hs;function start(){sn=[{x:10,y:10}];dx=1;dy=0;sc=0;spd=120;document.getElementById('score').textContent=0;run=true;document.getElementById('playBtn').style.display='none';gf();gl()}function gf(){do{fd={x:Math.floor(Math.random()*T),y:Math.floor(Math.random()*T)}}while(sn.some(function(s){return s.x===fd.x&&s.y===fd.y}))}function m(d){if(!run)return;if(d==='U'&&dy!==1){dx=0;dy=-1}if(d==='D'&&dy!==-1){dx=0;dy=1}if(d==='L'&&dx!==1){dx=-1;dy=0}if(d==='R'&&dx!==-1){dx=1;dy=0}}document.addEventListener('keydown',function(e){if(e.key==='ArrowUp')m('U');if(e.key==='ArrowDown')m('D');if(e.key==='ArrowLeft')m('L');if(e.key==='ArrowRight')m('R')});function gl(){if(!run)return;setTimeout(function(){var h={x:sn[0].x+dx,y:sn[0].y+dy};if(h.x<0||h.x>=T||h.y<0||h.y>=T||sn.some(function(s){return s.x===h.x&&s.y===h.y})){run=false;document.getElementById('playBtn').style.display='flex';document.getElementById('playBtn').innerHTML='<span class=\"material-icons\">replay</span> Заново';ePhone.vibrate(200);return}sn.unshift(h);if(h.x===fd.x&&h.y===fd.y){sc+=10;document.getElementById('score').textContent=sc;if(sc>hs){hs=sc;document.getElementById('highscore').textContent=hs;ePhone.save('snake_hs',hs)}gf();if(spd>60)spd-=2}else{sn.pop()}dr();gl()},spd)}function dr(){x.fillStyle='#0a0a0a';x.fillRect(0,0,c.width,c.height);x.strokeStyle='rgba(255,255,255,0.03)';for(var i=0;i<T;i++){x.beginPath();x.moveTo(i*G,0);x.lineTo(i*G,c.height);x.stroke();x.beginPath();x.moveTo(0,i*G);x.lineTo(c.width,i*G);x.stroke()}sn.forEach(function(s,i){var g=x.createRadialGradient(s.x*G+G/2,s.y*G+G/2,0,s.x*G+G/2,s.y*G+G/2,G/2);if(i===0){g.addColorStop(0,'#00ffaa');g.addColorStop(1,'#00b894')}else{g.addColorStop(0,'rgba(0,206,201,0.8)');g.addColorStop(1,'rgba(0,184,148,0.6)')}x.fillStyle=g;x.beginPath();x.roundRect(s.x*G+1,s.y*G+1,G-2,G-2,4);x.fill()});var fg=x.createRadialGradient(fd.x*G+G/2,fd.y*G+G/2,0,fd.x*G+G/2,fd.y*G+G/2,G/2);fg.addColorStop(0,'#ff6b6b');fg.addColorStop(1,'#ee5a24');x.fillStyle=fg;x.beginPath();x.arc(fd.x*G+G/2,fd.y*G+G/2,G/2-2,0,Math.PI*2);x.fill();x.fillStyle='rgba(255,107,107,0.3)';x.beginPath();x.arc(fd.x*G+G/2,fd.y*G+G/2,G/2+2,0,Math.PI*2);x.fill()}dr();</script>"
}
