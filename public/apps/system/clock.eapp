{
  "id": "clock_system",
  "name": "Часы",
  "icon": "material:schedule",
  "color": "from-black to-gray-800",
  "version": "3.0.0",
  "author": "ePhone System",
  "description": "Часы с новым дизайном",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "eappVersion": "1.1",
  "code": "<div class=\"app\"><div class=\"tabs\"><button onclick=\"st('w')\" class=\"tab active\" id=\"tab-w\"><span class=\"material-icons\">public</span>Мир</button><button onclick=\"st('a')\" class=\"tab\" id=\"tab-a\"><span class=\"material-icons\">alarm</span>Будильник</button><button onclick=\"st('s')\" class=\"tab\" id=\"tab-s\"><span class=\"material-icons\">timer</span>Секундомер</button><button onclick=\"st('t')\" class=\"tab\" id=\"tab-t\"><span class=\"material-icons\">hourglass_empty</span>Таймер</button></div><div class=\"content\"><div id=\"w-view\" class=\"view active\"><div class=\"big-time\" id=\"bigTime\">00:00:00</div><div class=\"date\" id=\"dateStr\"></div><div class=\"world-clocks\" id=\"worldClocks\"></div></div><div id=\"s-view\" class=\"view\"><div class=\"sw-time\" id=\"swTime\">00:00.00</div><div class=\"sw-controls\"><button onclick=\"swR()\" class=\"sw-btn\">Сброс</button><button onclick=\"swT()\" class=\"sw-btn start\" id=\"swStartBtn\">Старт</button></div></div><div id=\"t-view\" class=\"view\"><div class=\"timer-time\" id=\"timerTime\">01:00</div><div class=\"timer-presets\"><button onclick=\"sT(30)\" class=\"preset-btn\">30с</button><button onclick=\"sT(60)\" class=\"preset-btn\">1м</button><button onclick=\"sT(180)\" class=\"preset-btn\">3м</button><button onclick=\"sT(300)\" class=\"preset-btn\">5м</button></div><div class=\"sw-controls\"><button onclick=\"tR()\" class=\"sw-btn\">Сброс</button><button onclick=\"tT()\" class=\"sw-btn start\" id=\"timerStartBtn\">Старт</button></div></div><div id=\"a-view\" class=\"view\"><div class=\"alarm-item\"><div><div class=\"alarm-time\">07:00</div><div class=\"alarm-label\">Подъём</div></div><label class=\"switch\"><input type=\"checkbox\" checked><span class=\"slider\"></span></label></div><div class=\"alarm-item\"><div><div class=\"alarm-time\">08:30</div><div class=\"alarm-label\">Работа</div></div><label class=\"switch\"><input type=\"checkbox\"><span class=\"slider\"></span></label></div></div></div></div><style>.app{padding:10px;height:100%;display:flex;flex-direction:column;background:linear-gradient(135deg,#0a0a0a 0%,#1a1a2e 100%);color:white}.tabs{display:flex;border-bottom:1px solid rgba(255,255,255,0.1);margin-bottom:20px}.tab{flex:1;padding:10px 5px;background:none;border:none;color:rgba(255,255,255,0.4);font-size:11px;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px;transition:all 0.2s}.tab.active{color:#ff9500;border-bottom:2px solid #ff9500}.tab .material-icons{font-size:18px}.view{display:none}.view.active{display:block;animation:fadeIn 0.3s ease}@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}.big-time{font-size:56px;font-weight:100;text-align:center;margin:30px 0 10px;letter-spacing:-2px}.date{text-align:center;opacity:0.5;margin-bottom:30px;font-size:14px}.world-clocks{display:grid;grid-template-columns:1fr 1fr;gap:10px}.world-clock{background:rgba(255,255,255,0.06);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);padding:12px;border-radius:14px;text-align:center}.world-clock .city{font-size:12px;opacity:0.6}.world-clock .time{font-size:22px;font-weight:300;margin-top:4px}.sw-time,.timer-time{font-size:56px;font-weight:100;text-align:center;margin:50px 0 30px;letter-spacing:-2px}.sw-controls{display:flex;justify-content:center;gap:30px}.sw-btn{width:80px;height:80px;border-radius:50%;border:2px solid rgba(255,255,255,0.2);background:rgba(255,255,255,0.06);backdrop-filter:blur(10px);font-size:14px;cursor:pointer;color:white;transition:all 0.2s}.sw-btn:active{transform:scale(0.9)}.sw-btn.start{border-color:#34c759;color:#34c759;background:rgba(52,199,89,0.1)}.timer-presets{display:flex;justify-content:center;gap:8px;margin-bottom:30px;flex-wrap:wrap}.preset-btn{padding:8px 16px;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.1);border-radius:20px;cursor:pointer;color:white;transition:all 0.2s}.preset-btn:active{transform:scale(0.95);background:rgba(255,255,255,0.15)}.alarm-item{display:flex;justify-content:space-between;align-items:center;padding:15px;background:rgba(255,255,255,0.06);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:14px;margin-bottom:10px}.alarm-time{font-size:28px;font-weight:300}.alarm-label{font-size:12px;opacity:0.6}.switch{position:relative;width:50px;height:30px}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;cursor:pointer;inset:0;background:rgba(255,255,255,0.2);border-radius:30px;transition:0.3s}.slider:before{content:'';position:absolute;height:24px;width:24px;left:3px;bottom:3px;background:white;border-radius:50%;transition:0.3s}input:checked+.slider{background:#34c759}input:checked+.slider:before{transform:translateX(20px)}</style><script>var s=ePhone.getSettings();var ct='w',swR2=false,swT2=0,swI,tR2=false,tS=60,tI;function st(t){ct=t;document.querySelectorAll('.tab').forEach(function(el){el.classList.remove('active')});document.getElementById('tab-'+t).classList.add('active');document.querySelectorAll('.view').forEach(function(v){v.classList.remove('active')});document.getElementById(t+'-view').classList.add('active')}function uwc(){var now=new Date();document.getElementById('bigTime').textContent=now.toLocaleTimeString('ru-RU');document.getElementById('dateStr').textContent=now.toLocaleDateString('ru-RU',{weekday:'long',day:'numeric',month:'long',year:'numeric'});var cities=[{name:'Москва',offset:3},{name:'Нью-Йорк',offset:-5},{name:'Токио',offset:9},{name:'Лондон',offset:0}];var utc=now.getTime()+now.getTimezoneOffset()*60000;var clocksHtml=cities.map(function(c){var cityTime=new Date(utc+c.offset*3600000);return '<div class=\"world-clock\"><div class=\"city\">'+c.name+'</div><div class=\"time\">'+cityTime.toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'})+'</div></div>'}).join('');document.getElementById('worldClocks').innerHTML=clocksHtml}function fSW(ms){var min=Math.floor(ms/60000),sec=Math.floor((ms%60000)/1000),cs=Math.floor((ms%1000)/10);return String(min).padStart(2,'0')+':'+String(sec).padStart(2,'0')+'.'+String(cs).padStart(2,'0')}function swT(){swR2=!swR2;var btn=document.getElementById('swStartBtn');if(swR2){btn.textContent='Стоп';btn.style.color='#ff3b30';btn.style.borderColor='#ff3b30';btn.style.background='rgba(255,59,48,0.1)';swI=setInterval(function(){swT2+=10;document.getElementById('swTime').textContent=fSW(swT2)},10)}else{btn.textContent='Старт';btn.style.color='#34c759';btn.style.borderColor='#34c759';btn.style.background='rgba(52,199,89,0.1)';clearInterval(swI)}}function swR(){swR2=false;swT2=0;clearInterval(swI);document.getElementById('swTime').textContent='00:00.00';var btn=document.getElementById('swStartBtn');btn.textContent='Старт';btn.style.color='#34c759';btn.style.borderColor='#34c759';btn.style.background='rgba(52,199,89,0.1)'}function fT(s){var min=Math.floor(s/60),sec=s%60;return String(min).padStart(2,'0')+':'+String(sec).padStart(2,'0')}function sT(s){tS=s;tR2=false;clearInterval(tI);document.getElementById('timerTime').textContent=fT(s);var btn=document.getElementById('timerStartBtn');btn.textContent='Старт';btn.style.color='#34c759';btn.style.borderColor='#34c759'}function tT(){tR2=!tR2;var btn=document.getElementById('timerStartBtn');if(tR2){btn.textContent='Стоп';btn.style.color='#ff3b30';btn.style.borderColor='#ff3b30';tI=setInterval(function(){tS--;document.getElementById('timerTime').textContent=fT(tS);if(tS<=0){tR2=false;clearInterval(tI);btn.textContent='Старт';ePhone.vibrate([200,100,200])}},1000)}else{btn.textContent='Старт';btn.style.color='#34c759';btn.style.borderColor='#34c759';clearInterval(tI)}}function tR(){tR2=false;tS=60;clearInterval(tI);document.getElementById('timerTime').textContent='01:00';var btn=document.getElementById('timerStartBtn');btn.textContent='Старт';btn.style.color='#34c759';btn.style.borderColor='#34c759'}uwc();setInterval(uwc,1000);</script>"
}
