{
  "id": "clock_system",
  "name": "Часы",
  "icon": "material:schedule",
  "color": "from-black to-gray-800",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Мировые часы, будильник, секундомер, таймер",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "code": "<div class=\"clock-app\">\n  <div class=\"tabs\">\n    <button onclick=\"setTab('world')\" class=\"tab active\" id=\"tab-world\"><span class=\"material-icons\">public</span> Мир</button>\n    <button onclick=\"setTab('alarm')\" class=\"tab\" id=\"tab-alarm\"><span class=\"material-icons\">alarm</span> Будильник</button>\n    <button onclick=\"setTab('stopwatch')\" class=\"tab\" id=\"tab-stopwatch\"><span class=\"material-icons\">timer</span> Секундомер</button>\n    <button onclick=\"setTab('timer')\" class=\"tab\" id=\"tab-timer\"><span class=\"material-icons\">hourglass_empty</span> Таймер</button>\n  </div>\n  <div class=\"content\">\n    <div id=\"world-view\" class=\"view active\">\n      <div class=\"big-time\" id=\"bigTime\">00:00:00</div>\n      <div class=\"date\" id=\"dateStr\"></div>\n      <div class=\"world-clocks\" id=\"worldClocks\"></div>\n    </div>\n    <div id=\"stopwatch-view\" class=\"view\">\n      <div class=\"sw-time\" id=\"swTime\">00:00.00</div>\n      <div class=\"sw-controls\">\n        <button onclick=\"swReset()\" class=\"sw-btn\" id=\"swResetBtn\">Сброс</button>\n        <button onclick=\"swToggle()\" class=\"sw-btn start\" id=\"swStartBtn\">Старт</button>\n      </div>\n    </div>\n    <div id=\"timer-view\" class=\"view\">\n      <div class=\"timer-time\" id=\"timerTime\">01:00</div>\n      <div class=\"timer-presets\">\n        <button onclick=\"setTimer(30)\" class=\"preset-btn\">30с</button>\n        <button onclick=\"setTimer(60)\" class=\"preset-btn\">1м</button>\n        <button onclick=\"setTimer(180)\" class=\"preset-btn\">3м</button>\n        <button onclick=\"setTimer(300)\" class=\"preset-btn\">5м</button>\n      </div>\n      <div class=\"sw-controls\">\n        <button onclick=\"timerReset()\" class=\"sw-btn\">Сброс</button>\n        <button onclick=\"timerToggle()\" class=\"sw-btn start\" id=\"timerStartBtn\">Старт</button>\n      </div>\n    </div>\n    <div id=\"alarm-view\" class=\"view\">\n      <div class=\"alarm-item\">\n        <div><div class=\"alarm-time\">07:00</div><div class=\"alarm-label\">Подъём</div></div>\n        <label class=\"switch\"><input type=\"checkbox\" checked><span class=\"slider\"></span></label>\n      </div>\n      <div class=\"alarm-item\">\n        <div><div class=\"alarm-time\">08:30</div><div class=\"alarm-label\">Работа</div></div>\n        <label class=\"switch\"><input type=\"checkbox\"><span class=\"slider\"></span></label>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.clock-app { padding: 10px; height: 100%; display: flex; flex-direction: column; }\n.tabs { display: flex; border-bottom: 1px solid rgba(128,128,128,0.3); margin-bottom: 20px; }\n.tab { flex: 1; padding: 10px 5px; background: none; border: none; color: #888; font-size: 11px; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 2px; }\n.tab.active { color: #ff9500; border-bottom: 2px solid #ff9500; }\n.tab .material-icons { font-size: 18px; }\n.view { display: none; }\n.view.active { display: block; }\n.big-time { font-size: 56px; font-weight: 200; text-align: center; margin: 30px 0 10px; }\n.date { text-align: center; opacity: 0.7; margin-bottom: 30px; }\n.world-clocks { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }\n.world-clock { background: rgba(128,128,128,0.2); padding: 12px; border-radius: 12px; text-align: center; }\n.world-clock .city { font-size: 12px; opacity: 0.7; }\n.world-clock .time { font-size: 22px; font-weight: 300; margin-top: 4px; }\n.sw-time, .timer-time { font-size: 56px; font-weight: 200; text-align: center; margin: 50px 0 30px; }\n.sw-controls { display: flex; justify-content: center; gap: 30px; }\n.sw-btn { width: 80px; height: 80px; border-radius: 50%; border: 2px solid #888; background: rgba(128,128,128,0.2); font-size: 14px; cursor: pointer; }\n.sw-btn.start { border-color: #34c759; color: #34c759; background: rgba(52,199,89,0.2); }\n.timer-presets { display: flex; justify-content: center; gap: 8px; margin-bottom: 30px; flex-wrap: wrap; }\n.preset-btn { padding: 8px 16px; background: rgba(128,128,128,0.3); border: none; border-radius: 20px; cursor: pointer; }\n.alarm-item { display: flex; justify-content: space-between; align-items: center; padding: 15px; background: rgba(128,128,128,0.2); border-radius: 12px; margin-bottom: 10px; }\n.alarm-time { font-size: 28px; font-weight: 300; }\n.alarm-label { font-size: 12px; opacity: 0.7; }\n.switch { position: relative; width: 50px; height: 30px; }\n.switch input { opacity: 0; width: 0; height: 0; }\n.slider { position: absolute; cursor: pointer; inset: 0; background: #888; border-radius: 30px; transition: 0.3s; }\n.slider:before { content: ''; position: absolute; height: 24px; width: 24px; left: 3px; bottom: 3px; background: white; border-radius: 50%; transition: 0.3s; }\ninput:checked + .slider { background: #34c759; }\ninput:checked + .slider:before { transform: translateX(20px); }\n</style>\n\n<script>\nconst settings = ePhone.getSettings();\ndocument.querySelector('.clock-app').style.color = settings.darkMode ? 'white' : 'black';\n\nlet currentTab = 'world';\nlet swRunning = false, swTime = 0, swInterval;\nlet timerRunning = false, timerSeconds = 60, timerInterval;\n\nfunction setTab(tab) {\n  currentTab = tab;\n  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));\n  document.getElementById('tab-' + tab).classList.add('active');\n  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));\n  document.getElementById(tab + '-view').classList.add('active');\n}\n\nfunction updateWorldClock() {\n  const now = new Date();\n  document.getElementById('bigTime').textContent = now.toLocaleTimeString('ru-RU');\n  document.getElementById('dateStr').textContent = now.toLocaleDateString('ru-RU', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });\n  \n  const cities = [\n    { name: 'Москва', offset: 3 },\n    { name: 'Нью-Йорк', offset: -5 },\n    { name: 'Токио', offset: 9 },\n    { name: 'Лондон', offset: 0 }\n  ];\n  \n  const utc = now.getTime() + now.getTimezoneOffset() * 60000;\n  const clocksHtml = cities.map(c => {\n    const cityTime = new Date(utc + c.offset * 3600000);\n    return `<div class=\"world-clock\"><div class=\"city\">${c.name}</div><div class=\"time\">${cityTime.toLocaleTimeString('ru-RU', {hour: '2-digit', minute: '2-digit'})}</div></div>`;\n  }).join('');\n  document.getElementById('worldClocks').innerHTML = clocksHtml;\n}\n\nfunction formatSW(ms) {\n  const min = Math.floor(ms / 60000);\n  const sec = Math.floor((ms % 60000) / 1000);\n  const cs = Math.floor((ms % 1000) / 10);\n  return `${String(min).padStart(2,'0')}:${String(sec).padStart(2,'0')}.${String(cs).padStart(2,'0')}`;\n}\n\nfunction swToggle() {\n  swRunning = !swRunning;\n  const btn = document.getElementById('swStartBtn');\n  if (swRunning) {\n    btn.textContent = 'Стоп';\n    btn.style.color = '#ff3b30';\n    btn.style.borderColor = '#ff3b30';\n    btn.style.background = 'rgba(255,59,48,0.2)';\n    swInterval = setInterval(() => {\n      swTime += 10;\n      document.getElementById('swTime').textContent = formatSW(swTime);\n    }, 10);\n  } else {\n    btn.textContent = 'Старт';\n    btn.style.color = '#34c759';\n    btn.style.borderColor = '#34c759';\n    btn.style.background = 'rgba(52,199,89,0.2)';\n    clearInterval(swInterval);\n  }\n}\n\nfunction swReset() {\n  swRunning = false;\n  swTime = 0;\n  clearInterval(swInterval);\n  document.getElementById('swTime').textContent = '00:00.00';\n  const btn = document.getElementById('swStartBtn');\n  btn.textContent = 'Старт';\n  btn.style.color = '#34c759';\n  btn.style.borderColor = '#34c759';\n  btn.style.background = 'rgba(52,199,89,0.2)';\n}\n\nfunction formatTimer(s) {\n  const min = Math.floor(s / 60);\n  const sec = s % 60;\n  return `${String(min).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;\n}\n\nfunction setTimer(s) {\n  timerSeconds = s;\n  timerRunning = false;\n  clearInterval(timerInterval);\n  document.getElementById('timerTime').textContent = formatTimer(s);\n  const btn = document.getElementById('timerStartBtn');\n  btn.textContent = 'Старт';\n  btn.style.color = '#34c759';\n  btn.style.borderColor = '#34c759';\n}\n\nfunction timerToggle() {\n  timerRunning = !timerRunning;\n  const btn = document.getElementById('timerStartBtn');\n  if (timerRunning) {\n    btn.textContent = 'Стоп';\n    btn.style.color = '#ff3b30';\n    btn.style.borderColor = '#ff3b30';\n    timerInterval = setInterval(() => {\n      timerSeconds--;\n      document.getElementById('timerTime').textContent = formatTimer(timerSeconds);\n      if (timerSeconds <= 0) {\n        timerRunning = false;\n        clearInterval(timerInterval);\n        btn.textContent = 'Старт';\n        ePhone.vibrate([200, 100, 200]);\n      }\n    }, 1000);\n  } else {\n    btn.textContent = 'Старт';\n    btn.style.color = '#34c759';\n    btn.style.borderColor = '#34c759';\n    clearInterval(timerInterval);\n  }\n}\n\nfunction timerReset() {\n  timerRunning = false;\n  timerSeconds = 60;\n  clearInterval(timerInterval);\n  document.getElementById('timerTime').textContent = '01:00';\n  const btn = document.getElementById('timerStartBtn');\n  btn.textContent = 'Старт';\n  btn.style.color = '#34c759';\n  btn.style.borderColor = '#34c759';\n}\n\nupdateWorldClock();\nsetInterval(updateWorldClock, 1000);\n</script>"
}
