{
  "id": "music_system",
  "name": "Музыка",
  "icon": "material:music_note",
  "color": "from-red-400 to-pink-500",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Музыкальный плеер",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "Системное приложение",
  "code": "<!--\n⚠️ СИСТЕМНОЕ ПРИЛОЖЕНИЕ - НЕ УДАЛЯТЬ:\n- Список песен songs\n- Функции: playSong(), togglePlay(), nextSong(), prevSong()\n- Прогресс-бар и управление воспроизведением\n-->\n<div class=\"music-app\">\n  <h1><span class=\"material-icons\">music_note</span> Музыка</h1>\n  <div class=\"now-playing\" id=\"nowPlaying\">\n    <div class=\"album-art\" id=\"albumArt\">🎵</div>\n    <div class=\"song-info\">\n      <div class=\"song-title\" id=\"songTitle\">Выберите песню</div>\n      <div class=\"song-artist\" id=\"songArtist\">-</div>\n    </div>\n  </div>\n  <div class=\"controls\">\n    <button onclick=\"prevSong()\" class=\"ctrl-btn\"><span class=\"material-icons\">skip_previous</span></button>\n    <button onclick=\"togglePlay()\" class=\"play-btn\" id=\"playBtn\"><span class=\"material-icons\">play_arrow</span></button>\n    <button onclick=\"nextSong()\" class=\"ctrl-btn\"><span class=\"material-icons\">skip_next</span></button>\n  </div>\n  <div class=\"progress-bar\">\n    <div class=\"progress\" id=\"progress\"></div>\n  </div>\n  <div class=\"song-list\" id=\"songList\"></div>\n</div>\n\n<style>\n.music-app { padding: 20px; }\n.music-app h1 { font-size: 24px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }\n.now-playing { display: flex; align-items: center; gap: 15px; padding: 15px; background: rgba(128,128,128,0.2); border-radius: 12px; margin-bottom: 20px; }\n.album-art { width: 60px; height: 60px; background: linear-gradient(135deg, #ff6b6b, #ee5a6f); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 30px; }\n.song-info { flex: 1; }\n.song-title { font-size: 16px; font-weight: 600; }\n.song-artist { font-size: 14px; opacity: 0.7; }\n.controls { display: flex; justify-content: center; align-items: center; gap: 20px; margin-bottom: 20px; }\n.ctrl-btn { width: 40px; height: 40px; background: rgba(128,128,128,0.3); border: none; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; }\n.play-btn { width: 60px; height: 60px; background: linear-gradient(135deg, #ff6b6b, #ee5a6f); border: none; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; }\n.progress-bar { width: 100%; height: 4px; background: rgba(128,128,128,0.3); border-radius: 2px; margin-bottom: 20px; overflow: hidden; }\n.progress { height: 100%; background: #ff6b6b; width: 0%; transition: width 0.3s; }\n.song-list { display: flex; flex-direction: column; gap: 8px; }\n.song-item { display: flex; align-items: center; gap: 12px; padding: 10px; background: rgba(128,128,128,0.2); border-radius: 8px; cursor: pointer; }\n.song-item:hover { background: rgba(128,128,128,0.3); }\n.song-item .material-icons { font-size: 20px; opacity: 0.7; }\n.song-item-info { flex: 1; }\n.song-item-title { font-size: 14px; font-weight: 500; }\n.song-item-artist { font-size: 12px; opacity: 0.6; }\n</style>\n\n<script>\n// ⚠️ НЕ УДАЛЯТЬ: Инициализация\nconst settings = ePhone.getSettings();\ndocument.querySelector('.music-app').style.color = settings.darkMode ? 'white' : 'black';\n\n// ⚠️ НЕ УДАЛЯТЬ: Список песен\nconst songs = [\n  { id: 1, title: 'Blinding Lights', artist: 'The Weeknd', duration: '3:20' },\n  { id: 2, title: 'Shape of You', artist: 'Ed Sheeran', duration: '3:53' },\n  { id: 3, title: 'Levitating', artist: 'Dua Lipa', duration: '3:23' },\n  { id: 4, title: 'Stay', artist: 'The Kid LAROI', duration: '2:21' },\n  { id: 5, title: 'Heat Waves', artist: 'Glass Animals', duration: '3:58' }\n];\n\nlet currentSong = null;\nlet isPlaying = false;\nlet progress = 0;\nlet progressInterval;\n\n// ⚠️ НЕ УДАЛЯТЬ: Функции управления\nfunction loadSongs() {\n  const list = document.getElementById('songList');\n  list.innerHTML = songs.map(song => `\n    <div class=\"song-item\" onclick=\"playSong(${song.id})\">\n      <span class=\"material-icons\">music_note</span>\n      <div class=\"song-item-info\">\n        <div class=\"song-item-title\">${song.title}</div>\n        <div class=\"song-item-artist\">${song.artist}</div>\n      </div>\n      <span style=\"opacity: 0.5; font-size: 12px;\">${song.duration}</span>\n    </div>\n  `).join('');\n}\n\nfunction playSong(id) {\n  currentSong = songs.find(s => s.id === id);\n  if (!currentSong) return;\n  document.getElementById('songTitle').textContent = currentSong.title;\n  document.getElementById('songArtist').textContent = currentSong.artist;\n  isPlaying = true;\n  updatePlayButton();\n  startProgress();\n}\n\nfunction togglePlay() {\n  if (!currentSong) return;\n  isPlaying = !isPlaying;\n  updatePlayButton();\n  if (isPlaying) startProgress();\n  else stopProgress();\n}\n\nfunction nextSong() {\n  if (!currentSong) return;\n  const idx = songs.findIndex(s => s.id === currentSong.id);\n  const next = songs[(idx + 1) % songs.length];\n  playSong(next.id);\n}\n\nfunction prevSong() {\n  if (!currentSong) return;\n  const idx = songs.findIndex(s => s.id === currentSong.id);\n  const prev = songs[(idx - 1 + songs.length) % songs.length];\n  playSong(prev.id);\n}\n\nfunction updatePlayButton() {\n  const btn = document.getElementById('playBtn');\n  btn.innerHTML = `<span class=\"material-icons\">${isPlaying ? 'pause' : 'play_arrow'}</span>`;\n}\n\nfunction startProgress() {\n  stopProgress();\n  progressInterval = setInterval(() => {\n    progress += 0.5;\n    if (progress >= 100) {\n      progress = 0;\n      nextSong();\n    }\n    document.getElementById('progress').style.width = progress + '%';\n  }, 100);\n}\n\nfunction stopProgress() {\n  if (progressInterval) clearInterval(progressInterval);\n}\n\nloadSongs();\n</script>"
}
