{
  "id": "music_system",
  "name": "Музыка",
  "icon": "material:music_note",
  "color": "from-red-400 to-pink-500",
  "version": "3.0.0",
  "author": "ePhone System",
  "description": "Музыкальный плеер с новым дизайном",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "eappVersion": "1.1",
  "code": "<div class=\"app\"><div class=\"header\"><span class=\"material-icons\">music_note</span><h1>Музыка</h1></div><div class=\"now-playing\"><div class=\"album-art\" id=\"albumArt\">🎵</div><div class=\"song-info\"><div class=\"song-title\" id=\"songTitle\">Выберите песню</div><div class=\"song-artist\" id=\"songArtist\">-</div></div></div><div class=\"controls\"><button onclick=\"prevSong()\" class=\"ctrl-btn\"><span class=\"material-icons\">skip_previous</span></button><button onclick=\"togglePlay()\" class=\"play-btn\" id=\"playBtn\"><span class=\"material-icons\">play_arrow</span></button><button onclick=\"nextSong()\" class=\"ctrl-btn\"><span class=\"material-icons\">skip_next</span></button></div><div class=\"progress-bar\"><div class=\"progress\" id=\"progress\"></div></div><div class=\"song-list\" id=\"songList\"></div></div><style>.app{padding:20px;height:100%;display:flex;flex-direction:column;background:linear-gradient(135deg,#0a0a0a 0%,#1a1a2e 100%);color:white}.header{display:flex;align-items:center;gap:8px;margin-bottom:20px}.header h1{font-size:24px;font-weight:600}.now-playing{display:flex;align-items:center;gap:15px;padding:15px;background:rgba(255,255,255,0.06);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:16px;margin-bottom:20px}.album-art{width:60px;height:60px;background:linear-gradient(135deg,#ff6b6b,#ee5a6f);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:30px;box-shadow:0 4px 15px rgba(238,90,111,0.3)}.song-info{flex:1}.song-title{font-size:16px;font-weight:600}.song-artist{font-size:14px;opacity:0.6}.controls{display:flex;justify-content:center;align-items:center;gap:20px;margin-bottom:20px}.ctrl-btn{width:44px;height:44px;background:rgba(255,255,255,0.08);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.1);border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.2s}.ctrl-btn:active{transform:scale(0.9);background:rgba(255,255,255,0.15)}.play-btn{width:64px;height:64px;background:linear-gradient(135deg,#ff6b6b,#ee5a6f);border:none;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(238,90,111,0.4);transition:all 0.2s}.play-btn:active{transform:scale(0.9)}.progress-bar{width:100%;height:4px;background:rgba(255,255,255,0.1);border-radius:2px;margin-bottom:20px;overflow:hidden}.progress{height:100%;background:linear-gradient(90deg,#ff6b6b,#ee5a6f);width:0%;transition:width 0.3s;border-radius:2px}.song-list{display:flex;flex-direction:column;gap:8px;flex:1;overflow-y:auto}.song-item{display:flex;align-items:center;gap:12px;padding:10px;background:rgba(255,255,255,0.06);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.1);border-radius:12px;cursor:pointer;transition:all 0.2s}.song-item:active{transform:scale(0.98);background:rgba(255,255,255,0.1)}.song-item .material-icons{font-size:20px;opacity:0.6}.song-item-info{flex:1}.song-item-title{font-size:14px;font-weight:500}.song-item-artist{font-size:12px;opacity:0.5}</style><script>var s=ePhone.getSettings();var songs=[{id:1,title:'Blinding Lights',artist:'The Weeknd',duration:'3:20'},{id:2,title:'Shape of You',artist:'Ed Sheeran',duration:'3:53'},{id:3,title:'Levitating',artist:'Dua Lipa',duration:'3:23'},{id:4,title:'Stay',artist:'The Kid LAROI',duration:'2:21'},{id:5,title:'Heat Waves',artist:'Glass Animals',duration:'3:58'}];var currentSong=null,isPlaying=false,progress=0,progressInterval;function loadSongs(){var list=document.getElementById('songList');list.innerHTML=songs.map(function(song){return '<div class=\"song-item\" onclick=\"playSong('+song.id+')\"><span class=\"material-icons\">music_note</span><div class=\"song-item-info\"><div class=\"song-item-title\">'+song.title+'</div><div class=\"song-item-artist\">'+song.artist+'</div></div><span style=\"opacity:0.4;font-size:12px;\">'+song.duration+'</span></div>'}).join('')}function playSong(id){currentSong=songs.find(function(s){return s.id===id});if(!currentSong)return;document.getElementById('songTitle').textContent=currentSong.title;document.getElementById('songArtist').textContent=currentSong.artist;isPlaying=true;updatePlayButton();startProgress()}function togglePlay(){if(!currentSong)return;isPlaying=!isPlaying;updatePlayButton();if(isPlaying)startProgress();else stopProgress()}function nextSong(){if(!currentSong)return;var idx=songs.findIndex(function(s){return s.id===currentSong.id});var next=songs[(idx+1)%songs.length];playSong(next.id)}function prevSong(){if(!currentSong)return;var idx=songs.findIndex(function(s){return s.id===currentSong.id});var prev=songs[(idx-1+songs.length)%songs.length];playSong(prev.id)}function updatePlayButton(){var btn=document.getElementById('playBtn');btn.innerHTML='<span class=\"material-icons\">'+(isPlaying?'pause':'play_arrow')+'</span>'}function startProgress(){stopProgress();progressInterval=setInterval(function(){progress+=0.5;if(progress>=100){progress=0;nextSong()}document.getElementById('progress').style.width=progress+'%'},100)}function stopProgress(){if(progressInterval)clearInterval(progressInterval)}loadSongs();</script>"
}
