{
  "id": "appstore_system",
  "name": "App Store",
  "icon": "material:shop",
  "color": "from-blue-500 to-blue-700",
  "version": "3.0.0",
  "author": "ePhone System",
  "description": "Магазин приложений с новым дизайном",
  "supportedModels": [
    "iphone8",
    "iphonex",
    "iphone14",
    "epad101"
  ],
  "isSystem": true,
  "eappVersion": "1.1",
  "code": "<div class=\"app\"><div class=\"header\"><span class=\"material-icons\">shop</span><h1>Магазин</h1></div><div class=\"search-bar\"><span class=\"material-icons\">search</span><input type=\"text\" placeholder=\"Поиск приложений\"></div><div class=\"categories\" id=\"categories\"></div><div class=\"featured\"><h2>🔥 Популярное</h2><div class=\"featured-scroll\" id=\"featuredApps\"></div></div><div class=\"all-apps\"><h2>📱 Все приложения</h2><div class=\"apps-list\" id=\"appsList\"></div></div><div id=\"modal\" class=\"modal hidden\"><div class=\"modal-content\"><div id=\"modalIcon\" style=\"font-size:50px;margin-bottom:10px;\"></div><h3 id=\"modalTitle\"></h3><p id=\"modalDev\" style=\"opacity:0.6;\"></p><p id=\"modalInfo\" style=\"margin:10px 0;\"></p><p id=\"modalDesc\" style=\"opacity:0.7;font-size:14px;\"></p><button onclick=\"closeModal()\" class=\"modal-btn\">OK</button></div></div></div><style>.app{padding:20px;height:100%;overflow-y:auto;background:linear-gradient(135deg,#0a0a0a 0%,#1a1a2e 100%);color:white}.header{display:flex;align-items:center;gap:8px;margin-bottom:15px}.header h1{font-size:24px;font-weight:600}.search-bar{display:flex;align-items:center;gap:8px;padding:10px;background:rgba(255,255,255,0.06);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:14px;margin-bottom:15px}.search-bar input{flex:1;background:none;border:none;outline:none;font-size:14px;color:white}.search-bar input::placeholder{color:rgba(255,255,255,0.4)}.categories{display:flex;gap:8px;overflow-x:auto;margin-bottom:20px;padding-bottom:5px}.category-btn{padding:6px 14px;background:rgba(255,255,255,0.08);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.1);border-radius:20px;cursor:pointer;white-space:nowrap;font-size:12px;color:white;transition:all 0.2s}.category-btn.active{background:linear-gradient(135deg,#0984e3,#74b9ff);border-color:#0984e3;box-shadow:0 4px 15px rgba(9,132,227,0.3)}.category-btn:active{transform:scale(0.95)}.featured{margin-bottom:20px}.featured h2,.all-apps h2{font-size:16px;margin-bottom:10px;font-weight:600}.featured-scroll{display:flex;gap:10px;overflow-x:auto;padding-bottom:10px}.featured-app{min-width:120px;cursor:pointer;transition:all 0.2s}.featured-app:active{transform:scale(0.95)}.featured-icon{width:100%;height:120px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:40px;margin-bottom:5px;box-shadow:0 8px 24px rgba(0,0,0,0.3)}.featured-name{font-size:12px;font-weight:500}.featured-category{font-size:11px;opacity:0.6}.apps-list{display:flex;flex-direction:column;gap:10px}.app-item{display:flex;align-items:center;gap:12px;padding:10px;background:rgba(255,255,255,0.06);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.1);border-radius:14px;cursor:pointer;transition:all 0.2s}.app-item:active{transform:scale(0.98);background:rgba(255,255,255,0.1)}.app-icon{width:50px;height:50px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:24px;box-shadow:0 4px 15px rgba(0,0,0,0.2)}.app-info{flex:1}.app-name{font-size:14px;font-weight:500}.app-desc{font-size:12px;opacity:0.6}.install-btn{padding:6px 16px;background:rgba(9,132,227,0.2);color:#74b9ff;border:1px solid rgba(9,132,227,0.3);border-radius:20px;font-size:12px;font-weight:700;cursor:pointer;transition:all 0.2s}.install-btn:active{transform:scale(0.95)}.install-btn.installed{background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.6);border-color:rgba(255,255,255,0.1)}.modal{position:fixed;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:center;z-index:1000}.modal.hidden{display:none}.modal-content{background:rgba(30,30,40,0.95);backdrop-filter:blur(40px);border:1px solid rgba(255,255,255,0.1);border-radius:20px;padding:25px;max-width:300px;text-align:center;animation:fadeIn 0.3s ease}@keyframes fadeIn{from{opacity:0;transform:scale(0.9)}to{opacity:1;transform:scale(1)}}.modal-content h3{margin-bottom:5px}.modal-btn{padding:12px 36px;background:linear-gradient(135deg,#0984e3,#74b9ff);color:white;border:none;border-radius:20px;font-weight:600;cursor:pointer;margin-top:15px;box-shadow:0 4px 15px rgba(9,132,227,0.3);transition:all 0.2s}.modal-btn:active{transform:scale(0.95)}</style><script>var s=ePhone.getSettings();var storeApps=[{id:'1',name:'Instagram',developer:'Meta',rating:4.5,size:'230 MB',category:'Соцсети',icon:'📸',color:'linear-gradient(135deg,#ec4899,#a855f7)',description:'Фото и видео'},{id:'2',name:'TikTok',developer:'ByteDance',rating:4.3,size:'310 MB',category:'Развлечения',icon:'🎵',color:'linear-gradient(135deg,#000,#333)',description:'Короткие видео'},{id:'3',name:'Telegram',developer:'Telegram',rating:4.8,size:'150 MB',category:'Мессенджеры',icon:'✈️',color:'linear-gradient(135deg,#00bcd4,#0097a7)',description:'Быстрый мессенджер'},{id:'4',name:'Spotify',developer:'Spotify AB',rating:4.6,size:'180 MB',category:'Музыка',icon:'🎧',color:'linear-gradient(135deg,#1db954,#1ed760)',description:'Музыкальный стриминг'},{id:'5',name:'YouTube',developer:'Google',rating:4.4,size:'280 MB',category:'Видео',icon:'▶️',color:'linear-gradient(135deg,#ff0000,#cc0000)',description:'Видео платформа'},{id:'6',name:'Netflix',developer:'Netflix Inc',rating:4.7,size:'120 MB',category:'Развлечения',icon:'🎬',color:'linear-gradient(135deg,#e50914,#b20710)',description:'Фильмы и сериалы'},{id:'7',name:'WhatsApp',developer:'Meta',rating:4.5,size:'170 MB',category:'Мессенджеры',icon:'💬',color:'linear-gradient(135deg,#25d366,#128c7e)',description:'Мессенджер'},{id:'8',name:'ChatGPT',developer:'OpenAI',rating:4.9,size:'90 MB',category:'Утилиты',icon:'🤖',color:'linear-gradient(135deg,#10a37f,#0d8c6d)',description:'AI ассистент'}];var categories=['Все','Соцсети','Развлечения','Мессенджеры','Музыка','Видео','Утилиты'];var installedApps={};function showModal(app){document.getElementById('modalIcon').textContent=app.icon;document.getElementById('modalTitle').textContent=app.name;document.getElementById('modalDev').textContent=app.developer;document.getElementById('modalInfo').textContent='★ '+app.rating+' • '+app.size;document.getElementById('modalDesc').textContent=app.description;document.getElementById('modal').classList.remove('hidden')}function closeModal(){document.getElementById('modal').classList.add('hidden')}function loadApps(){document.getElementById('categories').innerHTML=categories.map(function(cat,i){return '<button class=\"category-btn'+(i===0?' active':'')+'\">'+cat+'</button>'}).join('');document.getElementById('featuredApps').innerHTML=storeApps.slice(0,4).map(function(app){return '<div class=\"featured-app\" onclick=\"viewApp(&apos;'+app.id+'&apos;)\"><div class=\"featured-icon\" style=\"background:'+app.color+'\">'+app.icon+'</div><div class=\"featured-name\">'+app.name+'</div><div class=\"featured-category\">'+app.category+'</div></div>'}).join('');document.getElementById('appsList').innerHTML=storeApps.map(function(app){var isInstalled=installedApps[app.id];return '<div class=\"app-item\" onclick=\"viewApp(&apos;'+app.id+'&apos;)\"><div class=\"app-icon\" style=\"background:'+app.color+'\">'+app.icon+'</div><div class=\"app-info\"><div class=\"app-name\">'+app.name+'</div><div class=\"app-desc\">'+app.description+'</div></div><button class=\"install-btn'+(isInstalled?' installed':'')+'\" onclick=\"event.stopPropagation();installApp(&apos;'+app.id+'&apos;)\">'+(isInstalled?'✓':'GET')+'</button></div>'}).join('')}function installApp(id){if(installedApps[id]){delete installedApps[id]}else{installedApps[id]=true}loadApps()}function viewApp(id){var app=storeApps.find(function(a){return a.id===id});if(!app)return;showModal(app)}loadApps();</script>"
}