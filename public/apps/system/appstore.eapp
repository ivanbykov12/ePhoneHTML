{
  "id": "appstore_system",
  "name": "App Store",
  "icon": "material:shop",
  "color": "from-blue-500 to-blue-700",
  "version": "2.0.0",
  "author": "ePhone System",
  "description": "Магазин приложений",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "v2.0 - Исправлены alert() и let",
  "code": "<div class=\"appstore-app\"><h1><span class=\"material-icons\">shop</span> Магазин</h1><div class=\"search-bar\"><span class=\"material-icons\">search</span><input type=\"text\" placeholder=\"Поиск приложений\"></div><div class=\"categories\" id=\"categories\"></div><div class=\"featured\"><h2>🔥 Популярное</h2><div class=\"featured-scroll\" id=\"featuredApps\"></div></div><div class=\"all-apps\"><h2>📱 Все приложения</h2><div class=\"apps-list\" id=\"appsList\"></div></div><div id=\"modal\" class=\"modal hidden\"><div class=\"modal-content\"><div id=\"modalIcon\" style=\"font-size:50px;margin-bottom:10px;\"></div><h3 id=\"modalTitle\"></h3><p id=\"modalDev\" style=\"opacity:0.7;\"></p><p id=\"modalInfo\" style=\"margin:10px 0;\"></p><p id=\"modalDesc\" style=\"opacity:0.8;font-size:14px;\"></p><button onclick=\"closeModal()\" class=\"modal-btn\">OK</button></div></div></div><style>.appstore-app{padding:20px}.appstore-app h1{font-size:24px;margin-bottom:15px;display:flex;align-items:center;gap:8px}.search-bar{display:flex;align-items:center;gap:8px;padding:10px;background:rgba(128,128,128,0.2);border-radius:12px;margin-bottom:15px}.search-bar input{flex:1;background:none;border:none;outline:none;font-size:14px;color:inherit}.categories{display:flex;gap:8px;overflow-x:auto;margin-bottom:20px;padding-bottom:5px}.category-btn{padding:6px 14px;background:rgba(128,128,128,0.3);border:none;border-radius:20px;cursor:pointer;white-space:nowrap;font-size:12px;color:inherit}.category-btn.active{background:#007aff;color:white}.featured{margin-bottom:20px}.featured h2,.all-apps h2{font-size:16px;margin-bottom:10px}.featured-scroll{display:flex;gap:10px;overflow-x:auto;padding-bottom:10px}.featured-app{min-width:120px;cursor:pointer}.featured-icon{width:100%;height:120px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:40px;margin-bottom:5px}.featured-name{font-size:12px;font-weight:500}.featured-category{font-size:11px;opacity:0.7}.apps-list{display:flex;flex-direction:column;gap:10px}.app-item{display:flex;align-items:center;gap:12px;padding:10px;background:rgba(128,128,128,0.2);border-radius:12px;cursor:pointer}.app-item:hover{background:rgba(128,128,128,0.3)}.app-icon{width:50px;height:50px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:24px}.app-info{flex:1}.app-name{font-size:14px;font-weight:500}.app-desc{font-size:12px;opacity:0.7}.install-btn{padding:6px 16px;background:rgba(0,122,255,0.2);color:#007aff;border:none;border-radius:20px;font-size:12px;font-weight:bold;cursor:pointer}.install-btn.installed{background:rgba(128,128,128,0.3);color:inherit}.modal{position:fixed;inset:0;background:rgba(0,0,0,0.7);display:flex;align-items:center;justify-content:center;z-index:1000}.modal.hidden{display:none}.modal-content{background:#1c1c1e;border-radius:16px;padding:20px;max-width:300px;text-align:center;color:white}.modal-content h3{margin-bottom:5px}.modal-btn{padding:10px 30px;background:#007aff;color:white;border:none;border-radius:10px;font-weight:bold;cursor:pointer;margin-top:15px}</style><script>var settings=ePhone.getSettings();document.querySelector('.appstore-app').style.color=settings.darkMode?'white':'black';var storeApps=[{id:'1',name:'Instagram',developer:'Meta',rating:4.5,size:'230 MB',category:'Соцсети',icon:'📸',color:'linear-gradient(135deg,#ec4899,#a855f7)',description:'Фото и видео'},{id:'2',name:'TikTok',developer:'ByteDance',rating:4.3,size:'310 MB',category:'Развлечения',icon:'🎵',color:'linear-gradient(135deg,#000,#333)',description:'Короткие видео'},{id:'3',name:'Telegram',developer:'Telegram',rating:4.8,size:'150 MB',category:'Мессенджеры',icon:'✈️',color:'linear-gradient(135deg,#22d3ee,#3b82f6)',description:'Быстрый мессенджер'},{id:'4',name:'Spotify',developer:'Spotify AB',rating:4.6,size:'180 MB',category:'Музыка',icon:'🎧',color:'linear-gradient(135deg,#22c55e,#16a34a)',description:'Музыкальный стриминг'},{id:'5',name:'YouTube',developer:'Google',rating:4.4,size:'280 MB',category:'Видео',icon:'▶️',color:'linear-gradient(135deg,#ef4444,#dc2626)',description:'Видео платформа'},{id:'6',name:'Netflix',developer:'Netflix Inc',rating:4.7,size:'120 MB',category:'Развлечения',icon:'🎬',color:'linear-gradient(135deg,#dc2626,#991b1b)',description:'Фильмы и сериалы'},{id:'7',name:'WhatsApp',developer:'Meta',rating:4.5,size:'170 MB',category:'Мессенджеры',icon:'💬',color:'linear-gradient(135deg,#22c55e,#16a34a)',description:'Мессенджер'},{id:'8',name:'ChatGPT',developer:'OpenAI',rating:4.9,size:'90 MB',category:'Утилиты',icon:'🤖',color:'linear-gradient(135deg,#10b981,#0d9488)',description:'AI ассистент'}];var categories=['Все','Соцсети','Развлечения','Мессенджеры','Музыка','Видео','Утилиты'];var installedApps={};function showModal(app){document.getElementById('modalIcon').textContent=app.icon;document.getElementById('modalTitle').textContent=app.name;document.getElementById('modalDev').textContent=app.developer;document.getElementById('modalInfo').textContent='★ '+app.rating+' • '+app.size;document.getElementById('modalDesc').textContent=app.description;document.getElementById('modal').classList.remove('hidden')}function closeModal(){document.getElementById('modal').classList.add('hidden')}function loadApps(){document.getElementById('categories').innerHTML=categories.map(function(cat,i){return '<button class=\"category-btn'+(i===0?' active':'')+'\">'+cat+'</button>'}).join('');document.getElementById('featuredApps').innerHTML=storeApps.slice(0,4).map(function(app){return '<div class=\"featured-app\" onclick=\"viewApp(\\''+app.id+'\\')\"><div class=\"featured-icon\" style=\"background:'+app.color+'\">'+app.icon+'</div><div class=\"featured-name\">'+app.name+'</div><div class=\"featured-category\">'+app.category+'</div></div>'}).join('');document.getElementById('appsList').innerHTML=storeApps.map(function(app){var isInstalled=installedApps[app.id];return '<div class=\"app-item\" onclick=\"viewApp(\\''+app.id+'\\')\"><div class=\"app-icon\" style=\"background:'+app.color+'\">'+app.icon+'</div><div class=\"app-info\"><div class=\"app-name\">'+app.name+'</div><div class=\"app-desc\">'+app.description+'</div></div><button class=\"install-btn'+(isInstalled?' installed':'')+'\" onclick=\"event.stopPropagation();installApp(\\''+app.id+'\\')\">'+(isInstalled?'✓':'GET')+'</button></div>'}).join('')}function installApp(id){if(installedApps[id]){delete installedApps[id]}else{installedApps[id]=true}loadApps()}function viewApp(id){var app=storeApps.find(function(a){return a.id===id});if(!app)return;showModal(app)}loadApps();</script>"
}
