{
  "id": "appstore_system",
  "name": "App Store",
  "icon": "material:shop",
  "color": "from-blue-500 to-blue-700",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Магазин приложений",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "Системное приложение",
  "code": "<!--\n⚠️ СИСТЕМНОЕ ПРИЛОЖЕНИЕ - НЕ УДАЛЯТЬ:\n- Список приложений storeApps\n- Функции: loadApps(), installApp(), viewApp()\n- Категории и фильтры\n-->\n<div class=\"appstore-app\">\n  <h1><span class=\"material-icons\">shop</span> Магазин</h1>\n  <div class=\"search-bar\">\n    <span class=\"material-icons\">search</span>\n    <input type=\"text\" placeholder=\"Поиск приложений\">\n  </div>\n  <div class=\"categories\" id=\"categories\"></div>\n  <div class=\"featured\">\n    <h2>🔥 Популярное</h2>\n    <div class=\"featured-scroll\" id=\"featuredApps\"></div>\n  </div>\n  <div class=\"all-apps\">\n    <h2>📱 Все приложения</h2>\n    <div class=\"apps-list\" id=\"appsList\"></div>\n  </div>\n</div>\n\n<style>\n.appstore-app { padding: 20px; }\n.appstore-app h1 { font-size: 24px; margin-bottom: 15px; display: flex; align-items: center; gap: 8px; }\n.search-bar { display: flex; align-items: center; gap: 8px; padding: 10px; background: rgba(128,128,128,0.2); border-radius: 12px; margin-bottom: 15px; }\n.search-bar input { flex: 1; background: none; border: none; outline: none; font-size: 14px; color: inherit; }\n.categories { display: flex; gap: 8px; overflow-x: auto; margin-bottom: 20px; padding-bottom: 5px; }\n.category-btn { padding: 6px 14px; background: rgba(128,128,128,0.3); border: none; border-radius: 20px; cursor: pointer; white-space: nowrap; font-size: 12px; color: inherit; }\n.category-btn.active { background: #007aff; color: white; }\n.featured { margin-bottom: 20px; }\n.featured h2, .all-apps h2 { font-size: 16px; margin-bottom: 10px; }\n.featured-scroll { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 10px; }\n.featured-app { min-width: 120px; cursor: pointer; }\n.featured-icon { width: 100%; height: 120px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 40px; margin-bottom: 5px; }\n.featured-name { font-size: 12px; font-weight: 500; }\n.featured-category { font-size: 11px; opacity: 0.7; }\n.apps-list { display: flex; flex-direction: column; gap: 10px; }\n.app-item { display: flex; align-items: center; gap: 12px; padding: 10px; background: rgba(128,128,128,0.2); border-radius: 12px; cursor: pointer; }\n.app-item:hover { background: rgba(128,128,128,0.3); }\n.app-icon { width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; }\n.app-info { flex: 1; }\n.app-name { font-size: 14px; font-weight: 500; }\n.app-desc { font-size: 12px; opacity: 0.7; }\n.install-btn { padding: 6px 16px; background: rgba(0,122,255,0.2); color: #007aff; border: none; border-radius: 20px; font-size: 12px; font-weight: bold; cursor: pointer; }\n.install-btn.installed { background: rgba(128,128,128,0.3); color: inherit; }\n</style>\n\n<script>\n// ⚠️ НЕ УДАЛЯТЬ: Инициализация\nconst settings = ePhone.getSettings();\ndocument.querySelector('.appstore-app').style.color = settings.darkMode ? 'white' : 'black';\n\n// ⚠️ НЕ УДАЛЯТЬ: Список приложений\nconst storeApps = [\n  { id: '1', name: 'Instagram', developer: 'Meta', rating: 4.5, size: '230 MB', category: 'Соцсети', icon: '📸', color: 'from-pink-500 to-purple-600', description: 'Фото и видео' },\n  { id: '2', name: 'TikTok', developer: 'ByteDance', rating: 4.3, size: '310 MB', category: 'Развлечения', icon: '🎵', color: 'from-black to-gray-800', description: 'Короткие видео' },\n  { id: '3', name: 'Telegram', developer: 'Telegram', rating: 4.8, size: '150 MB', category: 'Мессенджеры', icon: '✈️', color: 'from-blue-400 to-blue-600', description: 'Быстрый мессенджер' },\n  { id: '4', name: 'Spotify', developer: 'Spotify AB', rating: 4.6, size: '180 MB', category: 'Музыка', icon: '🎧', color: 'from-green-500 to-green-700', description: 'Музыкальный стриминг' },\n  { id: '5', name: 'YouTube', developer: 'Google', rating: 4.4, size: '280 MB', category: 'Видео', icon: '▶️', color: 'from-red-500 to-red-700', description: 'Видео платформа' },\n  { id: '6', name: 'Netflix', developer: 'Netflix Inc', rating: 4.7, size: '120 MB', category: 'Развлечения', icon: '🎬', color: 'from-red-600 to-red-800', description: 'Фильмы и сериалы' },\n  { id: '7', name: 'WhatsApp', developer: 'Meta', rating: 4.5, size: '170 MB', category: 'Мессенджеры', icon: '💬', color: 'from-green-400 to-green-600', description: 'Мессенджер' },\n  { id: '8', name: 'ChatGPT', developer: 'OpenAI', rating: 4.9, size: '90 MB', category: 'Утилиты', icon: '🤖', color: 'from-emerald-500 to-teal-600', description: 'AI ассистент' }\n];\n\nconst categories = ['Все', 'Соцсети', 'Развлечения', 'Мессенджеры', 'Музыка', 'Видео', 'Утилиты'];\nlet installedApps = new Set();\n\n// ⚠️ НЕ УДАЛЯТЬ: Функции управления\nfunction loadApps() {\n  // Категории\n  document.getElementById('categories').innerHTML = categories.map((cat, i) => `\n    <button class=\"category-btn ${i === 0 ? 'active' : ''}\" onclick=\"filterCategory('${cat}')\">${cat}</button>\n  `).join('');\n  \n  // Популярные\n  document.getElementById('featuredApps').innerHTML = storeApps.slice(0, 4).map(app => `\n    <div class=\"featured-app\" onclick=\"viewApp('${app.id}')\">\n      <div class=\"featured-icon bg-gradient-to-br ${app.color}\">${app.icon}</div>\n      <div class=\"featured-name\">${app.name}</div>\n      <div class=\"featured-category\">${app.category}</div>\n    </div>\n  `).join('');\n  \n  // Все приложения\n  document.getElementById('appsList').innerHTML = storeApps.map(app => `\n    <div class=\"app-item\" onclick=\"viewApp('${app.id}')\">\n      <div class=\"app-icon bg-gradient-to-br ${app.color}\">${app.icon}</div>\n      <div class=\"app-info\">\n        <div class=\"app-name\">${app.name}</div>\n        <div class=\"app-desc\">${app.description}</div>\n      </div>\n      <button class=\"install-btn ${installedApps.has(app.id) ? 'installed' : ''}\" onclick=\"event.stopPropagation(); installApp('${app.id}')\">\n        ${installedApps.has(app.id) ? '✓' : 'GET'}\n      </button>\n    </div>\n  `).join('');\n}\n\nfunction filterCategory(category) {\n  document.querySelectorAll('.category-btn').forEach(btn => btn.classList.remove('active'));\n  event.target.classList.add('active');\n  // Фильтрация в полной версии\n}\n\nfunction installApp(id) {\n  if (installedApps.has(id)) {\n    installedApps.delete(id);\n  } else {\n    installedApps.add(id);\n  }\n  loadApps();\n}\n\nfunction viewApp(id) {\n  const app = storeApps.find(a => a.id === id);\n  if (!app) return;\n  alert(`${app.name}\\n${app.developer}\\n★ ${app.rating} • ${app.size}\\n\\n${app.description}\\n\\n(В полной версии здесь будет страница приложения)`);\n}\n\nloadApps();\n</script>"
}
