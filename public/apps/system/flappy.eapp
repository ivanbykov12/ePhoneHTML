{
  "id": "flappy_system",
  "name": "Flappy Bird",
  "icon": "material:flight",
  "color": "from-cyan-400 to-blue-500",
  "version": "2.0.0",
  "author": "ePhone System",
  "description": "Flappy Bird",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "v2.0 - Полный функционал с анимациями и эффектами",
  "code": "<div class=\"flappy-game\"><h1><span class=\"material-icons\">flight</span> Flappy Bird</h1><div class=\"stats\"><span>Счёт: <span id=\"score\">0</span></span><span>Рекорд: <span id=\"highscore\">0</span></span></div><canvas id=\"gameCanvas\" width=\"320\" height=\"480\"></canvas><button onclick=\"startGame()\" class=\"start-btn\" id=\"startBtn\">Начать игру</button><p class=\"hint\">Нажми на экран или пробел для прыжка</p></div><style>.flappy-game{padding:15px;text-align:center}.flappy-game h1{font-size:20px;margin-bottom:10px;display:flex;align-items:center;justify-content:center;gap:8px}.stats{display:flex;justify-content:space-around;margin-bottom:10px;font-size:14px}#gameCanvas{border:2px solid currentColor;border-radius:8px;margin-bottom:10px;max-width:100%;cursor:pointer}.start-btn{padding:12px 32px;background:linear-gradient(135deg,#00bcd4,#0097a7);color:white;border:none;border-radius:25px;font-size:16px;font-weight:bold;cursor:pointer;margin-bottom:10px}.hint{font-size:12px;opacity:0.6}</style><script>const canvas=document.getElementById('gameCanvas');const ctx=canvas.getContext('2d');const settings=ePhone.getSettings();document.querySelector('.flappy-game').style.color=settings.darkMode?'white':'black';const GRAVITY=0.5,JUMP_FORCE=-8,PIPE_WIDTH=50,PIPE_GAP=130,PIPE_SPEED=2.5,BIRD_SIZE=20;let bird={x:60,y:240,velocity:0,rotation:0};let pipes=[];let score=0;let highscore=ePhone.load('flappy_highscore')||0;let gameRunning=false;let frameCount=0;document.getElementById('highscore').textContent=highscore;function jump(){if(gameRunning){bird.velocity=JUMP_FORCE;ePhone.vibrate(20)}}function startGame(){bird={x:60,y:240,velocity:0,rotation:0};pipes=[];score=0;frameCount=0;gameRunning=true;document.getElementById('score').textContent=score;document.getElementById('startBtn').style.display='none';gameLoop()}function spawnPipe(){const minTop=50;const maxTop=canvas.height-PIPE_GAP-90;const topHeight=minTop+Math.random()*(maxTop-minTop);pipes.push({x:canvas.width,topHeight:topHeight,passed:false})}function checkCollision(){const birdTop=bird.y-BIRD_SIZE/2;const birdBottom=bird.y+BIRD_SIZE/2;const birdLeft=bird.x-BIRD_SIZE/2;const birdRight=bird.x+BIRD_SIZE/2;if(birdBottom>canvas.height-40||birdTop<0)return true;for(const pipe of pipes){if(birdRight>pipe.x&&birdLeft<pipe.x+PIPE_WIDTH){if(birdTop<pipe.topHeight||birdBottom>pipe.topHeight+PIPE_GAP)return true}}return false}function gameLoop(){if(!gameRunning)return;bird.velocity+=GRAVITY;bird.y+=bird.velocity;bird.rotation=Math.min(Math.max(bird.velocity*3,-30),90);frameCount++;if(frameCount%90===0)spawnPipe();pipes.forEach(pipe=>{pipe.x-=PIPE_SPEED;if(!pipe.passed&&pipe.x+PIPE_WIDTH<bird.x){pipe.passed=true;score++;document.getElementById('score').textContent=score;if(score>highscore){highscore=score;document.getElementById('highscore').textContent=highscore;ePhone.save('flappy_highscore',highscore)}}});pipes=pipes.filter(p=>p.x>-PIPE_WIDTH);if(checkCollision()){gameOver();return}draw();requestAnimationFrame(gameLoop)}function draw(){const gradient=ctx.createLinearGradient(0,0,0,canvas.height);gradient.addColorStop(0,'#87CEEB');gradient.addColorStop(1,'#4FC3F7');ctx.fillStyle=gradient;ctx.fillRect(0,0,canvas.width,canvas.height);ctx.fillStyle='rgba(255,255,255,0.6)';ctx.beginPath();ctx.arc(80,60,20,0,Math.PI*2);ctx.arc(100,55,25,0,Math.PI*2);ctx.arc(120,60,20,0,Math.PI*2);ctx.fill();pipes.forEach(pipe=>{ctx.fillStyle='#73bf2e';ctx.fillRect(pipe.x,0,PIPE_WIDTH,pipe.topHeight);ctx.fillRect(pipe.x,pipe.topHeight+PIPE_GAP,PIPE_WIDTH,canvas.height-pipe.topHeight-PIPE_GAP);ctx.fillStyle='#558b20';ctx.fillRect(pipe.x-3,pipe.topHeight-20,PIPE_WIDTH+6,20);ctx.fillRect(pipe.x-3,pipe.topHeight+PIPE_GAP,PIPE_WIDTH+6,20)});ctx.fillStyle='#ded895';ctx.fillRect(0,canvas.height-40,canvas.width,40);ctx.fillStyle='#5a8a2a';ctx.fillRect(0,canvas.height-40,canvas.width,5);ctx.save();ctx.translate(bird.x,bird.y);ctx.rotate(bird.rotation*Math.PI/180);ctx.fillStyle='#f5c842';ctx.beginPath();ctx.arc(0,0,BIRD_SIZE/2,0,Math.PI*2);ctx.fill();ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(5,-3,5,0,Math.PI*2);ctx.fill();ctx.fillStyle='#000';ctx.beginPath();ctx.arc(7,-3,2,0,Math.PI*2);ctx.fill();ctx.fillStyle='#e87e24';ctx.beginPath();ctx.moveTo(12,0);ctx.lineTo(22,2);ctx.lineTo(12,5);ctx.fill();ctx.restore();ctx.fillStyle='#fff';ctx.font='bold 36px sans-serif';ctx.textAlign='center';ctx.strokeStyle='#000';ctx.lineWidth=3;ctx.strokeText(String(score),canvas.width/2,60);ctx.fillText(String(score),canvas.width/2,60)}function gameOver(){gameRunning=false;document.getElementById('startBtn').style.display='block';document.getElementById('startBtn').textContent='Играть снова';ePhone.vibrate(200)}canvas.addEventListener('click',jump);canvas.addEventListener('touchstart',function(e){e.preventDefault();jump()});document.addEventListener('keydown',function(e){if(e.code==='Space'){e.preventDefault();jump()}});draw();</script>"
}
