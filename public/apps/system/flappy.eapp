{
  "id": "flappy_system",
  "name": "Flappy Bird",
  "icon": "material:flight",
  "color": "from-cyan-400 to-blue-500",
  "version": "3.0.0",
  "author": "ePhone System",
  "description": "Flappy Bird с новым дизайном",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "eappVersion": "1.1",
  "code": "<div class=\"app\"><div class=\"header\"><span class=\"material-icons\">flight</span><h1>Flappy Bird</h1></div><div class=\"stats\"><div class=\"stat-box\"><div class=\"stat-label\">СЧЁТ</div><div class=\"stat-value\" id=\"score\">0</div></div><div class=\"stat-box\"><div class=\"stat-label\">РЕКОРД</div><div class=\"stat-value gold\" id=\"highscore\">0</div></div></div><canvas id=\"c\" width=\"320\" height=\"480\"></canvas><button onclick=\"start()\" class=\"btn-play\" id=\"playBtn\"><span class=\"material-icons\">play_arrow</span> Начать</button><p class=\"hint\">Нажми на экран или пробел для прыжка</p></div><style>.app{padding:15px;height:100%;display:flex;flex-direction:column;align-items:center;background:linear-gradient(135deg,#0a0a0a 0%,#1a1a2e 50%,#16213e 100%)}.header{display:flex;align-items:center;gap:8px;margin-bottom:12px;color:white}.header h1{font-size:20px;font-weight:600}.stats{display:flex;gap:12px;margin-bottom:12px}.stat-box{background:rgba(255,255,255,0.06);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:14px;padding:8px 20px;text-align:center}.stat-label{font-size:9px;color:rgba(255,255,255,0.5);letter-spacing:1px}.stat-value{font-size:22px;font-weight:700;color:white}.stat-value.gold{color:#ffd700}#c{border-radius:16px;border:1px solid rgba(255,255,255,0.1);box-shadow:0 8px 32px rgba(0,0,0,0.3);margin-bottom:12px;max-width:100%;cursor:pointer}.btn-play{padding:12px 36px;background:linear-gradient(135deg,#00bcd4,#0097a7);color:white;border:none;border-radius:25px;font-size:15px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:6px;box-shadow:0 4px 15px rgba(0,151,167,0.3);transition:all 0.2s;margin-bottom:10px}.btn-play:active{transform:scale(0.95)}.hint{font-size:12px;opacity:0.5;color:white}</style><script>var canvas=document.getElementById('c'),ctx=canvas.getContext('2d'),s=ePhone.getSettings();document.querySelector('.app').style.color='white';var G=0.5,J=-8,PW=50,PG=130,PS=2.5,BS=20;var bird={x:60,y:240,v:0,r:0};var pipes=[];var score=0,highscore=ePhone.load('flappy_hs')||0,run=false,fc=0;document.getElementById('highscore').textContent=highscore;function jump(){if(run){bird.v=J;ePhone.vibrate(20)}}function start(){bird={x:60,y:240,v:0,r:0};pipes=[];score=0;fc=0;run=true;document.getElementById('score').textContent=0;document.getElementById('playBtn').style.display='none';gl()}function sp(){var mt=50,mx=canvas.height-PG-90,th=mt+Math.random()*(mx-mt);pipes.push({x:canvas.width,t:th,p:false})}function cc(){var bt=bird.y-BS/2,bb=bird.y+BS/2,bl=bird.x-BS/2,br=bird.x+BS/2;if(bb>canvas.height-40||bt<0)return true;for(var i=0;i<pipes.length;i++){var p=pipes[i];if(br>p.x&&bl<p.x+PW){if(bt<p.t||bb>p.t+PG)return true}}return false}function gl(){if(!run)return;bird.v+=G;bird.y+=bird.v;bird.r=Math.min(Math.max(bird.v*3,-30),90);fc++;if(fc%90===0)sp();for(var i=0;i<pipes.length;i++){pipes[i].x-=PS;if(!pipes[i].p&&pipes[i].x+PW<bird.x){pipes[i].p=true;score++;document.getElementById('score').textContent=score;if(score>highscore){highscore=score;document.getElementById('highscore').textContent=highscore;ePhone.save('flappy_hs',highscore)}}}pipes=pipes.filter(function(p){return p.x>-PW});if(cc()){go();return}draw();requestAnimationFrame(gl)}function draw(){var g=ctx.createLinearGradient(0,0,0,canvas.height);g.addColorStop(0,'#1a1a2e');g.addColorStop(1,'#16213e');ctx.fillStyle=g;ctx.fillRect(0,0,canvas.width,canvas.height);ctx.fillStyle='rgba(255,255,255,0.05)';for(var i=0;i<5;i++){ctx.beginPath();ctx.arc(50+i*70,50+Math.sin(fc/50+i)*10,15,0,Math.PI*2);ctx.fill()}pipes.forEach(function(p){var pg=ctx.createLinearGradient(p.x,0,p.x+PW,0);pg.addColorStop(0,'#00b894');pg.addColorStop(1,'#00cec9');ctx.fillStyle=pg;ctx.fillRect(p.x,0,PW,p.t);ctx.fillRect(p.x,p.t+PG,PW,canvas.height-p.t-PG);ctx.fillStyle='rgba(255,255,255,0.2)';ctx.fillRect(p.x,p.t-20,PW+6,20);ctx.fillRect(p.x,p.t+PG,PW+6,20)});var gg=ctx.createLinearGradient(0,canvas.height-40,0,canvas.height);gg.addColorStop(0,'#2d3436');gg.addColorStop(1,'#636e72');ctx.fillStyle=gg;ctx.fillRect(0,canvas.height-40,canvas.width,40);ctx.save();ctx.translate(bird.x,bird.y);ctx.rotate(bird.r*Math.PI/180);var bg=ctx.createRadialGradient(0,0,0,0,0,BS/2);bg.addColorStop(0,'#ffeaa7');bg.addColorStop(1,'#fdcb6e');ctx.fillStyle=bg;ctx.beginPath();ctx.arc(0,0,BS/2,0,Math.PI*2);ctx.fill();ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(5,-3,5,0,Math.PI*2);ctx.fill();ctx.fillStyle='#2d3436';ctx.beginPath();ctx.arc(7,-3,2,0,Math.PI*2);ctx.fill();ctx.fillStyle='#e17055';ctx.beginPath();ctx.moveTo(12,0);ctx.lineTo(22,2);ctx.lineTo(12,5);ctx.fill();ctx.restore();ctx.fillStyle='#fff';ctx.font='bold 36px sans-serif';ctx.textAlign='center';ctx.strokeStyle='rgba(0,0,0,0.5)';ctx.lineWidth=3;ctx.strokeText(String(score),canvas.width/2,60);ctx.fillText(String(score),canvas.width/2,60)}function go(){run=false;document.getElementById('playBtn').style.display='flex';document.getElementById('playBtn').innerHTML='<span class=\"material-icons\">replay</span> Заново';ePhone.vibrate(200)}canvas.addEventListener('click',jump);canvas.addEventListener('touchstart',function(e){e.preventDefault();jump()});document.addEventListener('keydown',function(e){if(e.code==='Space'){e.preventDefault();jump()}});draw();</script>"
}
