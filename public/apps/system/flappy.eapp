{
  "id": "flappy_system",
  "name": "Flappy Bird",
  "icon": "material:flight",
  "color": "from-cyan-400 to-blue-500",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Flappy Bird",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "Системное приложение",
  "code": "<!--\n⚠️ СИСТЕМНОЕ ПРИЛОЖЕНИЕ - НЕ УДАЛЯТЬ:\n- Canvas элемент с id=\"gameCanvas\"\n- Функции: startGame(), jump(), gameLoop()\n- ePhone.save('flappy_highscore') - сохранение рекорда\n- Обработчики событий click/touchstart для прыжка\n-->\n<div class=\"flappy-game\">\n  <h1><span class=\"material-icons\">flight</span> Flappy Bird</h1>\n  <div class=\"stats\">\n    <span>Счёт: <span id=\"score\">0</span></span>\n    <span>Рекорд: <span id=\"highscore\">0</span></span>\n  </div>\n  <canvas id=\"gameCanvas\" width=\"320\" height=\"400\" onclick=\"jump()\" ontouchstart=\"jump()\"></canvas>\n  <button onclick=\"startGame()\" class=\"start-btn\" id=\"startBtn\">Начать игру</button>\n</div>\n\n<style>\n.flappy-game { padding: 20px; text-align: center; }\n.flappy-game h1 { font-size: 20px; margin-bottom: 10px; display: flex; align-items: center; justify-content: center; gap: 8px; }\n.stats { display: flex; justify-content: space-around; margin-bottom: 15px; font-size: 14px; }\n#gameCanvas { border: 2px solid currentColor; border-radius: 8px; margin-bottom: 15px; max-width: 100%; cursor: pointer; }\n.start-btn { padding: 12px 32px; background: linear-gradient(135deg, #00bcd4, #0097a7); color: white; border: none; border-radius: 25px; font-size: 16px; font-weight: bold; cursor: pointer; }\n.start-btn:active { transform: scale(0.95); }\n</style>\n\n<script>\n// ⚠️ НЕ УДАЛЯТЬ: Инициализация игры\nconst canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\nconst settings = ePhone.getSettings();\ndocument.querySelector('.flappy-game').style.color = settings.darkMode ? 'white' : 'black';\n\nlet bird = { x: 50, y: 200, velocity: 0 };\nlet pipes = [];\nlet score = 0;\nlet highscore = ePhone.load('flappy_highscore') || 0;\nlet gameRunning = false;\nlet frameCount = 0;\n\ndocument.getElementById('highscore').textContent = highscore;\n\n// ⚠️ НЕ УДАЛЯТЬ: Функция прыжка\nfunction jump() {\n  if (gameRunning) {\n    bird.velocity = -8;\n  }\n}\n\n// ⚠️ НЕ УДАТЬ: Запуск игры\nfunction startGame() {\n  bird = { x: 50, y: 200, velocity: 0 };\n  pipes = [];\n  score = 0;\n  frameCount = 0;\n  gameRunning = true;\n  document.getElementById('score').textContent = score;\n  document.getElementById('startBtn').style.display = 'none';\n  gameLoop();\n}\n\n// ⚠️ НЕ УДАЛЯТЬ: Игровой цикл\nfunction gameLoop() {\n  if (!gameRunning) return;\n  \n  ctx.fillStyle = settings.darkMode ? '#1a1a2e' : '#87ceeb';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n  \n  // Физика птицы\n  bird.velocity += 0.5;\n  bird.y += bird.velocity;\n  \n  // Генерация труб\n  frameCount++;\n  if (frameCount % 90 === 0) {\n    const gap = 120;\n    const gapY = Math.random() * (canvas.height - gap - 100) + 50;\n    pipes.push({ x: canvas.width, gapY: gapY, passed: false });\n  }\n  \n  // Обновление и отрисовка труб\n  pipes.forEach((pipe, i) => {\n    pipe.x -= 2;\n    \n    // Проверка прохождения\n    if (!pipe.passed && pipe.x + 50 < bird.x) {\n      pipe.passed = true;\n      score++;\n      document.getElementById('score').textContent = score;\n      if (score > highscore) {\n        highscore = score;\n        document.getElementById('highscore').textContent = highscore;\n        ePhone.save('flappy_highscore', highscore);\n      }\n    }\n    \n    // Отрисовка труб\n    ctx.fillStyle = '#34c759';\n    ctx.fillRect(pipe.x, 0, 50, pipe.gapY);\n    ctx.fillRect(pipe.x, pipe.gapY + 120, 50, canvas.height);\n    \n    // Проверка столкновения\n    if (bird.x + 15 > pipe.x && bird.x - 15 < pipe.x + 50) {\n      if (bird.y - 15 < pipe.gapY || bird.y + 15 > pipe.gapY + 120) {\n        gameOver();\n      }\n    }\n  });\n  \n  pipes = pipes.filter(p => p.x > -50);\n  \n  // Отрисовка птицы\n  ctx.fillStyle = '#ffd700';\n  ctx.beginPath();\n  ctx.arc(bird.x, bird.y, 15, 0, Math.PI * 2);\n  ctx.fill();\n  \n  // Проверка границ\n  if (bird.y > canvas.height || bird.y < 0) {\n    gameOver();\n    return;\n  }\n  \n  requestAnimationFrame(gameLoop);\n}\n\nfunction gameOver() {\n  gameRunning = false;\n  document.getElementById('startBtn').style.display = 'block';\n  document.getElementById('startBtn').textContent = 'Играть снова';\n  ePhone.vibrate(200);\n}\n</script>"
}
