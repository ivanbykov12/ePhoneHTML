{
  "id": "game2048_system",
  "name": "2048",
  "icon": "material:grid_on",
  "color": "from-yellow-400 to-orange-500",
  "version": "2.0.0",
  "author": "ePhone System",
  "description": "Игра 2048",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "v2.0 - Полный функционал с анимациями и свайпами",
  "code": "<div class=\"game2048\"><h1><span class=\"material-icons\">grid_on</span> 2048</h1><div class=\"stats\"><div class=\"score-box\"><div class=\"score-label\">СЧЁТ</div><div class=\"score-value\" id=\"score\">0</div></div><div class=\"score-box\"><div class=\"score-label\">ЛУЧШИЙ</div><div class=\"score-value\" id=\"highscore\">0</div></div></div><div id=\"grid\" class=\"grid\"></div><div class=\"controls\"><button onclick=\"move('up')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_upward</span></button><div class=\"ctrl-row\"><button onclick=\"move('left')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_back</span></button><button onclick=\"move('down')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_downward</span></button><button onclick=\"move('right')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_forward</span></button></div></div><button onclick=\"resetGame()\" class=\"reset-btn\"><span class=\"material-icons\">refresh</span> Новая игра</button><div id=\"gameOverMsg\" class=\"game-over-msg hidden\"></div></div><style>.game2048{padding:15px;text-align:center}.game2048 h1{font-size:20px;margin-bottom:10px;display:flex;align-items:center;justify-content:center;gap:8px}.stats{display:flex;justify-content:center;gap:10px;margin-bottom:15px}.score-box{background:rgba(128,128,128,0.3);padding:8px 16px;border-radius:8px;min-width:80px}.score-label{font-size:10px;opacity:0.7;letter-spacing:1px}.score-value{font-size:20px;font-weight:bold;color:#ffd700}.grid{display:grid;grid-template-columns:repeat(4,70px);gap:8px;background:rgba(128,128,128,0.3);padding:8px;border-radius:12px;margin:0 auto 15px;width:fit-content}.tile{width:70px;height:70px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:bold;transition:all 0.15s}.controls{display:flex;flex-direction:column;align-items:center;gap:5px;margin-bottom:15px}.ctrl-row{display:flex;gap:5px}.ctrl-btn{width:50px;height:50px;border:none;border-radius:12px;background:rgba(128,128,128,0.3);cursor:pointer;display:flex;align-items:center;justify-content:center}.ctrl-btn:active{transform:scale(0.9)}.reset-btn{padding:10px 24px;background:linear-gradient(135deg,#ff9500,#ff6b00);color:white;border:none;border-radius:25px;font-size:14px;font-weight:bold;cursor:pointer;display:inline-flex;align-items:center;gap:5px}.game-over-msg{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.9);padding:30px;border-radius:16px;text-align:center;z-index:100}.game-over-msg h2{font-size:24px;margin-bottom:10px}.hidden{display:none!important}</style><script>var settings=ePhone.getSettings();document.querySelector('.game2048').style.color=settings.darkMode?'white':'black';var grid=Array(4).fill().map(function(){return Array(4).fill(0)});var score=0;var highscore=ePhone.load('2048_highscore')||0;var hasWon=false;document.getElementById('highscore').textContent=highscore;var tileColors={0:['rgba(128,128,128,0.2)','transparent'],2:['#eee4da','#776e65'],4:['#ede0c8','#776e65'],8:['#f2b179','#fff'],16:['#f59563','#fff'],32:['#f67c5f','#fff'],64:['#f65e3b','#fff'],128:['#edcf72','#fff'],256:['#edcc61','#fff'],512:['#edc850','#fff'],1024:['#edc53f','#fff'],2048:['#edc22e','#fff']};function addRandom(){var empty=[];for(var r=0;r<4;r++){for(var c=0;c<4;c++){if(grid[r][c]===0)empty.push([r,c])}}if(empty.length===0)return;var pos=empty[Math.floor(Math.random()*empty.length)];grid[pos[0]][pos[1]]=Math.random()<0.9?2:4}function draw(){var gridEl=document.getElementById('grid');gridEl.innerHTML='';grid.forEach(function(row){row.forEach(function(val){var tile=document.createElement('div');tile.className='tile';var colors=tileColors[val]||['#3c3a32','#fff'];tile.style.background=colors[0];tile.style.color=colors[1];if(val>=1024)tile.style.fontSize='18px';if(val>=128)tile.style.boxShadow='0 0 15px rgba(255,200,0,0.3)';tile.textContent=val||'';gridEl.appendChild(tile)})})}function slide(row){var arr=row.filter(function(x){return x!==0});var moved=false;for(var i=0;i<arr.length-1;i++){if(arr[i]===arr[i+1]){arr[i]*=2;score+=arr[i];arr.splice(i+1,1);moved=true;if(arr[i]===2048&&!hasWon){hasWon=true;showGameOver(true)}}}while(arr.length<4)arr.push(0);for(var j=0;j<4;j++){if(arr[j]!==row[j])moved=true}return{result:arr,moved:moved}}function move(dir){var oldGrid=JSON.stringify(grid);if(dir==='left'){grid=grid.map(function(row){return slide(row).result})}else if(dir==='right'){grid=grid.map(function(row){return slide(row.slice().reverse()).result.reverse()})}else if(dir==='up'){for(var c=0;c<4;c++){var col=[grid[0][c],grid[1][c],grid[2][c],grid[3][c]];col=slide(col).result;for(var r=0;r<4;r++)grid[r][c]=col[r]}}else if(dir==='down'){for(var c2=0;c2<4;c2++){var col2=[grid[3][c2],grid[2][c2],grid[1][c2],grid[0][c2]];col2=slide(col2).result;for(var r2=0;r2<4;r2++)grid[3-r2][c2]=col2[r2]}}if(JSON.stringify(grid)!==oldGrid){addRandom();document.getElementById('score').textContent=score;if(score>highscore){highscore=score;document.getElementById('highscore').textContent=highscore;ePhone.save('2048_highscore',highscore)}draw();ePhone.vibrate(30);checkGameOver()}}function checkGameOver(){for(var r=0;r<4;r++){for(var c=0;c<4;c++){if(grid[r][c]===0)return;if(c<3&&grid[r][c]===grid[r][c+1])return;if(r<3&&grid[r][c]===grid[r+1][c])return}}showGameOver(false)}function showGameOver(won){var msg=document.getElementById('gameOverMsg');msg.innerHTML=won?'<h2>🎉 Победа!</h2><p>Вы достигли 2048!</p><button onclick=\"this.parentElement.classList.add(\\'hidden\\')\" style=\"margin-top:15px;padding:10px 20px;background:#34c759;border:none;border-radius:20px;color:white;font-weight:bold;cursor:pointer;\">Продолжить</button>':'<h2>💀 Игра окончена</h2><p>Счёт: '+score+'</p><button onclick=\"resetGame()\" style=\"margin-top:15px;padding:10px 20px;background:#ff9500;border:none;border-radius:20px;color:white;font-weight:bold;cursor:pointer;\">Заново</button>';msg.classList.remove('hidden');ePhone.vibrate(200)}function resetGame(){grid=Array(4).fill().map(function(){return Array(4).fill(0)});score=0;hasWon=false;document.getElementById('score').textContent=score;document.getElementById('gameOverMsg').classList.add('hidden');addRandom();addRandom();draw()}document.addEventListener('keydown',function(e){if(e.key==='ArrowLeft')move('left');else if(e.key==='ArrowRight')move('right');else if(e.key==='ArrowUp')move('up');else if(e.key==='ArrowDown')move('down')});var touchStartX,touchStartY;var gridEl=document.getElementById('grid');gridEl.addEventListener('touchstart',function(e){touchStartX=e.touches[0].clientX;touchStartY=e.touches[0].clientY});gridEl.addEventListener('touchend',function(e){if(!touchStartX||!touchStartY)return;var dx=e.changedTouches[0].clientX-touchStartX;var dy=e.changedTouches[0].clientY-touchStartY;var absDx=Math.abs(dx);var absDy=Math.abs(dy);if(Math.max(absDx,absDy)<30)return;if(absDx>absDy){move(dx>0?'right':'left')}else{move(dy>0?'down':'up')}touchStartX=null;touchStartY=null});resetGame();</script>"
}
