{
  "id": "game2048_system",
  "name": "2048",
  "icon": "material:grid_on",
  "color": "from-yellow-400 to-orange-500",
  "version": "2.0.0",
  "author": "ePhone System",
  "description": "Игра 2048",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "v2.0 - Полный функционал с анимациями и свайпами",
  "code": "<!--\n⚠️ СИСТЕМНОЕ ПРИЛОЖЕНИЕ - НЕ УДАЛЯТЬ:\n- Grid элемент с id=\"grid\" (4x4)\n- Функции: addRandom(), draw(), slide(), move(), resetGame(), checkGameOver()\n- Переменные: grid (4x4 массив), score, highscore\n- ePhone.save('2048_highscore') - сохранение рекорда\n- Обработчики свайпов и клавиатуры\n-->\n<div class=\"game2048\">\n  <h1><span class=\"material-icons\">grid_on</span> 2048</h1>\n  <div class=\"stats\">\n    <div class=\"score-box\">\n      <div class=\"score-label\">СЧЁТ</div>\n      <div class=\"score-value\" id=\"score\">0</div>\n    </div>\n    <div class=\"score-box\">\n      <div class=\"score-label\">ЛУЧШИЙ</div>\n      <div class=\"score-value\" id=\"highscore\">0</div>\n    </div>\n  </div>\n  <div id=\"grid\" class=\"grid\"></div>\n  <div class=\"controls\">\n    <button onclick=\"move('up')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_upward</span></button>\n    <div class=\"ctrl-row\">\n      <button onclick=\"move('left')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_back</span></button>\n      <button onclick=\"move('down')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_downward</span></button>\n      <button onclick=\"move('right')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_forward</span></button>\n    </div>\n  </div>\n  <button onclick=\"resetGame()\" class=\"reset-btn\"><span class=\"material-icons\">refresh</span> Новая игра</button>\n  <div id=\"gameOverMsg\" class=\"game-over-msg hidden\"></div>\n</div>\n\n<style>\n.game2048 { padding: 15px; text-align: center; }\n.game2048 h1 { font-size: 20px; margin-bottom: 10px; display: flex; align-items: center; justify-content: center; gap: 8px; }\n.stats { display: flex; justify-content: center; gap: 10px; margin-bottom: 15px; }\n.score-box { background: rgba(128,128,128,0.3); padding: 8px 16px; border-radius: 8px; min-width: 80px; }\n.score-label { font-size: 10px; opacity: 0.7; letter-spacing: 1px; }\n.score-value { font-size: 20px; font-weight: bold; color: #ffd700; }\n.grid { display: grid; grid-template-columns: repeat(4, 70px); gap: 8px; background: rgba(128,128,128,0.3); padding: 8px; border-radius: 12px; margin: 0 auto 15px; width: fit-content; }\n.tile { width: 70px; height: 70px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: bold; transition: all 0.15s; }\n.controls { display: flex; flex-direction: column; align-items: center; gap: 5px; margin-bottom: 15px; }\n.ctrl-row { display: flex; gap: 5px; }\n.ctrl-btn { width: 50px; height: 50px; border: none; border-radius: 12px; background: rgba(128,128,128,0.3); cursor: pointer; display: flex; align-items: center; justify-content: center; }\n.ctrl-btn:active { transform: scale(0.9); }\n.reset-btn { padding: 10px 24px; background: linear-gradient(135deg, #ff9500, #ff6b00); color: white; border: none; border-radius: 25px; font-size: 14px; font-weight: bold; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; }\n.game-over-msg { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(0,0,0,0.9); padding: 30px; border-radius: 16px; text-align: center; z-index: 100; }\n.game-over-msg h2 { font-size: 24px; margin-bottom: 10px; }\n.hidden { display: none !important; }\n</style>\n\n<script>\n// ⚠️ НЕ УДАЛЯТЬ: Инициализация\nconst settings = ePhone.getSettings();\ndocument.querySelector('.game2048').style.color = settings.darkMode ? 'white' : 'black';\n\n// ⚠️ НЕ УДАЛЯТЬ: Игровые переменные\nlet grid = Array(4).fill().map(() => Array(4).fill(0));\nlet score = 0;\nlet highscore = ePhone.load('2048_highscore') || 0;\nlet hasWon = false;\ndocument.getElementById('highscore').textContent = highscore;\n\n// ⚠️ НЕ УДАЛЯТЬ: Цвета плиток\nconst tileColors = {\n  0: ['rgba(128,128,128,0.2)', 'transparent'],\n  2: ['#eee4da', '#776e65'],\n  4: ['#ede0c8', '#776e65'],\n  8: ['#f2b179', '#fff'],\n  16: ['#f59563', '#fff'],\n  32: ['#f67c5f', '#fff'],\n  64: ['#f65e3b', '#fff'],\n  128: ['#edcf72', '#fff'],\n  256: ['#edcc61', '#fff'],\n  512: ['#edc850', '#fff'],\n  1024: ['#edc53f', '#fff'],\n  2048: ['#edc22e', '#fff']\n};\n\n// ⚠️ НЕ УДАЛЯТЬ: Добавление случайной плитки\nfunction addRandom() {\n  const empty = [];\n  for (let r = 0; r < 4; r++) {\n    for (let c = 0; c < 4; c++) {\n      if (grid[r][c] === 0) empty.push([r, c]);\n    }\n  }\n  if (empty.length === 0) return;\n  const [r, c] = empty[Math.floor(Math.random() * empty.length)];\n  grid[r][c] = Math.random() < 0.9 ? 2 : 4;\n}\n\n// ⚠️ НЕ УДАЛЯТЬ: Отрисовка\nfunction draw() {\n  const gridEl = document.getElementById('grid');\n  gridEl.innerHTML = '';\n  grid.forEach(row => {\n    row.forEach(val => {\n      const tile = document.createElement('div');\n      tile.className = 'tile';\n      const colors = tileColors[val] || ['#3c3a32', '#fff'];\n      tile.style.background = colors[0];\n      tile.style.color = colors[1];\n      if (val >= 1024) tile.style.fontSize = '18px';\n      if (val >= 128) tile.style.boxShadow = '0 0 15px rgba(255,200,0,0.3)';\n      tile.textContent = val || '';\n      gridEl.appendChild(tile);\n    });\n  });\n}\n\n// ⚠️ НЕ УДАЛЯТЬ: Сдвиг строки\nfunction slide(row) {\n  let arr = row.filter(x => x !== 0);\n  let moved = false;\n  for (let i = 0; i < arr.length - 1; i++) {\n    if (arr[i] === arr[i + 1]) {\n      arr[i] *= 2;\n      score += arr[i];\n      arr.splice(i + 1, 1);\n      moved = true;\n      // Проверка победы\n      if (arr[i] === 2048 && !hasWon) {\n        hasWon = true;\n        showGameOver(true);\n      }\n    }\n  }\n  while (arr.length < 4) arr.push(0);\n  // Проверка изменилась ли строка\n  for (let i = 0; i < 4; i++) {\n    if (arr[i] !== row[i]) moved = true;\n  }\n  return { result: arr, moved: moved };\n}\n\n// ⚠️ НЕ УДАЛЯТЬ: Движение\nfunction move(dir) {\n  const oldGrid = JSON.stringify(grid);\n  \n  if (dir === 'left') {\n    grid = grid.map(row => slide(row).result);\n  } else if (dir === 'right') {\n    grid = grid.map(row => slide(row.reverse()).result.reverse());\n  } else if (dir === 'up') {\n    for (let c = 0; c < 4; c++) {\n      let col = [grid[0][c], grid[1][c], grid[2][c], grid[3][c]];\n      col = slide(col).result;\n      for (let r = 0; r < 4; r++) grid[r][c] = col[r];\n    }\n  } else if (dir === 'down') {\n    for (let c = 0; c < 4; c++) {\n      let col = [grid[3][c], grid[2][c], grid[1][c], grid[0][c]];\n      col = slide(col).result;\n      for (let r = 0; r < 4; r++) grid[3 - r][c] = col[r];\n    }\n  }\n  \n  if (JSON.stringify(grid) !== oldGrid) {\n    addRandom();\n    document.getElementById('score').textContent = score;\n    if (score > highscore) {\n      highscore = score;\n      document.getElementById('highscore').textContent = highscore;\n      ePhone.save('2048_highscore', highscore);\n    }\n    draw();\n    ePhone.vibrate(30);\n    checkGameOver();\n  }\n}\n\n// ⚠️ НЕ УДАЛЯТЬ: Проверка конца игры\nfunction checkGameOver() {\n  // Есть ли пустые клетки\n  for (let r = 0; r < 4; r++) {\n    for (let c = 0; c < 4; c++) {\n      if (grid[r][c] === 0) return;\n      if (c < 3 && grid[r][c] === grid[r][c + 1]) return;\n      if (r < 3 && grid[r][c] === grid[r + 1][c]) return;\n    }\n  }\n  showGameOver(false);\n}\n\nfunction showGameOver(won) {\n  const msg = document.getElementById('gameOverMsg');\n  msg.innerHTML = won ? \n    '<h2>🎉 Победа!</h2><p>Вы достигли 2048!</p><button onclick=\"this.parentElement.classList.add(\\'hidden\\')\" style=\"margin-top:15px;padding:10px 20px;background:#34c759;border:none;border-radius:20px;color:white;font-weight:bold;cursor:pointer;\">Продолжить</button>' :\n    '<h2>💀 Игра окончена</h2><p>Счёт: ' + score + '</p><button onclick=\"resetGame()\" style=\"margin-top:15px;padding:10px 20px;background:#ff9500;border:none;border-radius:20px;color:white;font-weight:bold;cursor:pointer;\">Заново</button>';\n  msg.classList.remove('hidden');\n  ePhone.vibrate(200);\n}\n\n// ⚠️ НЕ УДАЛЯТЬ: Сброс игры\nfunction resetGame() {\n  grid = Array(4).fill().map(() => Array(4).fill(0));\n  score = 0;\n  hasWon = false;\n  document.getElementById('score').textContent = score;\n  document.getElementById('gameOverMsg').classList.add('hidden');\n  addRandom();\n  addRandom();\n  draw();\n}\n\n// ⚠️ НЕ УДАЛЯТЬ: Клавиатура\ndocument.addEventListener('keydown', function(e) {\n  if (e.key === 'ArrowLeft') move('left');\n  else if (e.key === 'ArrowRight') move('right');\n  else if (e.key === 'ArrowUp') move('up');\n  else if (e.key === 'ArrowDown') move('down');\n});\n\n// ⚠️ НЕ УДАЛЯТЬ: Свайпы\nlet touchStartX, touchStartY;\nconst gridEl = document.getElementById('grid');\ngridEl.addEventListener('touchstart', function(e) {\n  touchStartX = e.touches[0].clientX;\n  touchStartY = e.touches[0].clientY;\n});\ngridEl.addEventListener('touchend', function(e) {\n  if (!touchStartX || !touchStartY) return;\n  const dx = e.changedTouches[0].clientX - touchStartX;\n  const dy = e.changedTouches[0].clientY - touchStartY;\n  const absDx = Math.abs(dx);\n  const absDy = Math.abs(dy);\n  if (Math.max(absDx, absDy) < 30) return;\n  if (absDx > absDy) {\n    move(dx > 0 ? 'right' : 'left');\n  } else {\n    move(dy > 0 ? 'down' : 'up');\n  }\n  touchStartX = null;\n  touchStartY = null;\n});\n\nresetGame();\n</script>"
}
