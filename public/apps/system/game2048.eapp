{
  "id": "game2048_system",
  "name": "2048",
  "icon": "material:grid_on",
  "color": "from-yellow-400 to-orange-500",
  "version": "3.0.0",
  "author": "ePhone System",
  "description": "Игра 2048 с новым дизайном",
  "supportedModels": [
    "iphone8",
    "iphonex",
    "iphone14",
    "epad101"
  ],
  "isSystem": true,
  "eappVersion": "1.1",
  "code": "<div class=\"app\"><div class=\"header\"><span class=\"material-icons\">grid_on</span><h1>2048</h1></div><div class=\"stats\"><div class=\"stat-box\"><div class=\"stat-label\">СЧЁТ</div><div class=\"stat-value\" id=\"score\">0</div></div><div class=\"stat-box\"><div class=\"stat-label\">ЛУЧШИЙ</div><div class=\"stat-value gold\" id=\"highscore\">0</div></div></div><div id=\"grid\" class=\"grid\"></div><div class=\"controls\"><button onclick=\"mv('u')\" class=\"ctrl\"><span class=\"material-icons\">keyboard_arrow_up</span></button><div class=\"ctrl-row\"><button onclick=\"mv('l')\" class=\"ctrl\"><span class=\"material-icons\">keyboard_arrow_left</span></button><button onclick=\"mv('d')\" class=\"ctrl\"><span class=\"material-icons\">keyboard_arrow_down</span></button><button onclick=\"mv('r')\" class=\"ctrl\"><span class=\"material-icons\">keyboard_arrow_right</span></button></div></div><button onclick=\"reset()\" class=\"btn-play\"><span class=\"material-icons\">refresh</span> Новая игра</button><div id=\"gameOverMsg\" class=\"modal hidden\"></div></div><style>.app{padding:15px;height:100%;display:flex;flex-direction:column;align-items:center;background:linear-gradient(135deg,#0a0a0a 0%,#1a1a2e 50%,#16213e 100%)}.header{display:flex;align-items:center;gap:8px;margin-bottom:12px;color:white}.header h1{font-size:20px;font-weight:600}.stats{display:flex;gap:12px;margin-bottom:15px}.stat-box{background:rgba(255,255,255,0.06);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:14px;padding:8px 20px;text-align:center}.stat-label{font-size:9px;color:rgba(255,255,255,0.5);letter-spacing:1px}.stat-value{font-size:22px;font-weight:700;color:white}.stat-value.gold{color:#ffd700}.grid{display:grid;grid-template-columns:repeat(4,68px);gap:8px;background:rgba(255,255,255,0.06);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);padding:8px;border-radius:16px;margin-bottom:15px;box-shadow:0 8px 32px rgba(0,0,0,0.3)}.tile{width:68px;height:68px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700;transition:all 0.15s;box-shadow:0 2px 8px rgba(0,0,0,0.2)}.controls{display:flex;flex-direction:column;align-items:center;gap:4px;margin-bottom:12px}.ctrl-row{display:flex;gap:4px}.ctrl{width:48px;height:48px;border:none;border-radius:14px;background:rgba(255,255,255,0.08);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.1);color:white;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.15s}.ctrl:active{transform:scale(0.9);background:rgba(255,255,255,0.15)}.btn-play{padding:12px 36px;background:linear-gradient(135deg,#fa8231,#fc5c65);color:white;border:none;border-radius:25px;font-size:15px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:6px;box-shadow:0 4px 15px rgba(252,92,101,0.3);transition:all 0.2s}.btn-play:active{transform:scale(0.95)}.modal{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.9);backdrop-filter:blur(20px);padding:30px;border-radius:20px;text-align:center;color:white;z-index:100;border:1px solid rgba(255,255,255,0.1)}.modal h2{font-size:24px;margin-bottom:10px}.modal p{opacity:0.7;margin-bottom:15px}.hidden{display:none!important}</style><script>var s=ePhone.getSettings();document.querySelector('.app').style.color='white';var grid=Array(4).fill().map(function(){return Array(4).fill(0)});var score=0,highscore=ePhone.load('2048_hs')||0,hasWon=false;document.getElementById('highscore').textContent=highscore;var tc={0:['rgba(255,255,255,0.05)','transparent'],2:['#eee4da','#776e65'],4:['#ede0c8','#776e65'],8:['#f2b179','#fff'],16:['#f59563','#fff'],32:['#f67c5f','#fff'],64:['#f65e3b','#fff'],128:['#edcf72','#fff'],256:['#edcc61','#fff'],512:['#edc850','#fff'],1024:['#edc53f','#fff'],2048:['#edc22e','#fff']};function addRandom(){var empty=[];for(var r=0;r<4;r++){for(var c=0;c<4;c++){if(grid[r][c]===0)empty.push([r,c])}}if(empty.length===0)return;var pos=empty[Math.floor(Math.random()*empty.length)];grid[pos[0]][pos[1]]=Math.random()<0.9?2:4}function draw(){var gridEl=document.getElementById('grid');gridEl.innerHTML='';grid.forEach(function(row){row.forEach(function(val){var tile=document.createElement('div');tile.className='tile';var colors=tc[val]||['#3c3a32','#fff'];tile.style.background=colors[0];tile.style.color=colors[1];if(val>=1024)tile.style.fontSize='18px';if(val>=128)tile.style.boxShadow='0 0 20px rgba(255,200,0,0.4)';tile.textContent=val||'';gridEl.appendChild(tile)})})}function slide(row){var arr=row.filter(function(x){return x!==0});var moved=false;for(var i=0;i<arr.length-1;i++){if(arr[i]===arr[i+1]){arr[i]*=2;score+=arr[i];arr.splice(i+1,1);moved=true;if(arr[i]===2048&&!hasWon){hasWon=true;showGameOver(true)}}}while(arr.length<4)arr.push(0);for(var j=0;j<4;j++){if(arr[j]!==row[j])moved=true}return{result:arr,moved:moved}}function mv(dir){var oldGrid=JSON.stringify(grid);if(dir==='l'){grid=grid.map(function(row){return slide(row).result})}else if(dir==='r'){grid=grid.map(function(row){return slide(row.slice().reverse()).result.reverse()})}else if(dir==='u'){for(var c=0;c<4;c++){var col=[grid[0][c],grid[1][c],grid[2][c],grid[3][c]];col=slide(col).result;for(var r=0;r<4;r++)grid[r][c]=col[r]}}else if(dir==='d'){for(var c2=0;c2<4;c2++){var col2=[grid[3][c2],grid[2][c2],grid[1][c2],grid[0][c2]];col2=slide(col2).result;for(var r2=0;r2<4;r2++)grid[3-r2][c2]=col2[r2]}}if(JSON.stringify(grid)!==oldGrid){addRandom();document.getElementById('score').textContent=score;if(score>highscore){highscore=score;document.getElementById('highscore').textContent=highscore;ePhone.save('2048_hs',highscore)}draw();ePhone.vibrate(30);checkGameOver()}}function checkGameOver(){for(var r=0;r<4;r++){for(var c=0;c<4;c++){if(grid[r][c]===0)return;if(c<3&&grid[r][c]===grid[r][c+1])return;if(r<3&&grid[r][c]===grid[r+1][c])return}}showGameOver(false)}function showGameOver(won){var msg=document.getElementById('gameOverMsg');msg.innerHTML=won?'<h2>🎉 Победа!</h2><p>Вы достигли 2048!</p><button onclick=\"this.parentElement.classList.add(&apos;hidden&apos;)\" style=\"margin-top:15px;padding:10px 24px;background:linear-gradient(135deg,#00b894,#00cec9);border:none;border-radius:20px;color:white;font-weight:bold;cursor:pointer;\">Продолжить</button>':'<h2>💀 Игра окончена</h2><p>Счёт: '+score+'</p><button onclick=\"reset()\" style=\"margin-top:15px;padding:10px 24px;background:linear-gradient(135deg,#fa8231,#fc5c65);border:none;border-radius:20px;color:white;font-weight:bold;cursor:pointer;\">Заново</button>';msg.classList.remove('hidden');ePhone.vibrate(200)}function reset(){grid=Array(4).fill().map(function(){return Array(4).fill(0)});score=0;hasWon=false;document.getElementById('score').textContent=score;document.getElementById('gameOverMsg').classList.add('hidden');addRandom();addRandom();draw()}document.addEventListener('keydown',function(e){if(e.key==='ArrowLeft')mv('l');else if(e.key==='ArrowRight')mv('r');else if(e.key==='ArrowUp')mv('u');else if(e.key==='ArrowDown')mv('d')});var touchStartX,touchStartY;var gridEl=document.getElementById('grid');gridEl.addEventListener('touchstart',function(e){touchStartX=e.touches[0].clientX;touchStartY=e.touches[0].clientY});gridEl.addEventListener('touchend',function(e){if(!touchStartX||!touchStartY)return;var dx=e.changedTouches[0].clientX-touchStartX;var dy=e.changedTouches[0].clientY-touchStartY;var absDx=Math.abs(dx);var absDy=Math.abs(dy);if(Math.max(absDx,absDy)<30)return;if(absDx>absDy){mv(dx>0?'r':'l')}else{mv(dy>0?'d':'u')}touchStartX=null;touchStartY=null});reset();</script>"
}