{
  "id": "game2048_system",
  "name": "2048",
  "icon": "material:grid_on",
  "color": "from-yellow-400 to-orange-500",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Игра 2048",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "code": "<div class=\"game2048\">\n  <h1><span class=\"material-icons\">grid_on</span> 2048</h1>\n  <div class=\"stats\">\n    <span>Счёт: <span id=\"score\">0</span></span>\n    <span>Рекорд: <span id=\"highscore\">0</span></span>\n  </div>\n  <div id=\"grid\" class=\"grid\"></div>\n  <div class=\"controls\">\n    <button onclick=\"move('up')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_upward</span></button>\n    <div class=\"ctrl-row\">\n      <button onclick=\"move('left')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_back</span></button>\n      <button onclick=\"move('down')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_downward</span></button>\n      <button onclick=\"move('right')\" class=\"ctrl-btn\"><span class=\"material-icons\">arrow_forward</span></button>\n    </div>\n  </div>\n  <button onclick=\"resetGame()\" class=\"reset-btn\">Новая игра</button>\n</div>\n\n<style>\n.game2048 {\n  padding: 20px;\n  text-align: center;\n}\n.game2048 h1 {\n  font-size: 20px;\n  margin-bottom: 10px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n}\n.stats {\n  display: flex;\n  justify-content: space-around;\n  margin-bottom: 15px;\n  font-size: 14px;\n}\n.grid {\n  display: grid;\n  grid-template-columns: repeat(4, 70px);\n  gap: 8px;\n  background: rgba(128,128,128,0.3);\n  padding: 8px;\n  border-radius: 12px;\n  margin: 0 auto 15px;\n  width: fit-content;\n}\n.tile {\n  width: 70px;\n  height: 70px;\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 24px;\n  font-weight: bold;\n  transition: all 0.1s;\n}\n.controls {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 5px;\n  margin-bottom: 15px;\n}\n.ctrl-row {\n  display: flex;\n  gap: 5px;\n}\n.ctrl-btn {\n  width: 50px;\n  height: 50px;\n  border: none;\n  border-radius: 12px;\n  background: rgba(128,128,128,0.3);\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.reset-btn {\n  padding: 12px 32px;\n  background: linear-gradient(135deg, #ff9500, #ff6b00);\n  color: white;\n  border: none;\n  border-radius: 25px;\n  font-size: 16px;\n  font-weight: bold;\n  cursor: pointer;\n}\n</style>\n\n<script>\nconst settings = ePhone.getSettings();\nconst container = document.querySelector('.game2048');\ncontainer.style.color = settings.darkMode ? 'white' : 'black';\n\nlet grid = Array(4).fill().map(() => Array(4).fill(0));\nlet score = 0;\nlet highscore = ePhone.load('2048_highscore') || 0;\ndocument.getElementById('highscore').textContent = highscore;\n\nconst tileColors = {\n  0: 'rgba(128,128,128,0.2)',\n  2: '#eee4da', 4: '#ede0c8', 8: '#f2b179',\n  16: '#f59563', 32: '#f67c5f', 64: '#f65e3b',\n  128: '#edcf72', 256: '#edcc61', 512: '#edc850',\n  1024: '#edc53f', 2048: '#edc22e'\n};\n\nfunction addRandom() {\n  const empty = [];\n  for (let r = 0; r < 4; r++) {\n    for (let c = 0; c < 4; c++) {\n      if (grid[r][c] === 0) empty.push([r, c]);\n    }\n  }\n  if (empty.length === 0) return;\n  const [r, c] = empty[Math.floor(Math.random() * empty.length)];\n  grid[r][c] = Math.random() < 0.9 ? 2 : 4;\n}\n\nfunction draw() {\n  const gridEl = document.getElementById('grid');\n  gridEl.innerHTML = '';\n  grid.forEach(row => {\n    row.forEach(val => {\n      const tile = document.createElement('div');\n      tile.className = 'tile';\n      tile.style.background = tileColors[val] || '#3c3a32';\n      tile.style.color = val > 4 ? 'white' : '#776e65';\n      tile.textContent = val || '';\n      gridEl.appendChild(tile);\n    });\n  });\n}\n\nfunction slide(row) {\n  let arr = row.filter(x => x !== 0);\n  for (let i = 0; i < arr.length - 1; i++) {\n    if (arr[i] === arr[i + 1]) {\n      arr[i] *= 2;\n      score += arr[i];\n      arr.splice(i + 1, 1);\n    }\n  }\n  while (arr.length < 4) arr.push(0);\n  return arr;\n}\n\nfunction move(dir) {\n  const oldGrid = JSON.stringify(grid);\n  \n  if (dir === 'left') {\n    grid = grid.map(row => slide(row));\n  } else if (dir === 'right') {\n    grid = grid.map(row => slide(row.reverse()).reverse());\n  } else if (dir === 'up') {\n    for (let c = 0; c < 4; c++) {\n      let col = [grid[0][c], grid[1][c], grid[2][c], grid[3][c]];\n      col = slide(col);\n      for (let r = 0; r < 4; r++) grid[r][c] = col[r];\n    }\n  } else if (dir === 'down') {\n    for (let c = 0; c < 4; c++) {\n      let col = [grid[3][c], grid[2][c], grid[1][c], grid[0][c]];\n      col = slide(col);\n      for (let r = 0; r < 4; r++) grid[3 - r][c] = col[r];\n    }\n  }\n  \n  if (JSON.stringify(grid) !== oldGrid) {\n    addRandom();\n    document.getElementById('score').textContent = score;\n    if (score > highscore) {\n      highscore = score;\n      document.getElementById('highscore').textContent = highscore;\n      ePhone.save('2048_highscore', highscore);\n    }\n    draw();\n    ePhone.vibrate(50);\n  }\n}\n\nfunction resetGame() {\n  grid = Array(4).fill().map(() => Array(4).fill(0));\n  score = 0;\n  document.getElementById('score').textContent = score;\n  addRandom();\n  addRandom();\n  draw();\n}\n\nresetGame();\n</script>"
}
