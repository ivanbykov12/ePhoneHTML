{
  "id": "health_system",
  "name": "Здоровье",
  "icon": "material:favorite",
  "color": "from-red-400 to-red-600",
  "version": "3.0.0",
  "author": "ePhone System",
  "description": "Здоровье и фитнес с новым дизайном",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "eappVersion": "1.1",
  "code": "<div class=\"app\"><div class=\"header\"><span class=\"material-icons\">favorite</span><h1>Здоровье</h1></div><div class=\"stats-grid\"><div class=\"stat-card steps\"><div class=\"stat-icon\"><span class=\"material-icons\">directions_walk</span></div><div class=\"stat-value\" id=\"steps\">7,842</div><div class=\"stat-label\">Шаги</div><div class=\"stat-progress\"><div class=\"progress-bar\" style=\"width:78%\"></div></div></div><div class=\"stat-card heart\"><div class=\"stat-icon\"><span class=\"material-icons\">monitor_heart</span></div><div class=\"stat-value\" id=\"heartRate\">72 <span style=\"font-size:12px\">уд/м</span></div><div class=\"stat-label\">Пульс</div></div><div class=\"stat-card calories\"><div class=\"stat-icon\"><span class=\"material-icons\">local_fire_department</span></div><div class=\"stat-value\">456</div><div class=\"stat-label\">Калории</div></div><div class=\"stat-card sleep\"><div class=\"stat-icon\"><span class=\"material-icons\">bedtime</span></div><div class=\"stat-value\">7.5ч</div><div class=\"stat-label\">Сон</div></div></div><div class=\"water-tracker\"><div class=\"water-header\"><span class=\"material-icons\">water_drop</span><span>Вода: <span id=\"waterCount\">5</span>/8 стаканов</span></div><div class=\"water-cups\" id=\"waterCups\"></div></div></div><style>.app{padding:20px;height:100%;overflow-y:auto;background:linear-gradient(135deg,#0a0a0a 0%,#1a1a2e 100%);color:white}.header{display:flex;align-items:center;gap:8px;margin-bottom:20px}.header h1{font-size:24px;font-weight:600}.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px}.stat-card{padding:15px;border-radius:16px;color:white;box-shadow:0 8px 32px rgba(0,0,0,0.3)}.stat-card.steps{background:linear-gradient(135deg,#fa8231,#fc5c65)}.stat-card.heart{background:linear-gradient(135deg,#eb3b5a,#eb3b5a)}.stat-card.calories{background:linear-gradient(135deg,#fdcb6e,#f0932b)}.stat-card.sleep{background:linear-gradient(135deg,#6c5ce7,#a29bfe)}.stat-icon{margin-bottom:5px}.stat-value{font-size:24px;font-weight:700}.stat-label{font-size:12px;opacity:0.8}.stat-progress{margin-top:8px;height:4px;background:rgba(255,255,255,0.3);border-radius:2px;overflow:hidden}.progress-bar{height:100%;background:white;border-radius:2px}.water-tracker{background:rgba(255,255,255,0.06);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);padding:15px;border-radius:16px}.water-header{display:flex;align-items:center;gap:8px;margin-bottom:10px}.water-cups{display:flex;gap:8px}.water-cup{flex:1;height:30px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.1);border-radius:8px;cursor:pointer;transition:all 0.2s}.water-cup:active{transform:scale(0.95)}.water-cup.filled{background:linear-gradient(135deg,#0984e3,#74b9ff);border-color:#0984e3;box-shadow:0 2px 10px rgba(9,132,227,0.3)}</style><script>var s=ePhone.getSettings();var waterCount=5;function updateStats(){setInterval(function(){var steps=parseInt(document.getElementById('steps').textContent.replace(/,/g,''));document.getElementById('steps').textContent=(steps+Math.floor(Math.random()*5)).toLocaleString()},3000);setInterval(function(){document.getElementById('heartRate').innerHTML=(68+Math.floor(Math.random()*10))+' <span style=\"font-size:12px\">уд/м</span>'},3000)}function updateWater(){var cups=document.getElementById('waterCups');cups.innerHTML='';for(var i=0;i<8;i++){var cup=document.createElement('div');cup.className='water-cup'+(i<waterCount?' filled':'');cup.onclick=function(){var idx=Array.from(cups.children).indexOf(this);waterCount=idx+1;document.getElementById('waterCount').textContent=waterCount;updateWater()};cups.appendChild(cup)}}updateStats();updateWater();</script>"
}
