{
  "id": "health_system",
  "name": "Здоровье",
  "icon": "material:favorite",
  "color": "from-red-400 to-red-600",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Здоровье и фитнес",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "Системное приложение",
  "code": "<!--\n⚠️ СИСТЕМНОЕ ПРИЛОЖЕНИЕ - НЕ УДАЛЯТЬ:\n- Карточки статистики (шаги, пульс, калории, сон)\n- Трекер воды\n- Функции: updateStats(), updateWater()\n-->\n<div class=\"health-app\">\n  <h1><span class=\"material-icons\">favorite</span> Здоровье</h1>\n  <div class=\"stats-grid\">\n    <div class=\"stat-card steps\">\n      <div class=\"stat-icon\"><span class=\"material-icons\">directions_walk</span></div>\n      <div class=\"stat-value\" id=\"steps\">7,842</div>\n      <div class=\"stat-label\">Шаги</div>\n      <div class=\"stat-progress\"><div class=\"progress-bar\" style=\"width: 78%\"></div></div>\n    </div>\n    <div class=\"stat-card heart\">\n      <div class=\"stat-icon\"><span class=\"material-icons\">monitor_heart</span></div>\n      <div class=\"stat-value\" id=\"heartRate\">72 <span style=\"font-size: 12px;\">уд/м</span></div>\n      <div class=\"stat-label\">Пульс</div>\n    </div>\n    <div class=\"stat-card calories\">\n      <div class=\"stat-icon\"><span class=\"material-icons\">local_fire_department</span></div>\n      <div class=\"stat-value\">456</div>\n      <div class=\"stat-label\">Калории</div>\n    </div>\n    <div class=\"stat-card sleep\">\n      <div class=\"stat-icon\"><span class=\"material-icons\">bedtime</span></div>\n      <div class=\"stat-value\">7.5ч</div>\n      <div class=\"stat-label\">Сон</div>\n    </div>\n  </div>\n  <div class=\"water-tracker\">\n    <div class=\"water-header\">\n      <span class=\"material-icons\">water_drop</span>\n      <span>Вода: <span id=\"waterCount\">5</span>/8 стаканов</span>\n    </div>\n    <div class=\"water-cups\" id=\"waterCups\"></div>\n  </div>\n</div>\n\n<style>\n.health-app { padding: 20px; }\n.health-app h1 { font-size: 24px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }\n.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; }\n.stat-card { padding: 15px; border-radius: 12px; color: white; }\n.stat-card.steps { background: linear-gradient(135deg, #ff9500, #ff6b00); }\n.stat-card.heart { background: linear-gradient(135deg, #ff3b30, #d63030); }\n.stat-card.calories { background: linear-gradient(135deg, #ffcc00, #ff9500); }\n.stat-card.sleep { background: linear-gradient(135deg, #5856d6, #3634a3); }\n.stat-icon { margin-bottom: 5px; }\n.stat-value { font-size: 24px; font-weight: bold; }\n.stat-label { font-size: 12px; opacity: 0.8; }\n.stat-progress { margin-top: 8px; height: 4px; background: rgba(255,255,255,0.3); border-radius: 2px; overflow: hidden; }\n.progress-bar { height: 100%; background: white; }\n.water-tracker { background: rgba(128,128,128,0.2); padding: 15px; border-radius: 12px; }\n.water-header { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }\n.water-cups { display: flex; gap: 8px; }\n.water-cup { flex: 1; height: 30px; background: rgba(128,128,128,0.3); border-radius: 6px; cursor: pointer; transition: background 0.2s; }\n.water-cup.filled { background: #007aff; }\n</style>\n\n<script>\n// ⚠️ НЕ УДАЛЯТЬ: Инициализация\nconst settings = ePhone.getSettings();\ndocument.querySelector('.health-app').style.color = settings.darkMode ? 'white' : 'black';\n\nlet waterCount = 5;\n\n// ⚠️ НЕ УДАЛЯТЬ: Функции обновления\nfunction updateStats() {\n  // Симуляция обновления шагов\n  setInterval(() => {\n    const steps = parseInt(document.getElementById('steps').textContent.replace(',', ''));\n    document.getElementById('steps').textContent = (steps + Math.floor(Math.random() * 5)).toLocaleString();\n  }, 3000);\n  \n  // Симуляция пульса\n  setInterval(() => {\n    document.getElementById('heartRate').innerHTML = `${68 + Math.floor(Math.random() * 10)} <span style=\"font-size: 12px;\">уд/м</span>`;\n  }, 3000);\n}\n\nfunction updateWater() {\n  const cups = document.getElementById('waterCups');\n  cups.innerHTML = '';\n  for (let i = 0; i < 8; i++) {\n    const cup = document.createElement('div');\n    cup.className = `water-cup ${i < waterCount ? 'filled' : ''}`;\n    cup.onclick = () => {\n      waterCount = i + 1;\n      document.getElementById('waterCount').textContent = waterCount;\n      updateWater();\n    };\n    cups.appendChild(cup);\n  }\n}\n\nupdateStats();\nupdateWater();\n</script>"
}
