{"id": "messages_system", "name": "Сообщения", "icon": "material:chat", "color": "from-green-400 to-green-500", "version": "3.0.0", "author": "ePhone System", "description": "Сообщения с новым дизайном", "supportedModels": ["iphone8", "iphonex", "iphone14", "epad101"], "isSystem": true, "eappVersion": "1.1", "code": "<div class=\"app\"><div class=\"header\"><span class=\"material-icons\">chat</span><h1>Сообщения</h1></div><div class=\"chats-list\" id=\"chatsList\"></div><div id=\"modal\" class=\"modal hidden\"><div class=\"modal-content\"><h3 id=\"modalTitle\"></h3><p id=\"modalText\"></p><button onclick=\"closeModal()\" class=\"modal-btn\">OK</button></div></div></div><style>.app{padding:20px;height:100%;display:flex;flex-direction:column;background:linear-gradient(135deg,#0a0a0a 0%,#1a1a2e 100%);color:white}.header{display:flex;align-items:center;gap:8px;margin-bottom:20px}.header h1{font-size:24px;font-weight:600}.chats-list{display:flex;flex-direction:column;gap:10px;flex:1;overflow-y:auto}.chat-item{display:flex;align-items:center;gap:12px;padding:12px;background:rgba(255,255,255,0.06);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:14px;cursor:pointer;transition:all 0.2s}.chat-item:active{transform:scale(0.98);background:rgba(255,255,255,0.1)}.chat-avatar{width:50px;height:50px;background:linear-gradient(135deg,#00b894,#00cec9);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;box-shadow:0 4px 15px rgba(0,206,201,0.3)}.chat-info{flex:1}.chat-name{font-size:16px;font-weight:600}.chat-preview{font-size:14px;opacity:0.6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.chat-time{font-size:12px;opacity:0.4}.modal{position:fixed;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:center;z-index:1000}.modal.hidden{display:none}.modal-content{background:rgba(30,30,40,0.95);backdrop-filter:blur(40px);border:1px solid rgba(255,255,255,0.1);border-radius:20px;padding:25px;max-width:300px;text-align:center;animation:fadeIn 0.3s ease}@keyframes fadeIn{from{opacity:0;transform:scale(0.9)}to{opacity:1;transform:scale(1)}}.modal-content h3{margin-bottom:10px;font-size:18px}.modal-content p{opacity:0.6;margin-bottom:20px}.modal-btn{padding:12px 36px;background:linear-gradient(135deg,#00b894,#00cec9);color:white;border:none;border-radius:20px;font-weight:600;cursor:pointer;box-shadow:0 4px 15px rgba(0,206,201,0.3);transition:all 0.2s}.modal-btn:active{transform:scale(0.95)}</style><script>var s=ePhone.getSettings();var chats=[{id:1,name:'Мама',avatar:'👩',lastMessage:'Позвони когда будешь свободен',time:'12:30',unread:2},{id:2,name:'Андрей',avatar:'👨',lastMessage:'Го в кино вечером?',time:'11:45',unread:1},{id:3,name:'Работа',avatar:'💼',lastMessage:'Встреча в 15:00',time:'10:00',unread:0},{id:4,name:'Доставка',avatar:'📦',lastMessage:'Ваш заказ доставлен ✓',time:'Вчера',unread:0}];function showModal(title,text){document.getElementById('modalTitle').textContent=title;document.getElementById('modalText').textContent=text;document.getElementById('modal').classList.remove('hidden')}function closeModal(){document.getElementById('modal').classList.add('hidden')}function loadChats(){var list=document.getElementById('chatsList');list.innerHTML=chats.map(function(chat){var unreadBadge=chat.unread>0?'<div style=\"background:linear-gradient(135deg,#00b894,#00cec9);color:white;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;margin-top:5px;margin-left:auto;box-shadow:0 2px 8px rgba(0,206,201,0.4);\">'+chat.unread+'</div>':'';return '<div class=\"chat-item\" onclick=\"openChat('+chat.id+')\"><div class=\"chat-avatar\">'+chat.avatar+'</div><div class=\"chat-info\"><div class=\"chat-name\">'+chat.name+'</div><div class=\"chat-preview\">'+chat.lastMessage+'</div></div><div style=\"text-align:right;\"><div class=\"chat-time\">'+chat.time+'</div>'+unreadBadge+'</div></div>'}).join('')}function openChat(id){var chat=chats.find(function(c){return c.id===id});if(!chat)return;showModal('Чат с '+chat.name,'В полной версии здесь будет интерфейс чата')}loadChats();</script><script>var _msgNotifPool=[{t:'Аня 💕',b:'Привет! Как дела?'},{t:'Аня 💕',b:'Ты сегодня свободен?'},{t:'Дима',b:'Скинул мемы в личку 😂'},{t:'Мама',b:'Не забудь позвонить бабушке'},{t:'Рабочий чат',b:'Встреча перенесена на 15:00'},{t:'Кирилл',b:'Го в катку вечером?'},{t:'Доставка',b:'Курьер уже у подъезда 📦'}];function _pushMsg(){try{var m=_msgNotifPool[Math.floor(Math.random()*_msgNotifPool.length)];ePhone.notify('Сообщение: '+m.t, m.b);}catch(e){}}setTimeout(function(){ setInterval(_pushMsg, 45000); }, 12000);</script>", "changelog": "v2.1 - Живые push-уведомления о новых сообщениях (ePhone.notify)"}