{
  "id": "messages_system",
  "name": "Сообщения",
  "icon": "material:chat",
  "color": "from-green-400 to-green-500",
  "version": "2.0.0",
  "author": "ePhone System",
  "description": "Сообщения",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "v2.0 - Исправлены alert() и let",
  "code": "<div class=\"messages-app\"><h1><span class=\"material-icons\">chat</span> Сообщения</h1><div class=\"chats-list\" id=\"chatsList\"></div><div id=\"modal\" class=\"modal hidden\"><div class=\"modal-content\"><h3 id=\"modalTitle\"></h3><p id=\"modalText\"></p><button onclick=\"closeModal()\" class=\"modal-btn\">OK</button></div></div></div><style>.messages-app{padding:20px}.messages-app h1{font-size:24px;margin-bottom:20px;display:flex;align-items:center;gap:8px}.chats-list{display:flex;flex-direction:column;gap:10px}.chat-item{display:flex;align-items:center;gap:12px;padding:12px;background:rgba(128,128,128,0.2);border-radius:12px;cursor:pointer}.chat-item:hover{background:rgba(128,128,128,0.3)}.chat-avatar{width:50px;height:50px;background:linear-gradient(135deg,#34c759,#30d158);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px}.chat-info{flex:1}.chat-name{font-size:16px;font-weight:600}.chat-preview{font-size:14px;opacity:0.7;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.chat-time{font-size:12px;opacity:0.5}.modal{position:fixed;inset:0;background:rgba(0,0,0,0.7);display:flex;align-items:center;justify-content:center;z-index:1000}.modal.hidden{display:none}.modal-content{background:#1c1c1e;border-radius:16px;padding:20px;max-width:300px;text-align:center;color:white}.modal-content h3{margin-bottom:10px}.modal-content p{opacity:0.7;margin-bottom:15px}.modal-btn{padding:10px 30px;background:#007aff;color:white;border:none;border-radius:10px;font-weight:bold;cursor:pointer}</style><script>var settings=ePhone.getSettings();document.querySelector('.messages-app').style.color=settings.darkMode?'white':'black';var chats=[{id:1,name:'Мама',avatar:'👩',lastMessage:'Позвони когда будешь свободен',time:'12:30',unread:2},{id:2,name:'Андрей',avatar:'👨',lastMessage:'Го в кино вечером?',time:'11:45',unread:1},{id:3,name:'Работа',avatar:'💼',lastMessage:'Встреча в 15:00',time:'10:00',unread:0},{id:4,name:'Доставка',avatar:'📦',lastMessage:'Ваш заказ доставлен ✓',time:'Вчера',unread:0}];function showModal(title,text){document.getElementById('modalTitle').textContent=title;document.getElementById('modalText').textContent=text;document.getElementById('modal').classList.remove('hidden')}function closeModal(){document.getElementById('modal').classList.add('hidden')}function loadChats(){var list=document.getElementById('chatsList');list.innerHTML=chats.map(function(chat){var unreadBadge=chat.unread>0?'<div style=\"background:#34c759;color:white;border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:11px;margin-top:5px;margin-left:auto;\">'+chat.unread+'</div>':'';return '<div class=\"chat-item\" onclick=\"openChat('+chat.id+')\"><div class=\"chat-avatar\">'+chat.avatar+'</div><div class=\"chat-info\"><div class=\"chat-name\">'+chat.name+'</div><div class=\"chat-preview\">'+chat.lastMessage+'</div></div><div style=\"text-align:right;\"><div class=\"chat-time\">'+chat.time+'</div>'+unreadBadge+'</div></div>'}).join('')}function openChat(id){var chat=chats.find(function(c){return c.id===id});if(!chat)return;showModal('Чат с '+chat.name,'В полной версии здесь будет интерфейс чата')}loadChats();</script>"
}
