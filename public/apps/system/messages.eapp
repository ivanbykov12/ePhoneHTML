{
  "id": "messages_system",
  "name": "Сообщения",
  "icon": "material:chat",
  "color": "from-green-400 to-green-500",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Сообщения",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "Системное приложение",
  "code": "<!--\n⚠️ СИСТЕМНОЕ ПРИЛОЖЕНИЕ - НЕ УДАЛЯТЬ:\n- Список чатов chats\n- Функции: loadChats(), openChat(), sendMessage()\n- localStorage для сохранения сообщений\n-->\n<div class=\"messages-app\">\n  <h1><span class=\"material-icons\">chat</span> Сообщения</h1>\n  <div class=\"chats-list\" id=\"chatsList\"></div>\n</div>\n\n<style>\n.messages-app { padding: 20px; }\n.messages-app h1 { font-size: 24px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }\n.chats-list { display: flex; flex-direction: column; gap: 10px; }\n.chat-item { display: flex; align-items: center; gap: 12px; padding: 12px; background: rgba(128,128,128,0.2); border-radius: 12px; cursor: pointer; }\n.chat-item:hover { background: rgba(128,128,128,0.3); }\n.chat-avatar { width: 50px; height: 50px; background: linear-gradient(135deg, #34c759, #30d158); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; }\n.chat-info { flex: 1; }\n.chat-name { font-size: 16px; font-weight: 600; }\n.chat-preview { font-size: 14px; opacity: 0.7; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.chat-time { font-size: 12px; opacity: 0.5; }\n</style>\n\n<script>\n// ⚠️ НЕ УДАЛЯТЬ: Инициализация\nconst settings = ePhone.getSettings();\ndocument.querySelector('.messages-app').style.color = settings.darkMode ? 'white' : 'black';\n\n// ⚠️ НЕ УДАЛЯТЬ: Список чатов\nconst chats = [\n  { id: 1, name: 'Мама', avatar: '👩', lastMessage: 'Позвони когда будешь свободен', time: '12:30', unread: 2 },\n  { id: 2, name: 'Андрей', avatar: '👨', lastMessage: 'Го в кино вечером?', time: '11:45', unread: 1 },\n  { id: 3, name: 'Работа', avatar: '💼', lastMessage: 'Встреча в 15:00', time: '10:00', unread: 0 },\n  { id: 4, name: 'Доставка', avatar: '📦', lastMessage: 'Ваш заказ доставлен ✓', time: 'Вчера', unread: 0 }\n];\n\n// ⚠️ НЕ УДАЛЯТЬ: Функции управления чатами\nfunction loadChats() {\n  const list = document.getElementById('chatsList');\n  list.innerHTML = chats.map(chat => `\n    <div class=\"chat-item\" onclick=\"openChat(${chat.id})\">\n      <div class=\"chat-avatar\">${chat.avatar}</div>\n      <div class=\"chat-info\">\n        <div class=\"chat-name\">${chat.name}</div>\n        <div class=\"chat-preview\">${chat.lastMessage}</div>\n      </div>\n      <div style=\"text-align: right;\">\n        <div class=\"chat-time\">${chat.time}</div>\n        ${chat.unread > 0 ? `<div style=\"background: #34c759; color: white; border-radius: 50%; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; font-size: 11px; margin-top: 5px; margin-left: auto;\">${chat.unread}</div>` : ''}\n      </div>\n    </div>\n  `).join('');\n}\n\nfunction openChat(id) {\n  const chat = chats.find(c => c.id === id);\n  if (!chat) return;\n  alert(`Чат с ${chat.name}\\n\\n(В полной версии здесь будет интерфейс чата)`);\n}\n\nloadChats();\n</script>"
}
