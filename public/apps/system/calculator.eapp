{
  "id": "calculator_system",
  "name": "Калькулятор",
  "icon": "material:calculate",
  "color": "from-gray-700 to-gray-900",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Системный калькулятор",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "code": "<div class=\"calculator\">\n  <div class=\"display\" id=\"display\">0</div>\n  <div class=\"buttons\">\n    <button onclick=\"clear()\" class=\"btn func\">C</button>\n    <button onclick=\"toggleSign()\" class=\"btn func\">±</button>\n    <button onclick=\"percent()\" class=\"btn func\">%</button>\n    <button onclick=\"setOp('/')\" class=\"btn op\">÷</button>\n    \n    <button onclick=\"input('7')\" class=\"btn\">7</button>\n    <button onclick=\"input('8')\" class=\"btn\">8</button>\n    <button onclick=\"input('9')\" class=\"btn\">9</button>\n    <button onclick=\"setOp('*')\" class=\"btn op\">×</button>\n    \n    <button onclick=\"input('4')\" class=\"btn\">4</button>\n    <button onclick=\"input('5')\" class=\"btn\">5</button>\n    <button onclick=\"input('6')\" class=\"btn\">6</button>\n    <button onclick=\"setOp('-')\" class=\"btn op\">−</button>\n    \n    <button onclick=\"input('1')\" class=\"btn\">1</button>\n    <button onclick=\"input('2')\" class=\"btn\">2</button>\n    <button onclick=\"input('3')\" class=\"btn\">3</button>\n    <button onclick=\"setOp('+')\" class=\"btn op\">+</button>\n    \n    <button onclick=\"input('0')\" class=\"btn zero\">0</button>\n    <button onclick=\"input('.')\" class=\"btn\">.</button>\n    <button onclick=\"calculate()\" class=\"btn op\">=</button>\n  </div>\n</div>\n\n<style>\n.calculator {\n  padding: 20px;\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n}\n.display {\n  font-size: 48px;\n  text-align: right;\n  padding: 20px;\n  margin-bottom: 20px;\n  min-height: 80px;\n  word-wrap: break-word;\n  word-break: break-all;\n}\n.buttons {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 10px;\n  flex: 1;\n}\n.btn {\n  border: none;\n  border-radius: 50%;\n  font-size: 24px;\n  cursor: pointer;\n  aspect-ratio: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: transform 0.1s;\n}\n.btn:active {\n  transform: scale(0.9);\n}\n.btn.func {\n  background: #a5a5a5;\n  color: black;\n}\n.btn.op {\n  background: #ff9500;\n  color: white;\n}\n.btn {\n  background: #333;\n  color: white;\n}\n.btn.zero {\n  grid-column: span 2;\n  border-radius: 40px;\n  aspect-ratio: auto;\n  justify-content: flex-start;\n  padding-left: 30px;\n}\n</style>\n\n<script>\nconst settings = ePhone.getSettings();\nconst container = document.querySelector('.calculator');\ncontainer.style.color = settings.darkMode ? 'white' : 'white';\n\nlet display = '0';\nlet prev = null;\nlet op = null;\nlet resetNext = false;\n\nfunction updateDisplay() {\n  document.getElementById('display').textContent = display;\n}\n\nfunction input(d) {\n  if (resetNext) {\n    display = d;\n    resetNext = false;\n  } else {\n    display = display === '0' ? d : display + d;\n  }\n  updateDisplay();\n}\n\nfunction clear() {\n  display = '0';\n  prev = null;\n  op = null;\n  updateDisplay();\n}\n\nfunction toggleSign() {\n  display = String(parseFloat(display) * -1);\n  updateDisplay();\n}\n\nfunction percent() {\n  display = String(parseFloat(display) / 100);\n  updateDisplay();\n}\n\nfunction setOp(nextOp) {\n  const current = parseFloat(display);\n  if (prev !== null && op) {\n    const p = parseFloat(prev);\n    let result = 0;\n    switch (op) {\n      case '+': result = p + current; break;\n      case '-': result = p - current; break;\n      case '*': result = p * current; break;\n      case '/': result = current !== 0 ? p / current : 0; break;\n    }\n    display = String(result);\n    prev = String(result);\n  } else {\n    prev = display;\n  }\n  op = nextOp;\n  resetNext = true;\n  updateDisplay();\n}\n\nfunction calculate() {\n  if (prev === null || !op) return;\n  const current = parseFloat(display);\n  const p = parseFloat(prev);\n  let result = 0;\n  switch (op) {\n    case '+': result = p + current; break;\n    case '-': result = p - current; break;\n    case '*': result = p * current; break;\n    case '/': result = current !== 0 ? p / current : 0; break;\n  }\n  display = String(parseFloat(result.toFixed(8)));\n  prev = null;\n  op = null;\n  resetNext = true;\n  updateDisplay();\n}\n</script>"
}
