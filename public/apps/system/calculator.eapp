{
  "id": "calculator_system",
  "name": "Калькулятор",
  "icon": "material:calculate",
  "color": "from-gray-700 to-gray-900",
  "version": "3.0.0",
  "author": "ePhone System",
  "description": "Калькулятор с новым дизайном",
  "supportedModels": ["iphone8", "iphonex", "iphone14", "epad101"],
  "isSystem": true,
  "eappVersion": "1.1",
  "code": "<div class=\"app\"><div class=\"display\" id=\"display\">0</div><div class=\"buttons\"><button onclick=\"clr()\" class=\"btn func\">C</button><button onclick=\"ts()\" class=\"btn func\">±</button><button onclick=\"pc()\" class=\"btn func\">%</button><button onclick=\"so('/')\" class=\"btn op\">÷</button><button onclick=\"ni('7')\" class=\"btn\">7</button><button onclick=\"ni('8')\" class=\"btn\">8</button><button onclick=\"ni('9')\" class=\"btn\">9</button><button onclick=\"so('*')\" class=\"btn op\">×</button><button onclick=\"ni('4')\" class=\"btn\">4</button><button onclick=\"ni('5')\" class=\"btn\">5</button><button onclick=\"ni('6')\" class=\"btn\">6</button><button onclick=\"so('-')\" class=\"btn op\">−</button><button onclick=\"ni('1')\" class=\"btn\">1</button><button onclick=\"ni('2')\" class=\"btn\">2</button><button onclick=\"ni('3')\" class=\"btn\">3</button><button onclick=\"so('+')\" class=\"btn op\">+</button><button onclick=\"ni('0')\" class=\"btn zero\">0</button><button onclick=\"ni('.')\" class=\"btn\">.</button><button onclick=\"eq()\" class=\"btn op\">=</button></div></div><style>.app{padding:20px;height:100%;display:flex;flex-direction:column;background:linear-gradient(135deg,#0a0a0a 0%,#1a1a1a 100%)}.display{font-size:56px;font-weight:200;text-align:right;padding:30px 20px;color:white;min-height:100px;word-wrap:break-word;word-break:break-all;text-shadow:0 2px 10px rgba(0,0,0,0.3)}.buttons{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;flex:1}.btn{border:none;border-radius:50%;font-size:26px;cursor:pointer;aspect-ratio:1;display:flex;align-items:center;justify-content:center;transition:all 0.15s;font-weight:400}.btn:active{transform:scale(0.9)}.btn.func{background:rgba(255,255,255,0.1);backdrop-filter:blur(10px);color:white;border:1px solid rgba(255,255,255,0.1)}.btn.op{background:linear-gradient(135deg,#ff9500,#ff6b00);color:white;box-shadow:0 4px 15px rgba(255,107,0,0.3)}.btn{background:rgba(255,255,255,0.06);backdrop-filter:blur(10px);color:white;border:1px solid rgba(255,255,255,0.08)}.btn.zero{grid-column:span 2;border-radius:40px;aspect-ratio:auto;justify-content:flex-start;padding-left:30px}</style><script>var s=ePhone.getSettings();document.querySelector('.app').style.color='white';var d='0',p=null,o=null,rn=false;function ud(){document.getElementById('display').textContent=d}function ni(v){if(rn){d=v;rn=false}else{d=d==='0'?v:d+v}ud()}function clr(){d='0';p=null;o=null;ud()}function ts(){d=String(parseFloat(d)*-1);ud()}function pc(){d=String(parseFloat(d)/100);ud()}function so(n){var c=parseFloat(d);if(p!==null&&o){var pv=parseFloat(p),r=0;switch(o){case'+':r=pv+c;break;case'-':r=pv-c;break;case'*':r=pv*c;break;case'/':r=c!==0?pv/c:0;break}d=String(r);p=String(r)}else{p=d}o=n;rn=true;ud()}function eq(){if(p===null||!o)return;var c=parseFloat(d),pv=parseFloat(p),r=0;switch(o){case'+':r=pv+c;break;case'-':r=pv-c;break;case'*':r=pv*c;break;case'/':r=c!==0?pv/c:0;break}d=String(parseFloat(r.toFixed(8)));p=null;o=null;rn=true;ud()}</script>"
}
