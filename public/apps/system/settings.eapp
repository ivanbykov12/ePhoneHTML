{
  "id": "settings_system",
  "name": "Настройки",
  "icon": "material:settings",
  "color": "from-gray-400 to-gray-600",
  "version": "4.0.0",
  "author": "ePhone System",
  "description": "Системные настройки с поддержкой ePad и мультизадачности",
  "supportedModels": ["iphone8", "iphonex", "iphone14", "epad101"],
  "isSystem": true,
  "eappVersion": "1.1",
  "code": "<div class=\"settings-app\" id=\"settingsApp\"><div class=\"settings-layout\"><div class=\"sidebar\" id=\"sidebar\"><div class=\"sidebar-header\"><span class=\"material-icons\">settings</span><h2>Настройки</h2></div><div class=\"sidebar-menu\" id=\"sidebarMenu\"></div></div><div class=\"main-content\" id=\"mainContent\"><div class=\"content-header\" id=\"contentHeader\"><h1 id=\"pageTitle\">Основные</h1></div><div class=\"content-body\" id=\"contentBody\"></div></div></div></div><style>*{margin:0;padding:0;box-sizing:border-box}.settings-app{width:100%;height:100%;display:flex;background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%);color:white;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display',sans-serif;overflow:hidden}.settings-layout{display:flex;width:100%;height:100%}.sidebar{width:280px;background:rgba(0,0,0,0.3);backdrop-filter:blur(20px);border-right:1px solid rgba(255,255,255,0.1);display:flex;flex-direction:column;overflow:hidden}.sidebar-header{padding:20px;display:flex;align-items:center;gap:12px;border-bottom:1px solid rgba(255,255,255,0.1)}.sidebar-header h2{font-size:20px;font-weight:600}.sidebar-header .material-icons{font-size:28px}.sidebar-menu{flex:1;overflow-y:auto;padding:10px}.menu-item{display:flex;align-items:center;gap:12px;padding:12px 16px;border-radius:10px;cursor:pointer;transition:all 0.2s;margin-bottom:4px}.menu-item:hover{background:rgba(255,255,255,0.08)}.menu-item.active{background:rgba(0,122,255,0.3);color:#4fc3f7}.menu-item .material-icons{font-size:22px;width:24px}.menu-item span:last-child{flex:1;font-size:15px}.main-content{flex:1;display:flex;flex-direction:column;overflow:hidden}.content-header{padding:20px 30px;border-bottom:1px solid rgba(255,255,255,0.1)}.content-header h1{font-size:28px;font-weight:700}.content-body{flex:1;overflow-y:auto;padding:20px 30px}.section{margin-bottom:30px}.section-title{font-size:13px;font-weight:600;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:1px;margin-bottom:12px}.setting-item{display:flex;align-items:center;gap:12px;padding:14px 16px;background:rgba(255,255,255,0.06);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.1);border-radius:12px;margin-bottom:8px;cursor:pointer;transition:all 0.2s}.setting-item:hover{background:rgba(255,255,255,0.1)}.setting-item .material-icons{font-size:22px;width:24px}.setting-item .label{flex:1;font-size:15px}.setting-item .value{font-size:14px;color:rgba(255,255,255,0.5)}.switch{position:relative;width:50px;height:30px;flex-shrink:0}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;cursor:pointer;inset:0;background:rgba(255,255,255,0.2);border-radius:30px;transition:0.3s}.slider:before{content:'';position:absolute;height:24px;width:24px;left:3px;bottom:3px;background:white;border-radius:50%;transition:0.3s}input:checked+.slider{background:#34c759}input:checked+.slider:before{transform:translateX(20px)}.model-selector{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.model-option{padding:16px;background:rgba(255,255,255,0.06);border:2px solid rgba(255,255,255,0.1);border-radius:14px;cursor:pointer;transition:all 0.2s;text-align:center}.model-option:hover{background:rgba(255,255,255,0.1)}.model-option.active{background:rgba(0,122,255,0.2);border-color:#007aff}.model-name{font-size:16px;font-weight:600;margin-bottom:4px}.model-desc{font-size:12px;opacity:0.6}.input-field{width:100%;padding:12px 16px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:10px;color:white;font-size:15px;outline:none;transition:all 0.2s}.input-field:focus{background:rgba(255,255,255,0.1);border-color:#007aff}.select-field{width:100%;padding:12px 16px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:10px;color:white;font-size:15px;outline:none;cursor:pointer}.select-field option{background:#1a1a2e;color:white}.slider-container{padding:16px;background:rgba(255,255,255,0.06);border-radius:12px}.slider-container input[type=\"range\"]{width:100%;margin-bottom:8px}.slider-value{text-align:center;font-size:14px;opacity:0.7}.color-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}.color-option{width:40px;height:40px;border-radius:50%;cursor:pointer;border:3px solid transparent;transition:all 0.2s}.color-option:hover{transform:scale(1.1)}.color-option.active{border-color:white;transform:scale(1.15)}.wallpaper-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.wallpaper-option{cursor:pointer;transition:all 0.2s}.wallpaper-option:hover{transform:scale(1.05)}.wallpaper-preview{width:100%;height:120px;border-radius:12px;border:2px solid transparent}.wallpaper-option.active .wallpaper-preview{border-color:#007aff}.wallpaper-name{text-align:center;margin-top:8px;font-size:13px}.gradient1{background:linear-gradient(135deg,#667eea,#764ba2)}.gradient2{background:linear-gradient(135deg,#f093fb,#f5576c)}.gradient3{background:linear-gradient(135deg,#4facfe,#00f2fe)}.gradient4{background:linear-gradient(135deg,#43e97b,#38f9d7)}.dark{background:linear-gradient(135deg,#0f0c29,#302b63,#24243e)}.light{background:linear-gradient(135deg,#ffecd2,#fcb69f)}.info-card{background:rgba(255,255,255,0.06);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:20px;margin-bottom:16px}.info-row{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid rgba(255,255,255,0.1)}.info-row:last-child{border-bottom:none}.info-label{font-size:14px;opacity:0.6}.info-value{font-size:14px;font-weight:500}</style><script>var settings=ePhone.getSettings();var currentSection='general';var menuItems=[{id:'general',icon:'tune',label:'Основные'},{id:'device',icon:'palette',label:'Устройство'},{id:'display',icon:'brightness_6',label:'Экран и яркость'},{id:'wallpaper',icon:'image',label:'Обои'},{id:'multitasking',icon:'view_carousel',label:'Мультизадачность',padOnly:true},{id:'about',icon:'info',label:'О устройстве'}];function init(){renderMenu();showSection('general')}function renderMenu(){var menu=document.getElementById('sidebarMenu');var isPad=settings.phoneModel==='epad101';menu.innerHTML=menuItems.filter(function(item){return !item.padOnly||isPad}).map(function(item){return '<div class=\"menu-item'+(item.id===currentSection?' active':'')+'\" onclick=\"showSection(\\''+item.id+'\\')\"><span class=\"material-icons\">'+item.icon+'</span><span>'+item.label+'</span></div>'}).join('')}function showSection(section){currentSection=section;renderMenu();var header=document.getElementById('pageTitle');var body=document.getElementById('contentBody');switch(section){case 'general':header.textContent='Основные';body.innerHTML=renderGeneral();break;case 'device':header.textContent='Устройство';body.innerHTML=renderDevice();break;case 'display':header.textContent='Экран и яркость';body.innerHTML=renderDisplay();break;case 'wallpaper':header.textContent='Обои';body.innerHTML=renderWallpaper();break;case 'multitasking':header.textContent='Мультизадачность';body.innerHTML=renderMultitasking();break;case 'about':header.textContent='О устройстве';body.innerHTML=renderAbout();break}}function renderGeneral(){return '<div class=\"section\"><div class=\"section-title\">Устройство</div><div class=\"setting-item\"><span class=\"material-icons\">label</span><span class=\"label\">Имя устройства</span><input type=\"text\" class=\"input-field\" value=\"'+settings.name+'\" onchange=\"setDeviceName(this.value)\" style=\"width:200px\"></div></div><div class=\"section\"><div class=\"section-title\">Язык и регион</div><div class=\"setting-item\"><span class=\"material-icons\">language</span><span class=\"label\">Язык</span><select class=\"select-field\" onchange=\"setLanguage(this.value)\" style=\"width:200px\"><option value=\"Русский\"'+(settings.language==='Русский'?' selected':'')+'>Русский</option><option value=\"English\"'+(settings.language==='English'?' selected':'')+'>English</option><option value=\"Deutsch\"'+(settings.language==='Deutsch'?' selected':'')+'>Deutsch</option><option value=\"Français\"'+(settings.language==='Français'?' selected':'')+'>Français</option></select></div></div><div class=\"section\"><div class=\"section-title\">Система</div><div class=\"setting-item\"><span class=\"material-icons\">vibration</span><span class=\"label\">Тактильный отклик</span><label class=\"switch\"><input type=\"checkbox\"'+(settings.haptic?' checked':'')+' onchange=\"toggleSetting(\\'haptic\\')\"><span class=\"slider\"></span></label></div><div class=\"setting-item\"><span class=\"material-icons\">volume_up</span><span class=\"label\">Звуки</span><label class=\"switch\"><input type=\"checkbox\"'+(settings.sound?' checked':'')+' onchange=\"toggleSetting(\\'sound\\')\"><span class=\"slider\"></span></label></div><div class=\"setting-item\"><span class=\"material-icons\">notifications</span><span class=\"label\">Уведомления</span><label class=\"switch\"><input type=\"checkbox\"'+(settings.notifications?' checked':'')+' onchange=\"toggleSetting(\\'notifications\\')\"><span class=\"slider\"></span></label></div></div>'}function renderDevice(){var modelNames={'iphone8':'ePhone 8','iphonex':'ePhone X','iphone14':'ePhone 14','epad101':'ePad 10.1\"'};return '<div class=\"section\"><div class=\"section-title\">Модель устройства</div><div class=\"model-selector\"><div class=\"model-option'+(settings.phoneModel==='iphone8'?' active':'')+'\" onclick=\"setModel(\\'iphone8\\')\"><div class=\"model-name\">ePhone 8</div><div class=\"model-desc\">Классический</div></div><div class=\"model-option'+(settings.phoneModel==='iphonex'?' active':'')+'\" onclick=\"setModel(\\'iphonex\\')\"><div class=\"model-name\">ePhone X</div><div class=\"model-desc\">Безрамочный</div></div><div class=\"model-option'+(settings.phoneModel==='iphone14'?' active':'')+'\" onclick=\"setModel(\\'iphone14\\')\"><div class=\"model-name\">ePhone 14</div><div class=\"model-desc\">Dynamic Island</div></div><div class=\"model-option'+(settings.phoneModel==='epad101'?' active':'')+'\" onclick=\"setModel(\\'epad101\\')\"><div class=\"model-name\">ePad 10.1\"</div><div class=\"model-desc\">Планшет</div></div></div></div><div class=\"section\"><div class=\"section-title\">Dynamic Island</div><div class=\"setting-item\"><span class=\"material-icons\">lens</span><span class=\"label\">Включить Dynamic Island</span><label class=\"switch\"><input type=\"checkbox\"'+(!settings.disableIsland?' checked':'')+' onchange=\"toggleSetting(\\'disableIsland\\')\"'+(settings.phoneModel!=='iphone14'&&settings.phoneModel!=='epad101'?' disabled':'')+'><span class=\"slider\"></span></label></div></div>'}function renderDisplay(){return '<div class=\"section\"><div class=\"section-title\">Тема</div><div class=\"setting-item\"><span class=\"material-icons\">dark_mode</span><span class=\"label\">Тёмная тема</span><label class=\"switch\"><input type=\"checkbox\"'+(settings.darkMode?' checked':'')+' onchange=\"toggleSetting(\\'darkMode\\')\"><span class=\"slider\"></span></label></div></div><div class=\"section\"><div class=\"section-title\">Яркость</div><div class=\"slider-container\"><input type=\"range\" min=\"30\" max=\"100\" value=\"'+settings.brightness+'\" oninput=\"setBrightness(this.value)\"><div class=\"slider-value\">'+settings.brightness+'%</div></div></div><div class=\"section\"><div class=\"section-title\">Размер текста</div><div class=\"setting-item\"><span class=\"material-icons\">format_size</span><span class=\"label\">Маленький</span><input type=\"radio\" name=\"fontSize\" value=\"small\"'+(settings.fontSize==='small'?' checked':'')+' onchange=\"setFontSize(\\'small\\')\"></div><div class=\"setting-item\"><span class=\"material-icons\">format_size</span><span class=\"label\">Средний</span><input type=\"radio\" name=\"fontSize\" value=\"medium\"'+(settings.fontSize==='medium'?' checked':'')+' onchange=\"setFontSize(\\'medium\\')\"></div><div class=\"setting-item\"><span class=\"material-icons\">format_size</span><span class=\"label\">Большой</span><input type=\"radio\" name=\"fontSize\" value=\"large\"'+(settings.fontSize==='large'?' checked':'')+' onchange=\"setFontSize(\\'large\\')\"></div></div><div class=\"section\"><div class=\"section-title\">Цвет акцента</div><div class=\"color-grid\"><div class=\"color-option'+(settings.accentColor==='#007AFF'?' active':'')+'\" style=\"background:#007AFF\" onclick=\"setAccentColor(\\'#007AFF\\')\"></div><div class=\"color-option'+(settings.accentColor==='#FF3B30'?' active':'')+'\" style=\"background:#FF3B30\" onclick=\"setAccentColor(\\'#FF3B30\\')\"></div><div class=\"color-option'+(settings.accentColor==='#34C759'?' active':'')+'\" style=\"background:#34C759\" onclick=\"setAccentColor(\\'#34C759\\')\"></div><div class=\"color-option'+(settings.accentColor==='#FF9500'?' active':'')+'\" style=\"background:#FF9500\" onclick=\"setAccentColor(\\'#FF9500\\')\"></div><div class=\"color-option'+(settings.accentColor==='#AF52DE'?' active':'')+'\" style=\"background:#AF52DE\" onclick=\"setAccentColor(\\'#AF52DE\\')\"></div><div class=\"color-option'+(settings.accentColor==='#FF2D55'?' active':'')+'\" style=\"background:#FF2D55\" onclick=\"setAccentColor(\\'#FF2D55\\')\"></div></div></div>'}function renderWallpaper(){var wallpapers=[{id:'gradient1',name:'Космос'},{id:'gradient2',name:'Закат'},{id:'gradient3',name:'Океан'},{id:'gradient4',name:'Неон'},{id:'dark',name:'Тёмный'},{id:'light',name:'Светлый'}];return '<div class=\"section\"><div class=\"section-title\">Выберите обои</div><div class=\"wallpaper-grid\">'+wallpapers.map(function(wp){return '<div class=\"wallpaper-option'+(settings.wallpaper===wp.id?' active':'')+'\" onclick=\"setWallpaper(\\''+wp.id+'\\')\"><div class=\"wallpaper-preview '+wp.id+'\"></div><div class=\"wallpaper-name\">'+wp.name+'</div></div>'}).join('')+'</div></div>'}function renderMultitasking(){return '<div class=\"section\"><div class=\"section-title\">Мультизадачность</div><div class=\"setting-item\"><span class=\"material-icons\">view_carousel</span><span class=\"label\">Включить мультизадачность</span><label class=\"switch\"><input type=\"checkbox\"'+(settings.multiTasking?' checked':'')+' onchange=\"toggleSetting(\\'multiTasking\\')\"><span class=\"slider\"></span></label></div><div class=\"info-card\" style=\"margin-top:16px\"><div style=\"font-size:14px;opacity:0.7;line-height:1.6\">Мультизадачность позволяет открывать несколько приложений одновременно в отдельных окнах. Используйте Control Center для управления окнами.</div></div></div>'}function renderAbout(){var modelNames={'iphone8':'ePhone 8','iphonex':'ePhone X','iphone14':'ePhone 14','epad101':'ePad 10.1\"'};var osVersions={'iphone8':'EOS 16','iphonex':'EOS 16.5','iphone14':'EOS 18.1','epad101':'ePadOS 1.0'};var serial=generateSerial();var imei=generateIMEI();return '<div class=\"info-card\"><div class=\"info-row\"><span class=\"info-label\">Модель</span><span class=\"info-value\">'+modelNames[settings.phoneModel]+'</span></div><div class=\"info-row\"><span class=\"info-label\">Версия ПО</span><span class=\"info-value\">'+osVersions[settings.phoneModel]+'</span></div><div class=\"info-row\"><span class=\"info-label\">Имя устройства</span><span class=\"info-value\">'+settings.name+'</span></div><div class=\"info-row\"><span class=\"info-label\">Серийный номер</span><span class=\"info-value\">'+serial+'</span></div><div class=\"info-row\"><span class=\"info-label\">IMEI</span><span class=\"info-value\">'+imei+'</span></div><div class=\"info-row\"><span class=\"info-label\">Память</span><span class=\"info-value\">34 ГБ из 128 ГБ</span></div><div class=\"info-row\"><span class=\"info-label\">Доступно</span><span class=\"info-value\">94 ГБ</span></div></div>'}function generateSerial(){var chars='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';var serial='';for(var i=0;i<12;i++){serial+=chars.charAt(Math.floor(Math.random()*chars.length))}return serial}function generateIMEI(){var imei='';for(var i=0;i<15;i++){imei+=Math.floor(Math.random()*10)}return imei}function toggleSetting(key){var updates={};updates[key]=!settings[key];ePhone.setSettings(updates);settings=Object.assign(settings,updates);if(key==='darkMode'){document.querySelector('.settings-app').style.color=updates.darkMode?'white':'black'}if(key==='multiTasking'){showSection('multitasking')}}function setModel(model){ePhone.switchModel(model);setTimeout(function(){location.reload()},500)}function setWallpaper(wallpaper){ePhone.setSettings({wallpaper:wallpaper});settings.wallpaper=wallpaper;showSection('wallpaper')}function setBrightness(value){ePhone.setSettings({brightness:parseInt(value)});settings.brightness=parseInt(value);document.querySelector('.slider-value').textContent=value+'%'}function setFontSize(size){ePhone.setSettings({fontSize:size});settings.fontSize=size;showSection('display')}function setAccentColor(color){ePhone.setSettings({accentColor:color});settings.accentColor=color;showSection('display')}function setDeviceName(name){ePhone.setSettings({name:name});settings.name=name}function setLanguage(lang){ePhone.setSettings({language:lang});settings.language=lang}init();</script>"
}
