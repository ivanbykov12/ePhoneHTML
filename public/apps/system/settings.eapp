{
  "id": "settings_system",
  "name": "Настройки",
  "icon": "material:settings",
  "color": "from-gray-400 to-gray-600",
  "version": "2.0.0",
  "author": "ePhone System",
  "description": "Системные настройки",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "v2.0 - Полный функционал управления настройками",
  "code": "<!--\n⚠️ СИСТЕМНОЕ ПРИЛОЖЕНИЕ - НЕ УДАЛЯТЬ:\n- ePhone.getSettings() - получение текущих настроек\n- ePhone.setSettings() - изменение настроек\n- ePhone.switchModel() - переключение модели телефона\n- Функции: showSection(), toggleSetting(), setWallpaper(), setModel()\n- Все разделы навигации: Epple ID, Настройки сайта, Экран, Обои, Основные\n-->\n<div class=\"settings-app\" id=\"settingsApp\">\n  <!-- Главная страница -->\n  <div id=\"mainPage\">\n    <h1><span class=\"material-icons\">settings</span> Настройки</h1>\n    \n    <!-- Профиль -->\n    <div class=\"profile\" onclick=\"showSection('apple-id')\">\n      <div class=\"avatar\"><span class=\"material-icons\">person</span></div>\n      <div class=\"profile-info\">\n        <div class=\"name\" id=\"userName\">ePhone</div>\n        <div class=\"subtitle\">Epple ID, iCloud и др.</div>\n      </div>\n      <span class=\"material-icons chevron\">chevron_right</span>\n    </div>\n\n    <!-- Список настроек -->\n    <div class=\"settings-list\">\n      <div class=\"setting-item\">\n        <span class=\"material-icons icon\" style=\"color: #007aff;\">wifi</span>\n        <span>Wi-Fi</span>\n        <span class=\"value\">Подключено</span>\n        <span class=\"material-icons chevron\">chevron_right</span>\n      </div>\n      <div class=\"setting-item\">\n        <span class=\"material-icons icon\" style=\"color: #007aff;\">bluetooth</span>\n        <span>Bluetooth</span>\n        <span class=\"value\">Вкл.</span>\n        <span class=\"material-icons chevron\">chevron_right</span>\n      </div>\n      <div class=\"setting-item\">\n        <span class=\"material-icons icon\" style=\"color: #ff9500;\">airplanemode_active</span>\n        <span>Авиарежим</span>\n        <label class=\"switch\"><input type=\"checkbox\" onchange=\"toggleSetting('airplane')\"><span class=\"slider\"></span></label>\n      </div>\n      <div class=\"setting-item\" onclick=\"showSection('general')\">\n        <span class=\"material-icons icon\" style=\"color: #8e8e93;\">tune</span>\n        <span>Основные</span>\n        <span class=\"material-icons chevron\">chevron_right</span>\n      </div>\n      <div class=\"setting-item\" onclick=\"showSection('site-settings')\">\n        <span class=\"material-icons icon\" style=\"color: #af52de;\">palette</span>\n        <span>Настройки сайта</span>\n        <span class=\"badge\" id=\"modelBadge\">ePhone 14</span>\n        <span class=\"material-icons chevron\">chevron_right</span>\n      </div>\n      <div class=\"setting-item\" onclick=\"showSection('display')\">\n        <span class=\"material-icons icon\" style=\"color: #ffcc00;\">brightness_6</span>\n        <span>Экран и яркость</span>\n        <span class=\"material-icons chevron\">chevron_right</span>\n      </div>\n      <div class=\"setting-item\" onclick=\"showSection('wallpaper')\">\n        <span class=\"material-icons icon\" style=\"color: #00bcd4;\">image</span>\n        <span>Обои</span>\n        <span class=\"material-icons chevron\">chevron_right</span>\n      </div>\n      <div class=\"setting-item\">\n        <span class=\"material-icons icon\" style=\"color: #ff3b30;\">notifications</span>\n        <span>Уведомления</span>\n        <label class=\"switch\"><input type=\"checkbox\" id=\"notifToggle\" checked onchange=\"toggleSetting('notifications')\"><span class=\"slider\"></span></label>\n      </div>\n      <div class=\"setting-item\">\n        <span class=\"material-icons icon\" style=\"color: #ff2d55;\">volume_up</span>\n        <span>Звуки</span>\n        <label class=\"switch\"><input type=\"checkbox\" id=\"soundToggle\" checked onchange=\"toggleSetting('sound')\"><span class=\"slider\"></span></label>\n      </div>\n      <div class=\"setting-item\">\n        <span class=\"material-icons icon\" style=\"color: #34c759;\">battery_full</span>\n        <span>Аккумулятор</span>\n        <span class=\"value\">87%</span>\n        <span class=\"material-icons chevron\">chevron_right</span>\n      </div>\n      <div class=\"setting-item\">\n        <span class=\"material-icons icon\" style=\"color: #8e8e93;\">info</span>\n        <span>Об устройстве</span>\n        <span class=\"value\">ePhone 14</span>\n        <span class=\"material-icons chevron\">chevron_right</span>\n      </div>\n    </div>\n\n    <div class=\"footer\">\n      <p>ePhone Simulator v3.1</p>\n      <p>Epple Inc. © 2024</p>\n    </div>\n  </div>\n\n  <!-- Страница настроек сайта -->\n  <div id=\"siteSettingsPage\" class=\"page hidden\">\n    <div class=\"page-header\">\n      <button onclick=\"showMain()\" class=\"back-btn\">← Назад</button>\n      <h2>Настройки сайта</h2>\n    </div>\n    \n    <div class=\"section-title\">Стиль телефона</div>\n    <div class=\"model-selector\">\n      <div class=\"model-option\" onclick=\"setModel('iphone8')\" id=\"model-iphone8\">\n        <div class=\"model-name\">ePhone 8</div>\n        <div class=\"model-desc\">Классический с кнопкой</div>\n        <div class=\"check\" id=\"check-iphone8\">✓</div>\n      </div>\n      <div class=\"model-option\" onclick=\"setModel('iphonex')\" id=\"model-iphonex\">\n        <div class=\"model-name\">ePhone X</div>\n        <div class=\"model-desc\">Безрамочный с чёлкой</div>\n        <div class=\"check\" id=\"check-iphonex\">✓</div>\n      </div>\n      <div class=\"model-option\" onclick=\"setModel('iphone14')\" id=\"model-iphone14\">\n        <div class=\"model-name\">ePhone 14</div>\n        <div class=\"model-desc\">Dynamic Island</div>\n        <div class=\"check\" id=\"check-iphone14\">✓</div>\n      </div>\n    </div>\n\n    <div class=\"section-title\">Dynamic Island</div>\n    <div class=\"setting-item\">\n      <span>Dynamic Island</span>\n      <label class=\"switch\"><input type=\"checkbox\" id=\"islandToggle\" checked onchange=\"toggleSetting('disableIsland')\"><span class=\"slider\"></span></label>\n    </div>\n    <div class=\"hint\" id=\"islandHint\">Доступно только на ePhone 14</div>\n  </div>\n\n  <!-- Страница экрана -->\n  <div id=\"displayPage\" class=\"page hidden\">\n    <div class=\"page-header\">\n      <button onclick=\"showMain()\" class=\"back-btn\">← Назад</button>\n      <h2>Экран и яркость</h2>\n    </div>\n\n    <div class=\"section-title\">Тема</div>\n    <div class=\"setting-item\">\n      <span>Тёмная тема</span>\n      <label class=\"switch\"><input type=\"checkbox\" id=\"darkModeToggle\" checked onchange=\"toggleSetting('darkMode')\"><span class=\"slider\"></span></label>\n    </div>\n\n    <div class=\"section-title\">Яркость</div>\n    <div class=\"slider-container\">\n      <input type=\"range\" min=\"30\" max=\"100\" value=\"100\" id=\"brightnessSlider\" oninput=\"setBrightness(this.value)\">\n      <div class=\"slider-value\" id=\"brightnessValue\">100%</div>\n    </div>\n\n    <div class=\"section-title\">Размер текста</div>\n    <div class=\"font-size-selector\">\n      <button onclick=\"setFontSize('small')\" class=\"font-btn\" id=\"font-small\">A</button>\n      <button onclick=\"setFontSize('medium')\" class=\"font-btn\" id=\"font-medium\">A</button>\n      <button onclick=\"setFontSize('large')\" class=\"font-btn\" id=\"font-large\">A</button>\n    </div>\n\n    <div class=\"section-title\">Цвет акцента</div>\n    <div class=\"color-selector\">\n      <div class=\"color-option\" style=\"background: #007AFF;\" onclick=\"setAccentColor('#007AFF')\"></div>\n      <div class=\"color-option\" style=\"background: #FF3B30;\" onclick=\"setAccentColor('#FF3B30')\"></div>\n      <div class=\"color-option\" style=\"background: #34C759;\" onclick=\"setAccentColor('#34C759')\"></div>\n      <div class=\"color-option\" style=\"background: #FF9500;\" onclick=\"setAccentColor('#FF9500')\"></div>\n      <div class=\"color-option\" style=\"background: #AF52DE;\" onclick=\"setAccentColor('#AF52DE')\"></div>\n      <div class=\"color-option\" style=\"background: #FF2D55;\" onclick=\"setAccentColor('#FF2D55')\"></div>\n    </div>\n  </div>\n\n  <!-- Страница обоев -->\n  <div id=\"wallpaperPage\" class=\"page hidden\">\n    <div class=\"page-header\">\n      <button onclick=\"showMain()\" class=\"back-btn\">← Назад</button>\n      <h2>Обои</h2>\n    </div>\n    <div class=\"wallpaper-grid\">\n      <div class=\"wallpaper-option\" onclick=\"setWallpaper('gradient1')\">\n        <div class=\"wallpaper-preview gradient1\"></div>\n        <div class=\"wallpaper-name\">Космос</div>\n      </div>\n      <div class=\"wallpaper-option\" onclick=\"setWallpaper('gradient2')\">\n        <div class=\"wallpaper-preview gradient2\"></div>\n        <div class=\"wallpaper-name\">Закат</div>\n      </div>\n      <div class=\"wallpaper-option\" onclick=\"setWallpaper('gradient3')\">\n        <div class=\"wallpaper-preview gradient3\"></div>\n        <div class=\"wallpaper-name\">Океан</div>\n      </div>\n      <div class=\"wallpaper-option\" onclick=\"setWallpaper('gradient4')\">\n        <div class=\"wallpaper-preview gradient4\"></div>\n        <div class=\"wallpaper-name\">Неон</div>\n      </div>\n      <div class=\"wallpaper-option\" onclick=\"setWallpaper('dark')\">\n        <div class=\"wallpaper-preview dark\"></div>\n        <div class=\"wallpaper-name\">Тёмный</div>\n      </div>\n      <div class=\"wallpaper-option\" onclick=\"setWallpaper('light')\">\n        <div class=\"wallpaper-preview light\"></div>\n        <div class=\"wallpaper-name\">Светлый</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Страница основных настроек -->\n  <div id=\"generalPage\" class=\"page hidden\">\n    <div class=\"page-header\">\n      <button onclick=\"showMain()\" class=\"back-btn\">← Назад</button>\n      <h2>Основные</h2>\n    </div>\n\n    <div class=\"section-title\">Имя устройства</div>\n    <div class=\"input-container\">\n      <input type=\"text\" id=\"deviceName\" value=\"ePhone\" onchange=\"setDeviceName(this.value)\">\n    </div>\n\n    <div class=\"section-title\">Язык</div>\n    <div class=\"input-container\">\n      <select id=\"languageSelect\" onchange=\"setLanguage(this.value)\">\n        <option value=\"Русский\">Русский</option>\n        <option value=\"English\">English</option>\n        <option value=\"Deutsch\">Deutsch</option>\n        <option value=\"Français\">Français</option>\n      </select>\n    </div>\n\n    <div class=\"section-title\">Другие настройки</div>\n    <div class=\"setting-item\">\n      <span>Тактильный отклик</span>\n      <label class=\"switch\"><input type=\"checkbox\" id=\"hapticToggle\" checked onchange=\"toggleSetting('haptic')\"><span class=\"slider\"></span></label>\n    </div>\n  </div>\n</div>\n\n<style>\n.settings-app { padding: 20px; }\n.settings-app h1 { font-size: 24px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }\n.profile { display: flex; align-items: center; gap: 12px; padding: 15px; background: rgba(128,128,128,0.2); border-radius: 12px; margin-bottom: 20px; cursor: pointer; }\n.avatar { width: 50px; height: 50px; background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 50%; display: flex; align-items: center; justify-content: center; }\n.avatar .material-icons { font-size: 28px; color: white; }\n.profile-info { flex: 1; }\n.name { font-size: 16px; font-weight: 600; }\n.subtitle { font-size: 12px; opacity: 0.7; }\n.chevron { opacity: 0.5; }\n.settings-list { display: flex; flex-direction: column; gap: 8px; }\n.setting-item { display: flex; align-items: center; gap: 12px; padding: 12px; background: rgba(128,128,128,0.2); border-radius: 12px; cursor: pointer; }\n.setting-item .icon { font-size: 20px; }\n.setting-item span:not(.icon):not(.chevron):not(.value):not(.badge) { flex: 1; }\n.value { opacity: 0.7; font-size: 14px; }\n.badge { background: rgba(128,128,128,0.3); padding: 2px 8px; border-radius: 10px; font-size: 12px; }\n.switch { position: relative; width: 50px; height: 30px; flex-shrink: 0; }\n.switch input { opacity: 0; width: 0; height: 0; }\n.slider { position: absolute; cursor: pointer; inset: 0; background: #888; border-radius: 30px; transition: 0.3s; }\n.slider:before { content: ''; position: absolute; height: 24px; width: 24px; left: 3px; bottom: 3px; background: white; border-radius: 50%; transition: 0.3s; }\ninput:checked + .slider { background: #34c759; }\ninput:checked + .slider:before { transform: translateX(20px); }\n.footer { margin-top: 30px; text-align: center; opacity: 0.5; font-size: 12px; }\n.hidden { display: none !important; }\n.page-header { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }\n.back-btn { background: none; border: none; color: #007aff; font-size: 14px; cursor: pointer; padding: 0; }\n.page-header h2 { font-size: 18px; font-weight: 600; }\n.section-title { font-size: 14px; font-weight: 600; margin: 20px 0 10px; opacity: 0.7; }\n.model-selector { display: flex; flex-direction: column; gap: 8px; }\n.model-option { display: flex; align-items: center; gap: 12px; padding: 12px; background: rgba(128,128,128,0.2); border-radius: 12px; cursor: pointer; }\n.model-option.active { background: rgba(0,122,255,0.2); border: 1px solid #007aff; }\n.model-name { font-weight: 600; }\n.model-desc { font-size: 12px; opacity: 0.7; }\n.check { margin-left: auto; color: #007aff; font-weight: bold; display: none; }\n.model-option.active .check { display: block; }\n.hint { font-size: 12px; opacity: 0.5; margin-top: 8px; }\n.slider-container { padding: 12px; background: rgba(128,128,128,0.2); border-radius: 12px; }\n.slider-container input[type=\"range\"] { width: 100%; }\n.slider-value { text-align: center; margin-top: 8px; opacity: 0.7; }\n.font-size-selector { display: flex; gap: 8px; }\n.font-btn { flex: 1; padding: 10px; background: rgba(128,128,128,0.2); border: none; border-radius: 8px; cursor: pointer; font-size: 16px; }\n.font-btn.active { background: #007aff; color: white; }\n.color-selector { display: flex; gap: 12px; flex-wrap: wrap; }\n.color-option { width: 32px; height: 32px; border-radius: 50%; cursor: pointer; border: 2px solid transparent; }\n.color-option.active { border-color: white; transform: scale(1.1); }\n.wallpaper-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }\n.wallpaper-option { cursor: pointer; }\n.wallpaper-preview { width: 100%; height: 120px; border-radius: 12px; }\n.wallpaper-name { text-align: center; margin-top: 8px; font-size: 14px; }\n.gradient1 { background: linear-gradient(to bottom, #312e81, #581c87, #000); }\n.gradient2 { background: linear-gradient(to bottom, #881337, #9a3412, #92400e); }\n.gradient3 { background: linear-gradient(to bottom, #064e3b, #134e4a, #164e63); }\n.gradient4 { background: linear-gradient(to bottom, #312e81, #701a75, #831843); }\n.dark { background: linear-gradient(to bottom, #111827, #000); }\n.light { background: linear-gradient(to bottom, #bfdbfe, #ddd6fe, #fce7f3); }\n.input-container { padding: 12px; background: rgba(128,128,128,0.2); border-radius: 12px; }\n.input-container input, .input-container select { width: 100%; background: rgba(128,128,128,0.3); border: none; border-radius: 8px; padding: 8px 12px; color: inherit; font-size: 14px; }\n</style>\n\n<script>\n// ⚠️ НЕ УДАЛЯТЬ: Инициализация настроек\nconst settings = ePhone.getSettings();\nconst app = document.getElementById('settingsApp');\napp.style.color = settings.darkMode ? 'white' : 'black';\n\n// ⚠️ НЕ УДАЛЯТЬ: Загрузка текущих настроек в UI\ndocument.getElementById('userName').textContent = settings.name;\ndocument.getElementById('modelBadge').textContent = \n  settings.phoneModel === 'iphone8' ? 'ePhone 8' : \n  settings.phoneModel === 'iphonex' ? 'ePhone X' : 'ePhone 14';\ndocument.getElementById('darkModeToggle').checked = settings.darkMode;\ndocument.getElementById('brightnessSlider').value = settings.brightness;\ndocument.getElementById('brightnessValue').textContent = settings.brightness + '%';\ndocument.getElementById('notifToggle').checked = settings.notifications;\ndocument.getElementById('soundToggle').checked = settings.sound;\ndocument.getElementById('hapticToggle').checked = settings.haptic;\ndocument.getElementById('deviceName').value = settings.name;\ndocument.getElementById('languageSelect').value = settings.language;\n\n// Обновление активной модели\n['iphone8', 'iphonex', 'iphone14'].forEach(model => {\n  const el = document.getElementById('model-' + model);\n  if (settings.phoneModel === model) el.classList.add('active');\n});\n\n// Обновление Island toggle\ndocument.getElementById('islandToggle').checked = !settings.disableIsland;\nif (settings.phoneModel !== 'iphone14') {\n  document.getElementById('islandToggle').disabled = true;\n  document.getElementById('islandHint').style.display = 'block';\n} else {\n  document.getElementById('islandHint').style.display = 'none';\n}\n\n// Обновление размера текста\ndocument.querySelectorAll('.font-btn').forEach(btn => btn.classList.remove('active'));\ndocument.getElementById('font-' + settings.fontSize).classList.add('active');\n\n// ⚠️ НЕ УДАЛЯТЬ: Функции навигации\nfunction showSection(section) {\n  document.getElementById('mainPage').classList.add('hidden');\n  document.getElementById(section + 'Page').classList.remove('hidden');\n}\n\nfunction showMain() {\n  document.querySelectorAll('.page').forEach(p => p.classList.add('hidden'));\n  document.getElementById('mainPage').classList.remove('hidden');\n}\n\n// ⚠️ НЕ УДАЛЯТЬ: Функции управления настройками\nfunction toggleSetting(key) {\n  const settings = ePhone.getSettings();\n  const updates = {};\n  \n  if (key === 'darkMode') {\n    updates.darkMode = !settings.darkMode;\n    app.style.color = updates.darkMode ? 'white' : 'black';\n  } else if (key === 'notifications') {\n    updates.notifications = !settings.notifications;\n  } else if (key === 'sound') {\n    updates.sound = !settings.sound;\n  } else if (key === 'haptic') {\n    updates.haptic = !settings.haptic;\n  } else if (key === 'disableIsland') {\n    updates.disableIsland = !settings.disableIsland;\n  }\n  \n  ePhone.setSettings(updates);\n}\n\nfunction setModel(model) {\n  ePhone.switchModel(model);\n  setTimeout(() => location.reload(), 500);\n}\n\nfunction setWallpaper(wallpaper) {\n  ePhone.setSettings({ wallpaper: wallpaper });\n}\n\nfunction setBrightness(value) {\n  document.getElementById('brightnessValue').textContent = value + '%';\n  ePhone.setSettings({ brightness: parseInt(value) });\n}\n\nfunction setFontSize(size) {\n  document.querySelectorAll('.font-btn').forEach(btn => btn.classList.remove('active'));\n  document.getElementById('font-' + size).classList.add('active');\n  ePhone.setSettings({ fontSize: size });\n}\n\nfunction setAccentColor(color) {\n  document.querySelectorAll('.color-option').forEach(el => el.classList.remove('active'));\n  event.target.classList.add('active');\n  ePhone.setSettings({ accentColor: color });\n}\n\nfunction setDeviceName(name) {\n  ePhone.setSettings({ name: name });\n  document.getElementById('userName').textContent = name;\n}\n\nfunction setLanguage(lang) {\n  ePhone.setSettings({ language: lang });\n}\n</script>"
}
