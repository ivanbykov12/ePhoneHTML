{
  "id": "settings_system",
  "name": "Настройки",
  "icon": "material:settings",
  "color": "from-gray-400 to-gray-600",
  "version": "2.2.0",
  "author": "ePhone System",
  "description": "Системные настройки",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "eappVersion": "1.1",
  "changelog": "v2.2 - Добавлена вкладка 'О телефоне' с серийным номером и IMEI",
  "code": "<div class=\"settings-app\" id=\"settingsApp\"><div id=\"mainPage\"><h1><span class=\"material-icons\">settings</span> Настройки</h1><div class=\"profile\" onclick=\"showSection('appleid')\"><div class=\"avatar\"><span class=\"material-icons\">person</span></div><div class=\"profile-info\"><div class=\"name\" id=\"userName\">ePhone</div><div class=\"subtitle\">Epple ID, iCloud и др.</div></div><span class=\"material-icons chevron\">chevron_right</span></div><div class=\"settings-list\"><div class=\"setting-item\"><span class=\"material-icons icon\" style=\"color: #007aff;\">wifi</span><span>Wi-Fi</span><span class=\"value\">Подключено</span><span class=\"material-icons chevron\">chevron_right</span></div><div class=\"setting-item\"><span class=\"material-icons icon\" style=\"color: #007aff;\">bluetooth</span><span>Bluetooth</span><span class=\"value\">Вкл.</span><span class=\"material-icons chevron\">chevron_right</span></div><div class=\"setting-item\"><span class=\"material-icons icon\" style=\"color: #ff9500;\">airplanemode_active</span><span>Авиарежим</span><label class=\"switch\"><input type=\"checkbox\" onchange=\"toggleSetting('airplane')\"><span class=\"slider\"></span></label></div><div class=\"setting-item\" onclick=\"showSection('general')\"><span class=\"material-icons icon\" style=\"color: #8e8e93;\">tune</span><span>Основные</span><span class=\"material-icons chevron\">chevron_right</span></div><div class=\"setting-item\" onclick=\"showSection('sitesettings')\"><span class=\"material-icons icon\" style=\"color: #af52de;\">palette</span><span>Настройки сайта</span><span class=\"badge\" id=\"modelBadge\">ePhone 14</span><span class=\"material-icons chevron\">chevron_right</span></div><div class=\"setting-item\" onclick=\"showSection('display')\"><span class=\"material-icons icon\" style=\"color: #ffcc00;\">brightness_6</span><span>Экран и яркость</span><span class=\"material-icons chevron\">chevron_right</span></div><div class=\"setting-item\" onclick=\"showSection('wallpaper')\"><span class=\"material-icons icon\" style=\"color: #00bcd4;\">image</span><span>Обои</span><span class=\"material-icons chevron\">chevron_right</span></div><div class=\"setting-item\" onclick=\"showSection('about')\"><span class=\"material-icons icon\" style=\"color: #34c759;\">info</span><span>О телефоне</span><span class=\"material-icons chevron\">chevron_right</span></div><div class=\"setting-item\"><span class=\"material-icons icon\" style=\"color: #ff3b30;\">notifications</span><span>Уведомления</span><label class=\"switch\"><input type=\"checkbox\" id=\"notifToggle\" checked onchange=\"toggleSetting('notifications')\"><span class=\"slider\"></span></label></div><div class=\"setting-item\"><span class=\"material-icons icon\" style=\"color: #ff2d55;\">volume_up</span><span>Звуки</span><label class=\"switch\"><input type=\"checkbox\" id=\"soundToggle\" checked onchange=\"toggleSetting('sound')\"><span class=\"slider\"></span></label></div><div class=\"setting-item\"><span class=\"material-icons icon\" style=\"color: #34c759;\">battery_full</span><span>Аккумулятор</span><span class=\"value\">87%</span><span class=\"material-icons chevron\">chevron_right</span></div></div><div class=\"footer\"><p>ePhone Simulator v3.2</p><p>Epple Inc. © 2024</p></div></div><div id=\"appleidPage\" class=\"page hidden\"><div class=\"page-header\"><button onclick=\"showMain()\" class=\"back-btn\">← Назад</button><h2>Epple ID</h2></div><div class=\"profile-card\"><div class=\"avatar-large\"><span class=\"material-icons\">person</span></div><div class=\"profile-name\" id=\"profileName\">ePhone</div><div class=\"profile-email\">user@epple.com</div></div><div class=\"settings-list\"><div class=\"setting-item\"><span class=\"material-icons icon\" style=\"color: #007aff;\">info</span><span>Личная информация</span><span class=\"material-icons chevron\">chevron_right</span></div><div class=\"setting-item\"><span class=\"material-icons icon\" style=\"color: #8e8e93;\">lock</span><span>Пароль и безопасность</span><span class=\"material-icons chevron\">chevron_right</span></div><div class=\"setting-item\"><span class=\"material-icons icon\" style=\"color: #007aff;\">cloud</span><span>iCloud</span><span class=\"material-icons chevron\">chevron_right</span></div><div class=\"setting-item\"><span class=\"material-icons icon\" style=\"color: #af52de;\">devices</span><span>Устройства</span><span class=\"material-icons chevron\">chevron_right</span></div></div><button class=\"logout-btn\">Выйти из Epple ID</button></div><div id=\"sitesettingsPage\" class=\"page hidden\"><div class=\"page-header\"><button onclick=\"showMain()\" class=\"back-btn\">← Назад</button><h2>Настройки сайта</h2></div><div class=\"section-title\">Стиль телефона</div><div class=\"model-selector\"><div class=\"model-option\" onclick=\"setModel('iphone8')\" id=\"model-iphone8\"><div class=\"model-name\">ePhone 8</div><div class=\"model-desc\">Классический с кнопкой</div><div class=\"check\">✓</div></div><div class=\"model-option\" onclick=\"setModel('iphonex')\" id=\"model-iphonex\"><div class=\"model-name\">ePhone X</div><div class=\"model-desc\">Безрамочный с чёлкой</div><div class=\"check\">✓</div></div><div class=\"model-option\" onclick=\"setModel('iphone14')\" id=\"model-iphone14\"><div class=\"model-name\">ePhone 14</div><div class=\"model-desc\">Dynamic Island</div><div class=\"check\">✓</div></div></div><div class=\"section-title\">Dynamic Island</div><div class=\"setting-item\"><span>Dynamic Island</span><label class=\"switch\"><input type=\"checkbox\" id=\"islandToggle\" checked onchange=\"toggleSetting('disableIsland')\"><span class=\"slider\"></span></label></div><div class=\"hint\" id=\"islandHint\">Доступно только на ePhone 14</div></div><div id=\"displayPage\" class=\"page hidden\"><div class=\"page-header\"><button onclick=\"showMain()\" class=\"back-btn\">← Назад</button><h2>Экран и яркость</h2></div><div class=\"section-title\">Тема</div><div class=\"setting-item\"><span>Тёмная тема</span><label class=\"switch\"><input type=\"checkbox\" id=\"darkModeToggle\" checked onchange=\"toggleSetting('darkMode')\"><span class=\"slider\"></span></label></div><div class=\"section-title\">Яркость</div><div class=\"slider-container\"><input type=\"range\" min=\"30\" max=\"100\" value=\"100\" id=\"brightnessSlider\" oninput=\"setBrightness(this.value)\"><div class=\"slider-value\" id=\"brightnessValue\">100%</div></div><div class=\"section-title\">Размер текста</div><div class=\"font-size-selector\"><button onclick=\"setFontSize('small')\" class=\"font-btn\" id=\"font-small\">A</button><button onclick=\"setFontSize('medium')\" class=\"font-btn\" id=\"font-medium\">A</button><button onclick=\"setFontSize('large')\" class=\"font-btn\" id=\"font-large\">A</button></div><div class=\"section-title\">Цвет акцента</div><div class=\"color-selector\"><div class=\"color-option\" style=\"background: #007AFF;\" onclick=\"setAccentColor('#007AFF')\"></div><div class=\"color-option\" style=\"background: #FF3B30;\" onclick=\"setAccentColor('#FF3B30')\"></div><div class=\"color-option\" style=\"background: #34C759;\" onclick=\"setAccentColor('#34C759')\"></div><div class=\"color-option\" style=\"background: #FF9500;\" onclick=\"setAccentColor('#FF9500')\"></div><div class=\"color-option\" style=\"background: #AF52DE;\" onclick=\"setAccentColor('#AF52DE')\"></div><div class=\"color-option\" style=\"background: #FF2D55;\" onclick=\"setAccentColor('#FF2D55')\"></div></div></div><div id=\"wallpaperPage\" class=\"page hidden\"><div class=\"page-header\"><button onclick=\"showMain()\" class=\"back-btn\">← Назад</button><h2>Обои</h2></div><div class=\"wallpaper-grid\"><div class=\"wallpaper-option\" onclick=\"setWallpaper('gradient1')\"><div class=\"wallpaper-preview gradient1\"></div><div class=\"wallpaper-name\">Космос</div></div><div class=\"wallpaper-option\" onclick=\"setWallpaper('gradient2')\"><div class=\"wallpaper-preview gradient2\"></div><div class=\"wallpaper-name\">Закат</div></div><div class=\"wallpaper-option\" onclick=\"setWallpaper('gradient3')\"><div class=\"wallpaper-preview gradient3\"></div><div class=\"wallpaper-name\">Океан</div></div><div class=\"wallpaper-option\" onclick=\"setWallpaper('gradient4')\"><div class=\"wallpaper-preview gradient4\"></div><div class=\"wallpaper-name\">Неон</div></div><div class=\"wallpaper-option\" onclick=\"setWallpaper('dark')\"><div class=\"wallpaper-preview dark\"></div><div class=\"wallpaper-name\">Тёмный</div></div><div class=\"wallpaper-option\" onclick=\"setWallpaper('light')\"><div class=\"wallpaper-preview light\"></div><div class=\"wallpaper-name\">Светлый</div></div></div></div><div id=\"aboutPage\" class=\"page hidden\"><div class=\"page-header\"><button onclick=\"showMain()\" class=\"back-btn\">← Назад</button><h2>О телефоне</h2></div><div class=\"about-card\"><div class=\"about-icon\"><span class=\"material-icons\" style=\"font-size: 64px;\">smartphone</span></div><div class=\"about-model\" id=\"aboutModel\">ePhone 14</div><div class=\"about-os\" id=\"aboutOS\">EOS 18.1</div></div><div class=\"info-list\"><div class=\"info-item\"><span class=\"info-label\">Имя устройства</span><span class=\"info-value\" id=\"infoName\">ePhone</span></div><div class=\"info-item\"><span class=\"info-label\">Версия ПО</span><span class=\"info-value\" id=\"infoVersion\">EOS 18.1</span></div><div class=\"info-item\"><span class=\"info-label\">Модель</span><span class=\"info-value\" id=\"infoModel\">ePhone 14</span></div><div class=\"info-item\"><span class=\"info-label\">Серийный номер</span><span class=\"info-value\" id=\"infoSerial\">C8QXK9F1J7H3</span></div><div class=\"info-item\"><span class=\"info-label\">IMEI</span><span class=\"info-value\" id=\"infoIMEI\">356938035643809</span></div><div class=\"info-item\"><span class=\"info-label\">Память</span><span class=\"info-value\">34 ГБ из 128 ГБ</span></div><div class=\"info-item\"><span class=\"info-label\">Доступно</span><span class=\"info-value\">94 ГБ</span></div></div><div class=\"storage-bar\"><div class=\"storage-used\" style=\"width: 26.5%;\"></div></div><div class=\"storage-legend\"><div class=\"legend-item\"><div class=\"legend-color used\"></div><span>Использовано (34 ГБ)</span></div><div class=\"legend-item\"><div class=\"legend-color free\"></div><span>Свободно (94 ГБ)</span></div></div></div><div id=\"generalPage\" class=\"page hidden\"><div class=\"page-header\"><button onclick=\"showMain()\" class=\"back-btn\">← Назад</button><h2>Основные</h2></div><div class=\"section-title\">Имя устройства</div><div class=\"input-container\"><input type=\"text\" id=\"deviceName\" value=\"ePhone\" onchange=\"setDeviceName(this.value)\"></div><div class=\"section-title\">Язык</div><div class=\"input-container\"><select id=\"languageSelect\" onchange=\"setLanguage(this.value)\"><option value=\"Русский\">Русский</option><option value=\"English\">English</option><option value=\"Deutsch\">Deutsch</option><option value=\"Français\">Français</option></select></div><div class=\"section-title\">Другие настройки</div><div class=\"setting-item\"><span>Тактильный отклик</span><label class=\"switch\"><input type=\"checkbox\" id=\"hapticToggle\" checked onchange=\"toggleSetting('haptic')\"><span class=\"slider\"></span></label></div></div></div><style>.settings-app{padding:20px}.settings-app h1{font-size:24px;margin-bottom:20px;display:flex;align-items:center;gap:8px}.profile{display:flex;align-items:center;gap:12px;padding:15px;background:rgba(128,128,128,0.2);border-radius:12px;margin-bottom:20px;cursor:pointer}.avatar{width:50px;height:50px;background:linear-gradient(135deg,#667eea,#764ba2);border-radius:50%;display:flex;align-items:center;justify-content:center}.avatar .material-icons{font-size:28px;color:white}.avatar-large{width:80px;height:80px;background:linear-gradient(135deg,#667eea,#764ba2);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 15px}.avatar-large .material-icons{font-size:48px;color:white}.profile-info{flex:1}.name{font-size:16px;font-weight:600}.subtitle{font-size:12px;opacity:0.7}.chevron{opacity:0.5}.settings-list{display:flex;flex-direction:column;gap:8px}.setting-item{display:flex;align-items:center;gap:12px;padding:12px;background:rgba(128,128,128,0.2);border-radius:12px;cursor:pointer}.setting-item .icon{font-size:20px}.setting-item span:not(.icon):not(.chevron):not(.value):not(.badge){flex:1}.value{opacity:0.7;font-size:14px}.badge{background:rgba(128,128,128,0.3);padding:2px 8px;border-radius:10px;font-size:12px}.switch{position:relative;width:50px;height:30px;flex-shrink:0}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;cursor:pointer;inset:0;background:#888;border-radius:30px;transition:0.3s}.slider:before{content:'';position:absolute;height:24px;width:24px;left:3px;bottom:3px;background:white;border-radius:50%;transition:0.3s}input:checked+.slider{background:#34c759}input:checked+.slider:before{transform:translateX(20px)}.footer{margin-top:30px;text-align:center;opacity:0.5;font-size:12px}.hidden{display:none!important}.page-header{display:flex;align-items:center;gap:12px;margin-bottom:20px}.back-btn{background:none;border:none;color:#007aff;font-size:14px;cursor:pointer;padding:0}.page-header h2{font-size:18px;font-weight:600}.section-title{font-size:14px;font-weight:600;margin:20px 0 10px;opacity:0.7}.model-selector{display:flex;flex-direction:column;gap:8px}.model-option{display:flex;align-items:center;gap:12px;padding:12px;background:rgba(128,128,128,0.2);border-radius:12px;cursor:pointer}.model-option.active{background:rgba(0,122,255,0.2);border:1px solid #007aff}.model-name{font-weight:600}.model-desc{font-size:12px;opacity:0.7}.check{margin-left:auto;color:#007aff;font-weight:bold;display:none}.model-option.active .check{display:block}.hint{font-size:12px;opacity:0.5;margin-top:8px}.slider-container{padding:12px;background:rgba(128,128,128,0.2);border-radius:12px}.slider-container input[type=\"range\"]{width:100%}.slider-value{text-align:center;margin-top:8px;opacity:0.7}.font-size-selector{display:flex;gap:8px}.font-btn{flex:1;padding:10px;background:rgba(128,128,128,0.2);border:none;border-radius:8px;cursor:pointer;font-size:16px}.font-btn.active{background:#007aff;color:white}.color-selector{display:flex;gap:12px;flex-wrap:wrap}.color-option{width:32px;height:32px;border-radius:50%;cursor:pointer;border:2px solid transparent}.color-option.active{border-color:white;transform:scale(1.1)}.wallpaper-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.wallpaper-option{cursor:pointer}.wallpaper-preview{width:100%;height:120px;border-radius:12px}.wallpaper-name{text-align:center;margin-top:8px;font-size:14px}.gradient1{background:linear-gradient(to bottom,#312e81,#581c87,#000)}.gradient2{background:linear-gradient(to bottom,#881337,#9a3412,#92400e)}.gradient3{background:linear-gradient(to bottom,#064e3b,#134e4a,#164e63)}.gradient4{background:linear-gradient(to bottom,#312e81,#701a75,#831843)}.dark{background:linear-gradient(to bottom,#111827,#000)}.light{background:linear-gradient(to bottom,#bfdbfe,#ddd6fe,#fce7f3)}.input-container{padding:12px;background:rgba(128,128,128,0.2);border-radius:12px}.input-container input,.input-container select{width:100%;background:rgba(128,128,128,0.3);border:none;border-radius:8px;padding:8px 12px;color:inherit;font-size:14px}.profile-card{text-align:center;padding:30px;background:rgba(128,128,128,0.2);border-radius:12px;margin-bottom:20px}.profile-name{font-size:20px;font-weight:600;margin-bottom:5px}.profile-email{font-size:14px;opacity:0.7}.logout-btn{width:100%;padding:12px;background:rgba(255,59,48,0.2);color:#ff3b30;border:none;border-radius:12px;font-weight:600;cursor:pointer;margin-top:20px}.about-card{text-align:center;padding:30px;background:rgba(128,128,128,0.2);border-radius:12px;margin-bottom:20px}.about-icon{margin-bottom:15px;opacity:0.8}.about-model{font-size:24px;font-weight:700;margin-bottom:5px}.about-os{font-size:16px;opacity:0.7}.info-list{display:flex;flex-direction:column;gap:1px;background:rgba(128,128,128,0.1);border-radius:12px;overflow:hidden;margin-bottom:20px}.info-item{display:flex;justify-content:space-between;align-items:center;padding:12px;background:rgba(128,128,128,0.2)}.info-label{font-size:14px;opacity:0.7}.info-value{font-size:14px;font-weight:500}.storage-bar{height:20px;background:rgba(128,128,128,0.2);border-radius:10px;overflow:hidden;margin-bottom:15px}.storage-used{height:100%;background:linear-gradient(90deg,#007aff,#5856d6);border-radius:10px}.storage-legend{display:flex;gap:20px;justify-content:center}.legend-item{display:flex;align-items:center;gap:6px;font-size:12px}.legend-color{width:12px;height:12px;border-radius:3px}.legend-color.used{background:linear-gradient(90deg,#007aff,#5856d6)}.legend-color.free{background:rgba(128,128,128,0.3)}</style><script>var settings=ePhone.getSettings();var app=document.getElementById('settingsApp');app.style.color=settings.darkMode?'white':'black';document.getElementById('userName').textContent=settings.name;document.getElementById('profileName').textContent=settings.name;document.getElementById('modelBadge').textContent=settings.phoneModel==='iphone8'?'ePhone 8':settings.phoneModel==='iphonex'?'ePhone X':'ePhone 14';document.getElementById('darkModeToggle').checked=settings.darkMode;document.getElementById('brightnessSlider').value=settings.brightness;document.getElementById('brightnessValue').textContent=settings.brightness+'%';document.getElementById('notifToggle').checked=settings.notifications;document.getElementById('soundToggle').checked=settings.sound;document.getElementById('hapticToggle').checked=settings.haptic;document.getElementById('deviceName').value=settings.name;document.getElementById('languageSelect').value=settings.language;['iphone8','iphonex','iphone14'].forEach(function(model){var el=document.getElementById('model-'+model);if(settings.phoneModel===model)el.classList.add('active')});document.getElementById('islandToggle').checked=!settings.disableIsland;if(settings.phoneModel!=='iphone14'){document.getElementById('islandToggle').disabled=true;document.getElementById('islandHint').style.display='block'}else{document.getElementById('islandHint').style.display='none'}document.querySelectorAll('.font-btn').forEach(function(btn){btn.classList.remove('active')});var fontBtn=document.getElementById('font-'+settings.fontSize);if(fontBtn)fontBtn.classList.add('active');var modelNames={'iphone8':'ePhone 8','iphonex':'ePhone X','iphone14':'ePhone 14'};var osVersions={'iphone8':'EOS 16','iphonex':'EOS 16.5','iphone14':'EOS 18.1'};document.getElementById('aboutModel').textContent=modelNames[settings.phoneModel];document.getElementById('aboutOS').textContent=osVersions[settings.phoneModel];document.getElementById('infoModel').textContent=modelNames[settings.phoneModel];document.getElementById('infoVersion').textContent=osVersions[settings.phoneModel];document.getElementById('infoName').textContent=settings.name;function generateSerial(){var chars='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';var serial='';for(var i=0;i<12;i++){serial+=chars.charAt(Math.floor(Math.random()*chars.length))}return serial}function generateIMEI(){var imei='';for(var i=0;i<15;i++){imei+=Math.floor(Math.random()*10)}return imei}document.getElementById('infoSerial').textContent=generateSerial();document.getElementById('infoIMEI').textContent=generateIMEI();function showSection(section){document.getElementById('mainPage').classList.add('hidden');var pageId=section+'Page';var page=document.getElementById(pageId);if(page){page.classList.remove('hidden')}else{console.warn('Page not found:',pageId)}}function showMain(){document.querySelectorAll('.page').forEach(function(p){p.classList.add('hidden')});document.getElementById('mainPage').classList.remove('hidden')}function toggleSetting(key){var settings=ePhone.getSettings();var updates={};if(key==='darkMode'){updates.darkMode=!settings.darkMode;app.style.color=updates.darkMode?'white':'black'}else if(key==='notifications'){updates.notifications=!settings.notifications}else if(key==='sound'){updates.sound=!settings.sound}else if(key==='haptic'){updates.haptic=!settings.haptic}else if(key==='disableIsland'){updates.disableIsland=!settings.disableIsland}ePhone.setSettings(updates)}function setModel(model){ePhone.switchModel(model);setTimeout(function(){location.reload()},500)}function setWallpaper(wallpaper){ePhone.setSettings({wallpaper:wallpaper})}function setBrightness(value){document.getElementById('brightnessValue').textContent=value+'%';ePhone.setSettings({brightness:parseInt(value)})}function setFontSize(size){document.querySelectorAll('.font-btn').forEach(function(btn){btn.classList.remove('active')});var btn=document.getElementById('font-'+size);if(btn)btn.classList.add('active');ePhone.setSettings({fontSize:size})}function setAccentColor(color){document.querySelectorAll('.color-option').forEach(function(el){el.classList.remove('active')});event.target.classList.add('active');ePhone.setSettings({accentColor:color})}function setDeviceName(name){ePhone.setSettings({name:name});document.getElementById('userName').textContent=name;document.getElementById('profileName').textContent=name;document.getElementById('infoName').textContent=name}function setLanguage(lang){ePhone.setSettings({language:lang})}</script>"
}
