{
  "id": "settings_system",
  "name": "Настройки",
  "icon": "material:settings",
  "color": "from-gray-400 to-gray-600",
  "version": "5.2.0",
  "author": "ePhone System",
  "description": "Системные настройки (iPhone: список, iPad: split view). AOD: вкл/выкл и расположение часов — выпадающий список.",
  "supportedModels": [
    "iphone8",
    "iphonex",
    "iphone14",
    "epad101"
  ],
  "isSystem": true,
  "eappVersion": "1.1",
  "code": "<div class=\"settings-app\" id=\"settingsApp\"></div><style>*{margin:0;padding:0;box-sizing:border-box}.settings-app{width:100%;height:100%;background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%);color:white;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display',sans-serif;overflow:hidden}.iphone-layout{height:100%;overflow-y:auto;padding:20px}.iphone-header{font-size:28px;font-weight:700;margin-bottom:20px}.iphone-section{margin-bottom:24px}.iphone-section-title{font-size:12px;font-weight:600;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;padding-left:4px}.iphone-item{display:flex;align-items:center;gap:12px;padding:14px 16px;background:rgba(255,255,255,0.06);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.1);border-radius:12px;margin-bottom:8px;cursor:pointer;transition:all 0.2s}.iphone-item:hover{background:rgba(255,255,255,0.1)}.iphone-item .material-icons{font-size:22px;width:24px}.iphone-item .label{flex:1;font-size:15px}.iphone-item .value{font-size:14px;color:rgba(255,255,255,0.5)}.iphone-item .chevron{opacity:0.5}.ipad-layout{display:flex;width:100%;height:100%}.ipad-sidebar{width:280px;background:rgba(0,0,0,0.3);backdrop-filter:blur(20px);border-right:1px solid rgba(255,255,255,0.1);display:flex;flex-direction:column;overflow:hidden}.ipad-sidebar-header{padding:20px;display:flex;align-items:center;gap:12px;border-bottom:1px solid rgba(255,255,255,0.1)}.ipad-sidebar-header h2{font-size:20px;font-weight:600}.ipad-sidebar-header .material-icons{font-size:28px}.ipad-sidebar-menu{flex:1;overflow-y:auto;padding:10px}.ipad-menu-item{display:flex;align-items:center;gap:12px;padding:12px 16px;border-radius:10px;cursor:pointer;transition:all 0.2s;margin-bottom:4px}.ipad-menu-item:hover{background:rgba(255,255,255,0.08)}.ipad-menu-item.active{background:rgba(0,122,255,0.3);color:#4fc3f7}.ipad-menu-item .material-icons{font-size:22px;width:24px}.ipad-menu-item span:last-child{flex:1;font-size:15px}.ipad-main{flex:1;display:flex;flex-direction:column;overflow:hidden}.ipad-content-header{padding:20px 30px;border-bottom:1px solid rgba(255,255,255,0.1)}.ipad-content-header h1{font-size:28px;font-weight:700}.ipad-content-body{flex:1;overflow-y:auto;padding:20px 30px}.section{margin-bottom:30px}.section-title{font-size:13px;font-weight:600;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:1px;margin-bottom:12px}.setting-item{display:flex;align-items:center;gap:12px;padding:14px 16px;background:rgba(255,255,255,0.06);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.1);border-radius:12px;margin-bottom:8px;cursor:pointer;transition:all 0.2s}.setting-item:hover{background:rgba(255,255,255,0.1)}.setting-item .material-icons{font-size:22px;width:24px}.setting-item .label{flex:1;font-size:15px}.setting-item .value{font-size:14px;color:rgba(255,255,255,0.5)}.switch{position:relative;width:50px;height:30px;flex-shrink:0}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;cursor:pointer;inset:0;background:rgba(255,255,255,0.2);border-radius:30px;transition:0.3s}.slider:before{content:'';position:absolute;height:24px;width:24px;left:3px;bottom:3px;background:white;border-radius:50%;transition:0.3s}input:checked+.slider{background:#34c759}input:checked+.slider:before{transform:translateX(20px)}.model-selector{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.model-option{padding:16px;background:rgba(255,255,255,0.06);border:2px solid rgba(255,255,255,0.1);border-radius:14px;cursor:pointer;transition:all 0.2s;text-align:center}.model-option:hover{background:rgba(255,255,255,0.1)}.model-option.active{background:rgba(0,122,255,0.2);border-color:#007aff}.model-name{font-size:16px;font-weight:600;margin-bottom:4px}.model-desc{font-size:12px;opacity:0.6}.input-field{width:100%;padding:12px 16px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:10px;color:white;font-size:15px;outline:none;transition:all 0.2s}.input-field:focus{background:rgba(255,255,255,0.1);border-color:#007aff}.select-field{width:100%;padding:12px 16px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:10px;color:white;font-size:15px;outline:none;cursor:pointer}.select-field option{background:#1a1a2e;color:white}.slider-container{padding:16px;background:rgba(255,255,255,0.06);border-radius:12px}.slider-container input[type=\"range\"]{width:100%;margin-bottom:8px}.slider-value{text-align:center;font-size:14px;opacity:0.7}.color-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}.color-option{width:40px;height:40px;border-radius:50%;cursor:pointer;border:3px solid transparent;transition:all 0.2s}.color-option:hover{transform:scale(1.1)}.color-option.active{border-color:white;transform:scale(1.15)}.wallpaper-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.wallpaper-option{cursor:pointer;transition:all 0.2s}.wallpaper-option:hover{transform:scale(1.05)}.wallpaper-preview{width:100%;height:120px;border-radius:12px;border:2px solid transparent}.wallpaper-option.active .wallpaper-preview{border-color:#007aff}.wallpaper-name{text-align:center;margin-top:8px;font-size:13px}.gradient1{background:linear-gradient(135deg,#667eea,#764ba2)}.gradient2{background:linear-gradient(135deg,#f093fb,#f5576c)}.gradient3{background:linear-gradient(135deg,#4facfe,#00f2fe)}.gradient4{background:linear-gradient(135deg,#43e97b,#38f9d7)}.dark{background:linear-gradient(135deg,#0f0c29,#302b63,#24243e)}.light{background:linear-gradient(135deg,#ffecd2,#fcb69f)}.info-card{background:rgba(255,255,255,0.06);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:20px;margin-bottom:16px}.info-row{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid rgba(255,255,255,0.1)}.info-row:last-child{border-bottom:none}.info-label{font-size:14px;opacity:0.6}.info-value{font-size:14px;font-weight:500}</style><script>var settings=ePhone.getSettings();\nvar isPad=settings.phoneModel==='epad101';\nvar currentSection='general';\nvar app=document.getElementById('settingsApp');\nfunction esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;')}\nfunction init(){if(isPad){renderIPad()}else{renderIPhone()}}\nvar MODEL_NAMES={'iphone8':'ePhone 8','iphonex':'ePhone X','iphone14':'ePhone 14','epad101':'ePad 10.1”'};\nfunction modelOptionsHTML(){\n var h='';\n ['iphone8','iphonex','iphone14','epad101'].forEach(function(m){\n  var desc=m==='iphone8'?'Классический':m==='iphonex'?'Безрамочный':m==='iphone14'?'Dynamic Island':'Планшет';\n  h+='<div class=\"model-option'+(settings.phoneModel===m?' active':'')+'\" onclick=\"setModel(\\''+m+'\\')\"><div class=\"model-name\">'+esc(MODEL_NAMES[m])+'</div><div class=\"model-desc\">'+desc+'</div></div>';\n });\n return h;\n}\nfunction renderIPhone(){\n var html='<div class=\"iphone-layout\">';\n html+='<div class=\"iphone-header\">Настройки</div>';\n html+='<div class=\"iphone-section\"><div class=\"iphone-section-title\">Устройство</div>';\n html+='<div class=\"iphone-item\" onclick=\"showIPhoneSection(\\'device\\')\"><span class=\"material-icons\">palette</span><span class=\"label\">Модель устройства</span><span class=\"value\">'+esc(MODEL_NAMES[settings.phoneModel])+'</span><span class=\"material-icons chevron\">chevron_right</span></div></div>';\n html+='<div class=\"iphone-section\"><div class=\"iphone-section-title\">Экран</div>';\n html+='<div class=\"iphone-item\"><span class=\"material-icons\">dark_mode</span><span class=\"label\">Тёмная тема</span><label class=\"switch\"><input type=\"checkbox\"'+(settings.darkMode?' checked':'')+' onchange=\"toggleSetting(\\'darkMode\\')\"><span class=\"slider\"></span></label></div>';\n html+='<div class=\"iphone-item\"><span class=\"material-icons\">brightness_6</span><span class=\"label\">Яркость</span><span class=\"value\">'+esc(settings.brightness)+'%</span></div></div>';\n html+='<div class=\"iphone-section\"><div class=\"iphone-section-title\">Система</div>';\n html+='<div class=\"iphone-item\"><span class=\"material-icons\">vibration</span><span class=\"label\">Тактильный отклик</span><label class=\"switch\"><input type=\"checkbox\"'+(settings.haptic?' checked':'')+' onchange=\"toggleSetting(\\'haptic\\')\"><span class=\"slider\"></span></label></div>';\n html+='<div class=\"iphone-item\"><span class=\"material-icons\">volume_up</span><span class=\"label\">Звуки</span><label class=\"switch\"><input type=\"checkbox\"'+(settings.sound?' checked':'')+' onchange=\"toggleSetting(\\'sound\\')\"><span class=\"slider\"></span></label></div>';\n html+='<div class=\"iphone-item\"><span class=\"material-icons\">notifications</span><span class=\"label\">Уведомления</span><label class=\"switch\"><input type=\"checkbox\"'+(settings.notifications?' checked':'')+' onchange=\"toggleSetting(\\'notifications\\')\"><span class=\"slider\"></span></label></div></div>';\n html+='<div class=\"iphone-section\"><div class=\"iphone-section-title\">Экран всегда включён (AOD)</div>';\n html+='<div class=\"iphone-item\"><span class=\"material-icons\">schedule</span><span class=\"label\">Часы при выключенном экране</span><label class=\"switch\"><input type=\"checkbox\"'+(settings.aodEnabled?' checked':'')+' onchange=\"toggleSetting(\\'aodEnabled\\')\"><span class=\"slider\"></span></label></div>';\n html+='<div class=\"iphone-item\" style=\"flex-wrap:wrap\"><span class=\"material-icons\">my_location</span><span class=\"label\">Расположение часов</span><select class=\"select-field\" style=\"width:190px\" onchange=\"setAodPosition(this.value)\">'+aodPositionOptions()+'</select></div></div>';\n html+='<div class=\"iphone-section\"><div class=\"iphone-section-title\">Dynamic Island</div>';\n html+='<div class=\"iphone-item\"><span class=\"material-icons\">lens</span><span class=\"label\">Включить</span><label class=\"switch\"><input type=\"checkbox\"'+(!settings.disableIsland?' checked':'')+' onchange=\"toggleSetting(\\'disableIsland\\')\"'+(settings.phoneModel!=='iphone14'?' disabled':'')+'><span class=\"slider\"></span></label></div></div>';\n html+='</div>';\n app.innerHTML=html;\n}\nfunction showIPhoneSection(section){\n if(section==='device'){\n  var html='<div class=\"iphone-layout\"><div class=\"iphone-header\">Модель устройства</div><div class=\"iphone-section\"><div class=\"model-selector\">';\n  html+=modelOptionsHTML();\n  html+='</div></div><button onclick=\"init()\" style=\"margin-top:20px;padding:12px 24px;background:#007aff;color:white;border:none;border-radius:12px;font-size:15px;cursor:pointer\">← Назад</button></div>';\n  app.innerHTML=html;\n }\n}\nfunction renderIPad(){\n var html='<div class=\"ipad-layout\"><div class=\"ipad-sidebar\"><div class=\"ipad-sidebar-header\"><span class=\"material-icons\">settings</span><h2>Настройки</h2></div><div class=\"ipad-sidebar-menu\" id=\"sidebarMenu\"></div></div>';\n html+='<div class=\"ipad-main\"><div class=\"ipad-content-header\"><h1 id=\"pageTitle\">Основные</h1></div><div class=\"ipad-content-body\" id=\"contentBody\"></div></div></div>';\n app.innerHTML=html;\n renderIPadMenu();\n showIPadSection('general');\n}\nfunction renderIPadMenu(){\n var menu=document.getElementById('sidebarMenu');\n if(!menu)return;\n var items=[{id:'general',icon:'tune',label:'Основные'},{id:'device',icon:'palette',label:'Устройство'},{id:'display',icon:'brightness_6',label:'Экран и яркость'},{id:'wallpaper',icon:'image',label:'Обои'},{id:'aod',icon:'schedule',label:'AOD (Всегда включён)'},{id:'multitasking',icon:'view_carousel',label:'Мультизадачность'},{id:'about',icon:'info',label:'О устройстве'}];\n menu.innerHTML=items.map(function(item){\n  return '<div class=\"ipad-menu-item'+(item.id===currentSection?' active':'')+'\" onclick=\"showIPadSection(\\''+item.id+'\\')\"><span class=\"material-icons\">'+item.icon+'</span><span>'+item.label+'</span></div>';\n }).join('');\n}\nfunction showIPadSection(section){\n currentSection=section;\n renderIPadMenu();\n var header=document.getElementById('pageTitle');\n var body=document.getElementById('contentBody');\n if(!header||!body)return;\n switch(section){\n  case 'general':header.textContent='Основные';body.innerHTML=renderGeneral();break;\n  case 'device':header.textContent='Устройство';body.innerHTML=renderDevice();break;\n  case 'display':header.textContent='Экран и яркость';body.innerHTML=renderDisplay();break;\n  case 'wallpaper':header.textContent='Обои';body.innerHTML=renderWallpaper();break;\n  case 'aod':header.textContent='AOD (Всегда включённый экран)';body.innerHTML=renderAOD();break;\n  case 'multitasking':header.textContent='Мультизадачность';body.innerHTML=renderMultitasking();break;\n  case 'about':header.textContent='О устройстве';body.innerHTML=renderAbout();break;\n }\n}\nfunction renderGeneral(){\n var h='<div class=\"section\"><div class=\"section-title\">Устройство</div><div class=\"setting-item\"><span class=\"material-icons\">label</span><span class=\"label\">Имя устройства</span><input type=\"text\" class=\"input-field\" value=\"'+esc(settings.name)+'\" onchange=\"setDeviceName(this.value)\" style=\"width:200px\"></div></div>';\n h+='<div class=\"section\"><div class=\"section-title\">Язык и регион</div><div class=\"setting-item\"><span class=\"material-icons\">language</span><span class=\"label\">Язык</span><select class=\"select-field\" onchange=\"setLanguage(this.value)\" style=\"width:200px\">';\n ['Русский','English','Deutsch','Français'].forEach(function(l){h+='<option value=\"'+esc(l)+'\"'+(settings.language===l?' selected':'')+'>'+esc(l)+'</option>'});\n h+='</select></div></div>';\n h+='<div class=\"section\"><div class=\"section-title\">Система</div>';\n h+='<div class=\"setting-item\"><span class=\"material-icons\">vibration</span><span class=\"label\">Тактильный отклик</span><label class=\"switch\"><input type=\"checkbox\"'+(settings.haptic?' checked':'')+' onchange=\"toggleSetting(\\'haptic\\')\"><span class=\"slider\"></span></label></div>';\n h+='<div class=\"setting-item\"><span class=\"material-icons\">volume_up</span><span class=\"label\">Звуки</span><label class=\"switch\"><input type=\"checkbox\"'+(settings.sound?' checked':'')+' onchange=\"toggleSetting(\\'sound\\')\"><span class=\"slider\"></span></label></div>';\n h+='<div class=\"setting-item\"><span class=\"material-icons\">notifications</span><span class=\"label\">Уведомления</span><label class=\"switch\"><input type=\"checkbox\"'+(settings.notifications?' checked':'')+' onchange=\"toggleSetting(\\'notifications\\')\"><span class=\"slider\"></span></label></div></div>';\n return h;\n}\nfunction renderDevice(){\n var h='<div class=\"section\"><div class=\"section-title\">Модель устройства</div><div class=\"model-selector\">';\n h+=modelOptionsHTML();\n h+='</div></div>';\n h+='<div class=\"section\"><div class=\"section-title\">Dynamic Island</div><div class=\"setting-item\"><span class=\"material-icons\">lens</span><span class=\"label\">Включить Dynamic Island</span><label class=\"switch\"><input type=\"checkbox\"'+(!settings.disableIsland?' checked':'')+' onchange=\"toggleSetting(\\'disableIsland\\')\"'+(settings.phoneModel!=='iphone14'&&settings.phoneModel!=='epad101'?' disabled':'')+'><span class=\"slider\"></span></label></div></div>';\n return h;\n}\nfunction renderDisplay(){\n var h='<div class=\"section\"><div class=\"section-title\">Тема</div><div class=\"setting-item\"><span class=\"material-icons\">dark_mode</span><span class=\"label\">Тёмная тема</span><label class=\"switch\"><input type=\"checkbox\"'+(settings.darkMode?' checked':'')+' onchange=\"toggleSetting(\\'darkMode\\')\"><span class=\"slider\"></span></label></div></div>';\n h+='<div class=\"section\"><div class=\"section-title\">Яркость</div><div class=\"slider-container\"><input type=\"range\" min=\"30\" max=\"100\" value=\"'+esc(settings.brightness)+'\" oninput=\"setBrightness(this.value)\"><div class=\"slider-value\">'+esc(settings.brightness)+'%</div></div></div>';\n h+='<div class=\"section\"><div class=\"section-title\">Размер текста</div>';\n [['small','Маленький'],['medium','Средний'],['large','Большой']].forEach(function(f){\n  h+='<div class=\"setting-item\"><span class=\"material-icons\">format_size</span><span class=\"label\">'+f[1]+'</span><input type=\"radio\" name=\"fontSize\" value=\"'+f[0]+'\"'+(settings.fontSize===f[0]?' checked':'')+' onchange=\"setFontSize(\\''+f[0]+'\\')\"></div>';\n });\n h+='</div>';\n h+='<div class=\"section\"><div class=\"section-title\">Цвет акцента</div><div class=\"color-grid\">';\n ['#007AFF','#FF3B30','#34C759','#FF9500','#AF52DE','#FF2D55'].forEach(function(c){\n  h+='<div class=\"color-option'+(String(settings.accentColor).toUpperCase()===c?' active':'')+'\" style=\"background:'+c+'\" onclick=\"setAccentColor(\\''+c+'\\')\"></div>';\n });\n h+='</div></div>';\n return h;\n}\nfunction renderWallpaper(){\n var wallpapers=[{id:'gradient1',name:'Космос'},{id:'gradient2',name:'Закат'},{id:'gradient3',name:'Океан'},{id:'gradient4',name:'Неон'},{id:'dark',name:'Тёмный'},{id:'light',name:'Светлый'}];\n var h='<div class=\"section\"><div class=\"section-title\">Выберите обои</div><div class=\"wallpaper-grid\">';\n wallpapers.forEach(function(wp){\n  h+='<div class=\"wallpaper-option'+(settings.wallpaper===wp.id?' active':'')+'\" onclick=\"setWallpaper(\\''+wp.id+'\\')\"><div class=\"wallpaper-preview '+wp.id+'\"></div><div class=\"wallpaper-name\">'+wp.name+'</div></div>';\n });\n h+='</div></div>';\n return h;\n}\nvar AOD_POSITIONS=['top-left','top-center','top-right','center','bottom-left','bottom-center','bottom-right'];\nvar AOD_POSITION_NAMES={'top-left':'Сверху слева','top-center':'Сверху по центру','top-right':'Сверху справа','center':'По центру','bottom-left':'Снизу слева','bottom-center':'Снизу по центру','bottom-right':'Снизу справа'};\nfunction aodPositionName(p){return AOD_POSITION_NAMES[p]||AOD_POSITION_NAMES['top-center']}\nfunction aodPositionOptions(){\n var cur=settings.aodPosition||'top-center';\n var h='';\n for(var i=0;i<AOD_POSITIONS.length;i++){\n  h+='<option value=\"'+AOD_POSITIONS[i]+'\"'+(AOD_POSITIONS[i]===cur?' selected':'')+'>'+aodPositionName(AOD_POSITIONS[i])+'</option>';\n }\n return h;\n}\nfunction setAodPosition(p){ePhone.setSettings({aodPosition:p});settings.aodPosition=p;init()}\nfunction renderAOD(){\n var h='<div class=\"section\"><div class=\"section-title\">Always On Display</div>';\n h+='<div class=\"setting-item\"><span class=\"material-icons\">schedule</span><span class=\"label\">Включить AOD</span><label class=\"switch\"><input type=\"checkbox\"'+(settings.aodEnabled?' checked':'')+' onchange=\"toggleSetting(\\'aodEnabled\\')\"><span class=\"slider\"></span></label></div>';\n h+='<div class=\"info-card\" style=\"margin-top:16px\"><div style=\"font-size:14px;opacity:0.7;line-height:1.6\">При выключении экрана кнопкой питания (справа) на чёрном экране останутся часы и дата. Нажмите на экран или на кнопку питания, чтобы включить его.</div></div></div>';\n h+='<div class=\"section\"><div class=\"section-title\">Расположение часов</div><div class=\"setting-item\"><span class=\"material-icons\">my_location</span><span class=\"label\">Позиция часов на AOD</span><select class=\"select-field\" style=\"width:240px\" onchange=\"setAodPosition(this.value)\">'+aodPositionOptions()+'</select></div></div>';\n return h;\n}\nfunction renderMultitasking(){\n return '<div class=\"section\"><div class=\"section-title\">Мультизадачность</div><div class=\"setting-item\"><span class=\"material-icons\">view_carousel</span><span class=\"label\">Включить мультизадачность</span><label class=\"switch\"><input type=\"checkbox\"'+(settings.multiTasking?' checked':'')+' onchange=\"toggleSetting(\\'multiTasking\\')\"><span class=\"slider\"></span></label></div><div class=\"info-card\" style=\"margin-top:16px\"><div style=\"font-size:14px;opacity:0.7;line-height:1.6\">Мультизадачность позволяет открывать несколько приложений одновременно в отдельных окнах. Используйте Control Center для управления окнами.</div></div></div>';\n}\nfunction renderAbout(){\n var osVersions={'iphone8':'EOS 16','iphonex':'EOS 16.5','iphone14':'EOS 18.1','epad101':'ePadOS 1.0'};\n var serial=generateSerial();var imei=generateIMEI();\n var rows=[['Модель',MODEL_NAMES[settings.phoneModel]],['Версия ПО',osVersions[settings.phoneModel]||'EOS'],['Имя устройства',settings.name],['Серийный номер',serial],['IMEI',imei],['Память','34 ГБ из 128 ГБ'],['Доступно','94 ГБ']];\n var h='<div class=\"info-card\">';\n rows.forEach(function(r){h+='<div class=\"info-row\"><span class=\"info-label\">'+r[0]+'</span><span class=\"info-value\">'+esc(r[1])+'</span></div>'});\n h+='</div>';\n return h;\n}\nfunction generateSerial(){var chars='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';var s='';for(var i=0;i<12;i++){s+=chars.charAt(Math.floor(Math.random()*chars.length))}return s}\nfunction generateIMEI(){var s='';for(var i=0;i<15;i++){s+=Math.floor(Math.random()*10)}return s}\nfunction toggleSetting(key){var updates={};updates[key]=!settings[key];ePhone.setSettings(updates);settings=Object.assign(settings,updates);init()}\nfunction setModel(model){ePhone.switchModel(model);setTimeout(function(){location.reload()},500)}\nfunction setWallpaper(wallpaper){ePhone.setSettings({wallpaper:wallpaper});settings.wallpaper=wallpaper;init()}\nfunction setBrightness(value){ePhone.setSettings({brightness:parseInt(value)});settings.brightness=parseInt(value);var el=document.querySelector('.slider-value');if(el)el.textContent=value+'%'}\nfunction setFontSize(size){ePhone.setSettings({fontSize:size});settings.fontSize=size;init()}\nfunction setAccentColor(color){ePhone.setSettings({accentColor:color});settings.accentColor=color;init()}\nfunction setDeviceName(name){ePhone.setSettings({name:name});settings.name=name}\nfunction setLanguage(lang){ePhone.setSettings({language:lang});settings.language=lang}\ninit();</script>"
}