{
  "id": "settings_system",
  "name": "Настройки",
  "icon": "material:settings",
  "color": "from-gray-400 to-gray-600",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Системные настройки",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "Системное приложение",
  "code": "<!--\n⚠️ СИСТЕМНОЕ ПРИЛОЖЕНИЕ - НЕ УДАЛЯТЬ:\n- ePhone.getSettings() - получение текущих настроек\n- ePhone.closeApp() - закрытие приложения\n- Все функции setSettings() - изменение настроек\n- Разделы: Epple ID, Настройки сайта, Экран, Обои, Основные\n-->\n<div class=\"settings-app\">\n  <h1><span class=\"material-icons\">settings</span> Настройки</h1>\n  <div class=\"profile\" onclick=\"showSection('apple-id')\">\n    <div class=\"avatar\"><span class=\"material-icons\">person</span></div>\n    <div class=\"profile-info\">\n      <div class=\"name\" id=\"userName\">ePhone</div>\n      <div class=\"subtitle\">Epple ID, iCloud и др.</div>\n    </div>\n    <span class=\"material-icons chevron\">chevron_right</span>\n  </div>\n  <div class=\"section\" id=\"mainSection\">\n    <div class=\"setting-item\" onclick=\"showSection('general')\">\n      <span class=\"material-icons icon\">tune</span>\n      <span>Основные</span>\n      <span class=\"material-icons chevron\">chevron_right</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"showSection('site-settings')\">\n      <span class=\"material-icons icon\">palette</span>\n      <span>Настройки сайта</span>\n      <span class=\"material-icons chevron\">chevron_right</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"showSection('display')\">\n      <span class=\"material-icons icon\">brightness_6</span>\n      <span>Экран и яркость</span>\n      <span class=\"material-icons chevron\">chevron_right</span>\n    </div>\n    <div class=\"setting-item\">\n      <span class=\"material-icons icon\">notifications</span>\n      <span>Уведомления</span>\n      <label class=\"switch\"><input type=\"checkbox\" checked onchange=\"toggleNotifications()\"><span class=\"slider\"></span></label>\n    </div>\n    <div class=\"setting-item\">\n      <span class=\"material-icons icon\">volume_up</span>\n      <span>Звуки</span>\n      <label class=\"switch\"><input type=\"checkbox\" checked onchange=\"toggleSound()\"><span class=\"slider\"></span></label>\n    </div>\n  </div>\n</div>\n\n<style>\n.settings-app { padding: 20px; color: inherit; }\n.settings-app h1 { font-size: 24px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }\n.profile { display: flex; align-items: center; gap: 12px; padding: 15px; background: rgba(128,128,128,0.2); border-radius: 12px; margin-bottom: 20px; cursor: pointer; }\n.avatar { width: 50px; height: 50px; background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 50%; display: flex; align-items: center; justify-content: center; }\n.avatar .material-icons { font-size: 28px; color: white; }\n.profile-info { flex: 1; }\n.name { font-size: 16px; font-weight: 600; }\n.subtitle { font-size: 12px; opacity: 0.7; }\n.chevron { opacity: 0.5; }\n.setting-item { display: flex; align-items: center; gap: 12px; padding: 12px; background: rgba(128,128,128,0.2); border-radius: 12px; margin-bottom: 8px; cursor: pointer; }\n.setting-item .icon { font-size: 20px; }\n.setting-item span:not(.icon):not(.chevron) { flex: 1; }\n.switch { position: relative; width: 50px; height: 30px; }\n.switch input { opacity: 0; width: 0; height: 0; }\n.slider { position: absolute; cursor: pointer; inset: 0; background: #888; border-radius: 30px; transition: 0.3s; }\n.slider:before { content: ''; position: absolute; height: 24px; width: 24px; left: 3px; bottom: 3px; background: white; border-radius: 50%; transition: 0.3s; }\ninput:checked + .slider { background: #34c759; }\ninput:checked + .slider:before { transform: translateX(20px); }\n</style>\n\n<script>\n// ⚠️ НЕ УДАЛЯТЬ: Инициализация настроек\nconst settings = ePhone.getSettings();\ndocument.querySelector('.settings-app').style.color = settings.darkMode ? 'white' : 'black';\ndocument.getElementById('userName').textContent = settings.name;\n\n// ⚠️ НЕ УДАЛЯТЬ: Функции управления настройками\nfunction showSection(section) {\n  alert('Раздел: ' + section + '\\n(В полной версии здесь будет навигация)');\n}\n\nfunction toggleNotifications() {\n  const settings = ePhone.getSettings();\n  // В реальной версии: ePhone.setSettings({...settings, notifications: !settings.notifications})\n  alert('Уведомления переключены');\n}\n\nfunction toggleSound() {\n  const settings = ePhone.getSettings();\n  // В реальной версии: ePhone.setSettings({...settings, sound: !settings.sound})\n  alert('Звуки переключены');\n}\n</script>"
}
