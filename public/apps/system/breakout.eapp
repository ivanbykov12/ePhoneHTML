{"id": "system/breakout.eapp", "name": "eBreakout", "icon": "material:sports_esports", "color": "from-orange-500 to-red-600", "version": "1.0.0", "author": "ePhone Studio", "description": "Арканоид на канвасе", "supportedModels": ["iphone8", "iphonex", "iphone14", "epad101"], "isSystem": true, "eappVersion": "1.0", "changelog": "Первая версия", "code": "\n<div id=\"g\" style=\"width:100%;height:100vh;background:#0b1026;display:flex;flex-direction:column;align-items:center;font-family:sans-serif;color:#fff;\">\n<div style=\"padding:10px;font-size:14px\">Счёт: <b id=\"s\">0</b> · Жизни: <b id=\"l\">3</b></div>\n<canvas id=\"c\" width=\"320\" height=\"480\" style=\"border-radius:12px;touch-action:none\"></canvas>\n<div id=\"msg\" style=\"margin-top:10px;font-size:12px;opacity:.7\">Ведите ракетку пальцем/мышью</div>\n</div>\n<script>\nvar c=document.getElementById('c'),x=c.getContext('2d'),W=320,H=480;\nvar px=W/2,pw=64,ph=10,bx=W/2,by=H-60,vx=2.4,vy=-3,score=0,lives=3,bricks=[];\nfor(var r=0;r<5;r++)for(var q=0;q<8;q++)bricks.push({x:q*39+4,y:r*22+40,a:1,col:['#ef4444','#f97316','#eab308','#22c55e','#3b82f6'][r]});\nfunction draw(){x.clearRect(0,0,W,H);x.fillStyle='#fff';x.fillRect(px-pw/2,H-30,pw,ph);\nx.beginPath();x.arc(bx,by,7,0,7);x.fill();\nbricks.forEach(function(b){if(b.a){x.fillStyle=b.col;x.fillRect(b.x,b.y,35,16);}});\nx.fillStyle='#94a3b8';x.font='12px sans-serif';x.fillText('eBreakout',10,H-8);}\nfunction step(){bx+=vx;by+=vy;\nif(bx<7||bx>W-7)vx=-vx;if(by<47)vy=-vy;\nif(by>H-37&&by>H-28&&bx>px-pw/2-7&&bx<px+pw/2+7){vy=-Math.abs(vy);vx+=(bx-px)/12;}\nif(by>H){lives--;document.getElementById('l').textContent=lives;bx=W/2;by=H-60;vx=2.4;vy=-3;if(lives<=0){document.getElementById('msg').textContent='Игра окончена! Обновите страницу.';return;}}\nfor(var i=0;i<bricks.length;i++){var b=bricks[i];if(b.a&&bx>b.x-7&&bx<b.x+42&&by>b.y-7&&by<b.y+23){b.a=0;vy=-vy;score++;document.getElementById('s').textContent=score;break;}}\ndraw();requestAnimationFrame(step);}\nfunction setP(clientX){var rc=c.getBoundingClientRect();px=Math.max(pw/2,Math.min(W-pw/2,(clientX-rc.left)*(W/rc.width)));}\nc.addEventListener('touchmove',function(e){setP(e.touches[0].clientX);e.preventDefault();},{passive:false});\nwindow.addEventListener('mousemove',function(e){setP(e.clientX);});\ndraw();step();\n</script>\n"}