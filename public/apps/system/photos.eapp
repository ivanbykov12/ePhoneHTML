{
  "id": "photos_system",
  "name": "Фото",
  "icon": "material:photo_library",
  "color": "from-pink-400 to-purple-500",
  "version": "3.0.0",
  "author": "ePhone System",
  "description": "Галерея фотографий с новым дизайном",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "eappVersion": "1.1",
  "code": "<div class=\"app\"><div class=\"header\"><span class=\"material-icons\">photo_library</span><h1>Фото</h1></div><div class=\"photos-count\" id=\"photosCount\"></div><div class=\"photos-grid\" id=\"photosGrid\"></div><div id=\"modal\" class=\"modal hidden\"><div class=\"modal-content\"><div id=\"modalEmoji\" style=\"font-size:80px;\"></div><h3 id=\"modalTitle\"></h3><p id=\"modalText\"></p><button onclick=\"closeModal()\" class=\"modal-btn\">OK</button></div></div></div><style>.app{padding:20px;height:100%;display:flex;flex-direction:column;background:linear-gradient(135deg,#0a0a0a 0%,#1a1a2e 100%);color:white}.header{display:flex;align-items:center;gap:8px;margin-bottom:10px}.header h1{font-size:24px;font-weight:600}.photos-count{font-size:14px;opacity:0.6;margin-bottom:20px}.photos-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;flex:1;overflow-y:auto}.photo-item{aspect-ratio:1;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:40px;cursor:pointer;transition:all 0.2s;box-shadow:0 4px 15px rgba(0,0,0,0.2)}.photo-item:active{transform:scale(0.92)}.modal{position:fixed;inset:0;background:rgba(0,0,0,0.8);backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:center;z-index:1000}.modal.hidden{display:none}.modal-content{background:rgba(30,30,40,0.95);backdrop-filter:blur(40px);border:1px solid rgba(255,255,255,0.1);border-radius:20px;padding:30px;max-width:300px;text-align:center;animation:fadeIn 0.3s ease}@keyframes fadeIn{from{opacity:0;transform:scale(0.9)}to{opacity:1;transform:scale(1)}}.modal-content h3{margin:15px 0;font-size:20px;font-weight:600}.modal-content p{opacity:0.6;margin-bottom:20px}.modal-btn{padding:12px 36px;background:linear-gradient(135deg,#ec4899,#a855f7);color:white;border:none;border-radius:20px;font-weight:600;cursor:pointer;box-shadow:0 4px 15px rgba(168,85,247,0.3);transition:all 0.2s}.modal-btn:active{transform:scale(0.95)}</style><script>var s=ePhone.getSettings();var photos=[{id:1,emoji:'🌅',color:'linear-gradient(135deg,#ff6b6b,#ee5a6f)',label:'Закат'},{id:2,emoji:'🌲',color:'linear-gradient(135deg,#00b894,#00cec9)',label:'Лес'},{id:3,emoji:'🏖',color:'linear-gradient(135deg,#0984e3,#74b9ff)',label:'Пляж'},{id:4,emoji:'🌃',color:'linear-gradient(135deg,#6c5ce7,#a29bfe)',label:'Город'},{id:5,emoji:'🌻',color:'linear-gradient(135deg,#fdcb6e,#ffeaa7)',label:'Цветы'},{id:6,emoji:'🐱',color:'linear-gradient(135deg,#fd79a8,#fab1a0)',label:'Котик'},{id:7,emoji:'🏔',color:'linear-gradient(135deg,#00b894,#55efc4)',label:'Горы'},{id:8,emoji:'🍂',color:'linear-gradient(135deg,#e17055,#fab1a0)',label:'Осень'},{id:9,emoji:'🌊',color:'linear-gradient(135deg,#00cec9,#81ecec)',label:'Океан'},{id:10,emoji:'🦋',color:'linear-gradient(135deg,#a29bfe,#dfe6e9)',label:'Бабочка'},{id:11,emoji:'🌞',color:'linear-gradient(135deg,#ffeaa7,#fdcb6e)',label:'Солнце'},{id:12,emoji:'🍀',color:'linear-gradient(135deg,#00b894,#55efc4)',label:'Удача'}];function showModal(emoji,label){document.getElementById('modalEmoji').textContent=emoji;document.getElementById('modalTitle').textContent=label;document.getElementById('modalText').textContent='В полной версии здесь будет просмотр на весь экран';document.getElementById('modal').classList.remove('hidden')}function closeModal(){document.getElementById('modal').classList.add('hidden')}function loadPhotos(){document.getElementById('photosCount').textContent=photos.length+' фото';var grid=document.getElementById('photosGrid');grid.innerHTML=photos.map(function(photo){return '<div class=\"photo-item\" style=\"background:'+photo.color+'\" onclick=\"viewPhoto('+photo.id+')\">'+photo.emoji+'</div>'}).join('')}function viewPhoto(id){var photo=photos.find(function(p){return p.id===id});if(!photo)return;showModal(photo.emoji,photo.label)}loadPhotos();</script>"
}
