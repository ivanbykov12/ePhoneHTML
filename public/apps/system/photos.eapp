{
  "id": "photos_system",
  "name": "Фото",
  "icon": "material:photo_library",
  "color": "from-pink-400 to-purple-500",
  "version": "2.0.0",
  "author": "ePhone System",
  "description": "Галерея фотографий",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "v2.0 - Исправлены alert()",
  "code": "<div class=\"photos-app\"><h1><span class=\"material-icons\">photo_library</span> Фото</h1><div class=\"photos-count\" id=\"photosCount\"></div><div class=\"photos-grid\" id=\"photosGrid\"></div><div id=\"modal\" class=\"modal hidden\"><div class=\"modal-content\"><div id=\"modalEmoji\" style=\"font-size:80px;\"></div><h3 id=\"modalTitle\"></h3><p id=\"modalText\"></p><button onclick=\"closeModal()\" class=\"modal-btn\">OK</button></div></div></div><style>.photos-app{padding:20px}.photos-app h1{font-size:24px;margin-bottom:10px;display:flex;align-items:center;gap:8px}.photos-count{font-size:14px;opacity:0.7;margin-bottom:20px}.photos-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.photo-item{aspect-ratio:1;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:40px;cursor:pointer;transition:transform 0.2s}.photo-item:active{transform:scale(0.95)}.modal{position:fixed;inset:0;background:rgba(0,0,0,0.7);display:flex;align-items:center;justify-content:center;z-index:1000}.modal.hidden{display:none}.modal-content{background:#1c1c1e;border-radius:16px;padding:20px;max-width:300px;text-align:center;color:white}.modal-content h3{margin:10px 0}.modal-content p{opacity:0.7;margin-bottom:15px}.modal-btn{padding:10px 30px;background:#007aff;color:white;border:none;border-radius:10px;font-weight:bold;cursor:pointer}</style><script>var settings=ePhone.getSettings();document.querySelector('.photos-app').style.color=settings.darkMode?'white':'black';var photos=[{id:1,emoji:'🌅',color:'linear-gradient(135deg,#ff6b6b,#ff8e8e)',label:'Закат'},{id:2,emoji:'🌲',color:'linear-gradient(135deg,#51cf66,#69db7c)',label:'Лес'},{id:3,emoji:'🏖',color:'linear-gradient(135deg,#339af0,#4dabf7)',label:'Пляж'},{id:4,emoji:'🌃',color:'linear-gradient(135deg,#7950f2,#9775fa)',label:'Город'},{id:5,emoji:'🌻',color:'linear-gradient(135deg,#fcc419,#ffd43b)',label:'Цветы'},{id:6,emoji:'🐱',color:'linear-gradient(135deg,#ff8787,#ffa8a8)',label:'Котик'},{id:7,emoji:'🏔',color:'linear-gradient(135deg,#20c997,#38d9a9)',label:'Горы'},{id:8,emoji:'🍂',color:'linear-gradient(135deg,#ff922b,#ffa94d)',label:'Осень'},{id:9,emoji:'🌊',color:'linear-gradient(135deg,#22b8cf,#3bc9db)',label:'Океан'},{id:10,emoji:'🦋',color:'linear-gradient(135deg,#845ef7,#9775fa)',label:'Бабочка'},{id:11,emoji:'🌞',color:'linear-gradient(135deg,#fab005,#fcc419)',label:'Солнце'},{id:12,emoji:'🍀',color:'linear-gradient(135deg,#40c057,#51cf66)',label:'Удача'}];function showModal(emoji,label){document.getElementById('modalEmoji').textContent=emoji;document.getElementById('modalTitle').textContent=label;document.getElementById('modalText').textContent='В полной версии здесь будет просмотр на весь экран';document.getElementById('modal').classList.remove('hidden')}function closeModal(){document.getElementById('modal').classList.add('hidden')}function loadPhotos(){document.getElementById('photosCount').textContent=photos.length+' фото';var grid=document.getElementById('photosGrid');grid.innerHTML=photos.map(function(photo){return '<div class=\"photo-item\" style=\"background:'+photo.color+'\" onclick=\"viewPhoto('+photo.id+')\">'+photo.emoji+'</div>'}).join('')}function viewPhoto(id){var photo=photos.find(function(p){return p.id===id});if(!photo)return;showModal(photo.emoji,photo.label)}loadPhotos();</script>"
}
