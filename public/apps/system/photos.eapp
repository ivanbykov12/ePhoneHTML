{
  "id": "photos_system",
  "name": "Фото",
  "icon": "material:photo_library",
  "color": "from-pink-400 to-purple-500",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Галерея фотографий",
  "supportedModels": ["iphone8", "iphonex", "iphone14"],
  "isSystem": true,
  "changelog": "Системное приложение",
  "code": "<!--\n⚠️ СИСТЕМНОЕ ПРИЛОЖЕНИЕ - НЕ УДАЛЯТЬ:\n- Grid отображение фотографий\n- Функции: loadPhotos(), viewPhoto()\n- Массив photos с демо-данными\n-->\n<div class=\"photos-app\">\n  <h1><span class=\"material-icons\">photo_library</span> Фото</h1>\n  <div class=\"photos-count\" id=\"photosCount\"></div>\n  <div class=\"photos-grid\" id=\"photosGrid\"></div>\n</div>\n\n<style>\n.photos-app { padding: 20px; }\n.photos-app h1 { font-size: 24px; margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }\n.photos-count { font-size: 14px; opacity: 0.7; margin-bottom: 20px; }\n.photos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }\n.photo-item { aspect-ratio: 1; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 40px; cursor: pointer; transition: transform 0.2s; }\n.photo-item:active { transform: scale(0.95); }\n</style>\n\n<script>\n// ⚠️ НЕ УДАЛЯТЬ: Инициализация\nconst settings = ePhone.getSettings();\ndocument.querySelector('.photos-app').style.color = settings.darkMode ? 'white' : 'black';\n\n// ⚠️ НЕ УДАЛЯТЬ: Демо-фотографии\nconst photos = [\n  { id: 1, emoji: '🌅', color: 'from-red-400 to-pink-500', label: 'Закат' },\n  { id: 2, emoji: '🌲', color: 'from-green-400 to-emerald-500', label: 'Лес' },\n  { id: 3, emoji: '🏖', color: 'from-blue-400 to-cyan-500', label: 'Пляж' },\n  { id: 4, emoji: '🌃', color: 'from-purple-400 to-indigo-500', label: 'Город' },\n  { id: 5, emoji: '🌻', color: 'from-yellow-400 to-orange-500', label: 'Цветы' },\n  { id: 6, emoji: '🐱', color: 'from-pink-400 to-rose-500', label: 'Котик' },\n  { id: 7, emoji: '🏔', color: 'from-teal-400 to-green-500', label: 'Горы' },\n  { id: 8, emoji: '🍂', color: 'from-orange-400 to-red-500', label: 'Осень' },\n  { id: 9, emoji: '🌊', color: 'from-cyan-400 to-blue-500', label: 'Океан' },\n  { id: 10, emoji: '🦋', color: 'from-violet-400 to-purple-500', label: 'Бабочка' },\n  { id: 11, emoji: '🌞', color: 'from-amber-400 to-yellow-500', label: 'Солнце' },\n  { id: 12, emoji: '🍀', color: 'from-emerald-400 to-teal-500', label: 'Удача' }\n];\n\n// ⚠️ НЕ УДАЛЯТЬ: Функции отображения\nfunction loadPhotos() {\n  document.getElementById('photosCount').textContent = `${photos.length} фото`;\n  const grid = document.getElementById('photosGrid');\n  grid.innerHTML = photos.map(photo => `\n    <div class=\"photo-item bg-gradient-to-br ${photo.color}\" onclick=\"viewPhoto(${photo.id})\">\n      ${photo.emoji}\n    </div>\n  `).join('');\n}\n\nfunction viewPhoto(id) {\n  const photo = photos.find(p => p.id === id);\n  if (!photo) return;\n  alert(`${photo.emoji} ${photo.label}\\n\\n(В полной версии здесь будет просмотр на весь экран)`);\n}\n\nloadPhotos();\n</script>"
}
