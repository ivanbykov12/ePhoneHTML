{
  "id": "template_game",
  "name": "Моя Игра",
  "icon": "material:sports_esports",
  "color": "from-purple-500 to-pink-500",
  "version": "1.0.0",
  "author": "Ваше Имя",
  "description": "Шаблон для создания игр",
  "supportedModels": [
    "iphone8",
    "iphonex",
    "iphone14",
    "epad101"
  ],
  "isSystem": false,
  "changelog": "Версия 1.0 - первый релиз с поддержкой тем",
  "code": "<div class=\"game-container\">\n  <h1><span class=\"material-icons\">sports_esports</span> Моя Игра</h1>\n  <div class=\"score\">Счёт: <span id=\"score\">0</span></div>\n  <div class=\"game-area\" id=\"gameArea\">\n    <div class=\"player\" id=\"player\">🎮</div>\n  </div>\n  <button class=\"game-btn\" onclick=\"startGame()\"><span class=\"material-icons\">play_arrow</span> Начать</button>\n  <button class=\"game-btn\" onclick=\"resetGame()\"><span class=\"material-icons\">refresh</span> Сброс</button>\n</div>\n\n<style>\n.game-container {\n  padding: 20px;\n  text-align: center;\n}\n.game-container h1 {\n  font-size: 24px;\n  margin-bottom: 20px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n}\n.score {\n  font-size: 20px;\n  margin-bottom: 20px;\n  color: #00ff00;\n}\n.game-area {\n  width: 100%;\n  height: 300px;\n  background: rgba(128,128,128,0.2);\n  border-radius: 12px;\n  position: relative;\n  margin-bottom: 20px;\n  overflow: hidden;\n}\n.player {\n  position: absolute;\n  font-size: 40px;\n  left: 50%;\n  bottom: 20px;\n  transform: translateX(-50%);\n  transition: left 0.1s;\n}\n.game-btn {\n  padding: 12px 24px;\n  margin: 5px;\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n  color: white;\n  border: none;\n  border-radius: 25px;\n  font-size: 16px;\n  cursor: pointer;\n  font-weight: bold;\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n}\n.game-btn:active {\n  transform: scale(0.95);\n}\n</style>\n\n<script>\n// Поддержка темы\nconst settings = ePhone.getSettings();\nconst container = document.querySelector('.game-container');\ncontainer.style.color = settings.darkMode ? 'white' : 'black';\n\nlet score = 0;\nlet gameActive = false;\nlet playerX = 50;\n\nfunction startGame() {\n  gameActive = true;\n  score = 0;\n  updateScore();\n  \n  const gameArea = document.getElementById('gameArea');\n  const player = document.getElementById('player');\n  \n  gameArea.addEventListener('click', function(e) {\n    if (!gameActive) return;\n    const rect = gameArea.getBoundingClientRect();\n    const x = ((e.clientX - rect.left) / rect.width) * 100;\n    playerX = Math.max(10, Math.min(90, x));\n    player.style.left = playerX + '%';\n    \n    score += 10;\n    updateScore();\n  });\n}\n\nfunction resetGame() {\n  gameActive = false;\n  score = 0;\n  updateScore();\n  document.getElementById('player').style.left = '50%';\n}\n\nfunction updateScore() {\n  document.getElementById('score').textContent = score;\n}\n\nfunction spawnObstacle() {\n  if (!gameActive) return;\n  const gameArea = document.getElementById('gameArea');\n  const obstacle = document.createElement('div');\n  obstacle.className = 'obstacle';\n  obstacle.style.cssText = `\n    position: absolute;\n    font-size: 30px;\n    left: ${Math.random() * 80 + 10}%;\n    top: -30px;\n    transition: top 2s linear;\n  `;\n  obstacle.textContent = '💣';\n  gameArea.appendChild(obstacle);\n  \n  setTimeout(() => {\n    obstacle.style.top = '100%';\n  }, 10);\n  \n  setTimeout(() => {\n    obstacle.remove();\n  }, 2000);\n}\n\nsetInterval(spawnObstacle, 1500);\n</script>"
}