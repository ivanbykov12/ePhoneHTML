{
  "id": "memory_game",
  "name": "Память",
  "icon": "material:style",
  "color": "from-indigo-500 to-cyan-400",
  "version": "1.0.0",
  "author": "ePhone User",
  "description": "Классическая игра на память: найди все пары карточек как можно быстрее.",
  "supportedModels": [
    "iphone8",
    "iphonex",
    "iphone14"
  ],
  "isSystem": false,
  "changelog": "Первая версия",
  "code": "<div class=\"wrap\"><div class=\"hud\"><span>Ходы: <b id=\"mv\">0</b></span><span>Пары: <b id=\"pr\">0</b>/8</span><span>⏱ <b id=\"tm\">0</b>с</span></div><div class=\"grid\" id=\"gr\"></div><div class=\"win hidden\" id=\"win\"><div class=\"wt\">🎉 Победа!</div><div class=\"ws\" id=\"ws\"></div><button onclick=\"init()\">Новая игра</button></div></div><style>.wrap{min-height:100vh;background:linear-gradient(145deg,#1b1035,#0f2027);color:#fff;font-family:sans-serif;display:flex;flex-direction:column;align-items:center;padding:14px;position:relative}.hud{display:flex;gap:8px;margin-bottom:14px;font-size:12px}.hud span{background:rgba(255,255,255,.1);padding:5px 12px;border-radius:14px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;width:100%;max-width:340px}.card{aspect-ratio:3/4;border-radius:14px;background:linear-gradient(135deg,#5e5ce6,#32ade6);display:flex;align-items:center;justify-content:center;font-size:30px;cursor:pointer;transition:transform .3s cubic-bezier(.4,1.6,.4,1),background .2s;box-shadow:0 4px 14px rgba(0,0,0,.4)}.card.front{background:rgba(255,255,255,.16);transform:scale(1.05) rotateY(180deg)}.card.done{background:rgba(52,199,89,.3);pointer-events:none}.win{position:absolute;inset:0;background:rgba(0,0,0,.8);backdrop-filter:blur(8px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px}.wt{font-size:28px;font-weight:800}.ws{font-size:15px;color:#ffd166}.win button{padding:10px 26px;border:none;border-radius:20px;background:#34c759;color:#fff;font-size:15px;font-weight:700;cursor:pointer}.hidden{display:none!important}</style><script>var emo=['🐶','🐱','🦊','🐸','🐵','🦁','🐼','🐷'],deck=[],first=null,mv=0,prs=0,secs=0,tmr=null,lock=false;function init(){clearInterval(tmr);deck=emo.concat(emo).sort(function(){return Math.random()-.5;});first=null;mv=0;prs=0;secs=0;lock=false;document.getElementById('mv').textContent=0;document.getElementById('pr').textContent='0/8';document.getElementById('tm').textContent=0;document.getElementById('win').classList.add('hidden');tmr=setInterval(function(){secs++;document.getElementById('tm').textContent=secs;},1000);var g=document.getElementById('gr');g.innerHTML='';deck.forEach(function(e,i){var d=document.createElement('div');d.className='card';d.dataset.i=i;d.onclick=function(){flip(d,e);};g.appendChild(d);});}function flip(d,e){if(lock||d.classList.contains('front'))return;d.classList.add('front');d.textContent=e;ePhone.vibrate(6);if(!first){first={d:d,e:e};return;}mv++;document.getElementById('mv').textContent=mv;if(first.e===e){first.d.classList.add('done');d.classList.add('done');prs++;document.getElementById('pr').textContent=prs+'/8';first=null;ePhone.vibrate([10,20,10]);if(prs===8){clearInterval(tmr);document.getElementById('win').classList.remove('hidden');document.getElementById('ws').textContent='Ходов: '+mv+' · Время: '+secs+'с';try{ePhone.notify('Память','Победа за '+mv+' ходов! 🎉');}catch(err){}}}else{lock=true;var f=first;first=null;setTimeout(function(){f.d.classList.remove('front');f.d.textContent='';d.classList.remove('front');d.textContent='';lock=false;},750);}}init();</script>"
}