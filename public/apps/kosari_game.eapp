{
  "id": "kosari_game",
  "name": "Косарики",
  "icon": "material:content_cut",
  "color": "from-red-500 to-orange-500",
  "version": "1.0.0",
  "author": "ePhone System",
  "description": "Режь фрукты свайпами — классические косарики!",
  "supportedModels": [
    "iphone8",
    "iphonex",
    "iphone14",
    "epad101"
  ],
  "isSystem": true,
  "changelog": "Первая версия",
  "code": "<div class=\"wrap\"><div class=\"top\"><span>Счёт: <b id=\"sc\">0</b></span><span>Рекорд: <b id=\"bs\">0</b></span></div><canvas id=\"cv\"></canvas><div class=\"hint\" id=\"hint\">Свайпни по фрукту! 🍉</div><div class=\"over hidden\" id=\"over\"><div class=\"ot\">💥 Игра окончена</div><div class=\"os\" id=\"fs\"></div><button onclick=\"rst()\">Ещё раз 🔄</button></div></div><style>.wrap{height:100vh;background:linear-gradient(160deg,#2b1a05,#5c3d12 45%,#1a0f02);display:flex;flex-direction:column;align-items:center;color:#fff;font-family:sans-serif;overflow:hidden;position:relative}.top{width:92%;display:flex;justify-content:space-between;padding:12px 4px;font-size:15px}canvas{width:96%;flex:1;border-radius:16px;touch-action:none}#hint{position:absolute;top:44%;width:100%;text-align:center;opacity:.7;font-size:16px;pointer-events:none;transition:opacity .5s}.over{position:absolute;inset:0;background:rgba(0,0,0,.72);backdrop-filter:blur(8px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px}.hidden{display:none!important}.ot{font-size:26px;font-weight:700}.os{font-size:17px;color:#ffd166}.over button{padding:12px 30px;border-radius:24px;border:none;background:linear-gradient(135deg,#ff9f0a,#ff375f);color:#fff;font-size:16px;font-weight:700;cursor:pointer}</style><script>var cv=document.getElementById('cv'),ctx=cv.getContext('2d');var fruits=['🍉','🍎','🍊','🍋','🥝','🍑'];var sc=0,bs=+(ePhone.load('kb')||0),items=[],bits=[],alive=true,sp=0,last=null,trail=[];document.getElementById('bs').textContent=bs;function fit(){cv.width=cv.clientWidth*devicePixelRatio;cv.height=cv.clientHeight*devicePixelRatio;}setTimeout(fit,60);addEventListener('resize',fit);function spawn(){if(Math.random()<0.12&&sc>4){items.push({e:'💣',x:.1+Math.random()*.8,y:1.05,vx:(Math.random()-.5)*.003,vy:-.019-Math.random()*.004,r:.05,b:1,rot:0,vr:.003});return;}items.push({e:fruits[Math.floor(Math.random()*fruits.length)],x:.1+Math.random()*.8,y:1.05,vx:(Math.random()-.5)*.003,vy:-.018-Math.random()*.005,r:.05,b:0,rot:0,vr:(Math.random()-.5)*.005});}function pt(e){return e.touches?e.touches[0]:e;}function dn(e){last=pt(e);document.getElementById('hint').style.opacity=0;}function mv(e){var t=pt(e);if(!last)return;var dx=t.clientX-last.x,dy=t.clientY-last.y;if(Math.abs(dx)+Math.abs(dy)<3)return;trail.push({x:t.clientX,y:t.clientY,a:1});if(trail.length>12)trail.shift();var r=cv.getBoundingClientRect();for(var i=items.length-1;i>=0;i--){var it=items[i];var ix=r.left+it.x*r.width,iy=r.top+it.y*r.height;if(Math.hypot(t.clientX-ix,t.clientY-iy)<it.r*Math.min(r.width,r.height)*1.5){cut(it,i,dx,dy);}}last=t;if(e.cancelable)e.preventDefault();}function up(){last=null;}function cut(it,i,dx,dy){if(it.b){go();return;}items.splice(i,1);sc++;if(sc>bs){bs=sc;ePhone.save('kb',bs);document.getElementById('bs').textContent=bs;}document.getElementById('sc').textContent=sc;ePhone.vibrate(12);var a=Math.atan2(dy,dx);for(var k=0;k<8;k++)bits.push({e:it.e,x:it.x,y:it.y,vx:Math.cos(a+1.57)*(0.004+Math.random()*.006)+(Math.random()-.5)*.004,vy:Math.sin(a+1.57)*(0.004+Math.random()*.006)-.004,s:.4+Math.random()*.4,al:1});}function go(){alive=false;document.getElementById('over').classList.remove('hidden');document.getElementById('fs').textContent='Счёт: '+sc+' · Рекорд: '+bs;ePhone.vibrate([50,60,60]);try{ePhone.notify('Косарик','Новый рекорд: '+bs+' фруктов! 🍉');}catch(e){}}function rst(){sc=0;items=[];bits=[];document.getElementById('sc').textContent=0;document.getElementById('over').classList.add('hidden');alive=true;}cv.addEventListener('mousedown',dn);addEventListener('mousemove',function(e){if(e.buttons)mv(e);});addEventListener('mouseup',up);cv.addEventListener('touchstart',dn,{passive:true});cv.addEventListener('touchmove',mv,{passive:false});cv.addEventListener('touchend',up);(function L(){requestAnimationFrame(L);if(!cv.width)return;ctx.clearRect(0,0,cv.width,cv.height);if(alive){sp++;var rate=Math.max(26,66-sc);if(sp>rate){sp=0;spawn();}}ctx.textAlign='center';ctx.textBaseline='middle';for(var i=items.length-1;i>=0;i--){var it=items[i];it.x+=it.vx;it.y+=it.vy;it.vy+=.0006;it.rot+=it.vr;if(it.y>1.2){items.splice(i,1);continue;}ctx.save();ctx.translate(it.x*cv.width,it.y*cv.height);ctx.rotate(it.rot);ctx.font=(it.r*cv.width)+'px serif';ctx.fillText(it.e,0,0);ctx.restore();}for(var j=bits.length-1;j>=0;j--){var b=bits[j];b.x+=b.vx;b.y+=b.vy;b.vy+=.0005;b.al-=.03;if(b.al<=0){bits.splice(j,1);continue;}ctx.globalAlpha=b.al;ctx.font=(b.s*.06*cv.width)+'px serif';ctx.fillText(b.e,b.x*cv.width,b.y*cv.height);ctx.globalAlpha=1;}for(var q=trail.length-1;q>=0;q--){trail[q].a-=.08;if(trail[q].a<=0)trail.splice(q,1);}if(trail.length>1){var r2=cv.getBoundingClientRect();ctx.lineCap='round';for(var w=1;w<trail.length;w++){ctx.strokeStyle='rgba(255,255,255,'+trail[w].a*.8+')';ctx.lineWidth=w*1.3*devicePixelRatio;ctx.beginPath();ctx.moveTo((trail[w-1].x-r2.left)*devicePixelRatio,(trail[w-1].y-r2.top)*devicePixelRatio);ctx.lineTo((trail[w].x-r2.left)*devicePixelRatio,(trail[w].y-r2.top)*devicePixelRatio);ctx.stroke();}}})();</script>"
}